# Test environment defaults (committed). Override with .env.test.local if needed.
# Prefer MariaDB (Docker/CI). Compose and CI set DATABASE_URL in the real environment
# (base DB name "testlig" + doctrine dbname_suffix "_test" → testlig_test).

KERNEL_CLASS='App\Kernel'
APP_SECRET='test_secret_not_for_production'
DATABASE_URL="mysql://testlig:testlig@database:3306/testlig?serverVersion=10.11.10-MariaDB&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=sync://
REDIS_URL=redis://redis:6379
LOCK_DSN=flock

MAILER_DSN=null://null
MAILER_FROM_EMAIL=noreply@testlig.local
MAILER_FROM_NAME=Testlig
VERIFY_EMAIL_LIFETIME=3600
RESET_PASSWORD_LIFETIME=3600
AUDIT_HASH_KEY=test_audit_hash_key_not_for_production
ALLOW_SUPER_ADMIN_BOOTSTRAP=0
QUESTION_ANSWER_INTEGRITY_KEY=test_question_answer_integrity_key_not_for_production
ATTEMPT_ANSWER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

