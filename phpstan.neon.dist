parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - var
        - vendor
        - tests/bootstrap.php
    bootstrapFiles:
        - vendor/autoload.php
    tmpDir: var/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        -
            # Preferred: final User + Doctrine lazy ghosts (no traditional proxies).
            identifier: doctrine.finalEntity
            path: src/Entity/User.php
