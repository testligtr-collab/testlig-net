# =============================================================================
# Testlig — environment variable template
# Copy to .env.local and adjust. Never commit real secrets or production values.
# =============================================================================

###> symfony/framework-bundle ###
# Application environment: dev | test | prod
APP_ENV=dev
# Random secret used for CSRF and signed URLs. Generate a unique value locally:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=generate_a_unique_local_value
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used when generating absolute URLs from the CLI
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB 10.11 connection string (Docker service hostname is "database")
# Docker example:
# DATABASE_URL="mysql://testlig:YOUR_PASSWORD@database:3306/testlig?serverVersion=10.11.10-MariaDB&charset=utf8mb4"
# Host / XAMPP example:
DATABASE_URL="mysql://testlig:YOUR_PASSWORD@127.0.0.1:3306/testlig?serverVersion=10.11.10-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Options:
#   sync://                         — process messages immediately (simple local default)
#   doctrine://default?auto_setup=0 — Doctrine transport
#   redis://redis:6379/messages     — Redis transport (Docker)
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> testlig/redis ###
# Redis DSN for cache/health checks (Predis). Docker hostname is "redis".
REDIS_URL=redis://127.0.0.1:6379
###< testlig/redis ###

###> symfony/lock ###
# flock is fine for single-node development; use Redis/DB lock stores in multi-node setups
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
# Docker Compose overrides to smtp://mailpit:1025. Host-only null transport example:
MAILER_DSN=null://null
MAILER_FROM_EMAIL=noreply@example.com
MAILER_FROM_NAME=Testlig
###< symfony/mailer ###

###> testlig/verify-email ###
# Signed verification link lifetime in seconds (default 24h)
VERIFY_EMAIL_LIFETIME=86400
###< testlig/verify-email ###

###> testlig/docker ###
# Published HTTP port for the Nginx container (http://localhost:8080)
HTTP_PORT=8080
# Mailpit UI (http://localhost:8025) — change if the port is taken
MAILPIT_UI_PORT=8025
MYSQL_DATABASE=testlig
MYSQL_USER=testlig
# REQUIRED before `docker compose up` (may live in committed .env as placeholders only)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Note: MariaDB/Redis are not published to the Windows host by default.
# Inside Docker, compose sets DATABASE_URL/REDIS_URL to hostname database/redis.
###< testlig/docker ###
