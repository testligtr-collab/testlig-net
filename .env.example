# =============================================================================
# Testlig — environment variable template
# Copy to .env.local and adjust. Never commit real secrets or production values.
# =============================================================================

###> symfony/framework-bundle ###
# Application environment: dev | test | prod
APP_ENV=dev
# Random secret used for CSRF and signed URLs. Generate a unique value locally:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=generate_a_unique_local_value
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used when generating absolute URLs from the CLI
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB 10.11 connection string (Docker service hostname is "database")
# Docker example:
# DATABASE_URL="mysql://testlig:YOUR_PASSWORD@database:3306/testlig?serverVersion=10.11.10-MariaDB&charset=utf8mb4"
# Host / XAMPP example:
DATABASE_URL="mysql://testlig:YOUR_PASSWORD@127.0.0.1:3306/testlig?serverVersion=10.11.10-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Options:
#   sync://                         — process messages immediately (simple local default)
#   doctrine://default?auto_setup=0 — Doctrine transport
#   redis://redis:6379/messages     — Redis transport (Docker)
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> testlig/redis ###
# Redis DSN for cache/health checks (Predis). Docker hostname is "redis".
REDIS_URL=redis://127.0.0.1:6379
###< testlig/redis ###

###> testlig/docker ###
# Published HTTP port for the Nginx container
HTTP_PORT=8080
# Published MariaDB port for host tooling (optional; remove in shared networks)
DATABASE_PORT=3306
MYSQL_DATABASE=testlig
MYSQL_USER=testlig
# REQUIRED in .env.local before `docker compose up` — do not use production passwords here
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
###< testlig/docker ###

###> symfony/lock ###
# flock is fine for single-node development; use Redis/DB lock stores in multi-node setups
LOCK_DSN=flock
###< symfony/lock ###
