{% set current = nav|default('') %}
<header class="site-header student-header" data-controller="mobile-nav">
    <div class="site-header__inner">
        {% include 'components/brand.html.twig' with {href: path('app_institution_overview')} %}

        <nav class="site-nav" aria-label="Kurum menüsü">
            <a href="{{ path('app_institution_overview') }}" {% if current == 'overview' %}aria-current="page"{% endif %}>Genel bakış</a>
            <a href="{{ path('app_institution_classrooms') }}" {% if current == 'classrooms' %}aria-current="page"{% endif %}>Sınıflar</a>
            <a href="{{ path('app_institution_teachers') }}" {% if current == 'teachers' %}aria-current="page"{% endif %}>Öğretmenler</a>
            <a href="{{ path('app_institution_students') }}" {% if current == 'students' %}aria-current="page"{% endif %}>Öğrenciler</a>
            <a href="{{ path('app_institution_tests') }}" {% if current == 'tests' %}aria-current="page"{% endif %}>Testler</a>
            <a href="{{ path('app_account') }}">Hesabım</a>
            <a href="{{ path('app_home') }}">Ana sayfa</a>
        </nav>

        <div class="site-header__actions">
            <form method="post" action="{{ path('app_logout') }}" class="logout-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn btn--ghost">Çıkış</button>
            </form>
        </div>

        <button
            type="button"
            class="nav-toggle"
            data-mobile-nav-target="button"
            data-action="mobile-nav#toggle"
            aria-expanded="false"
            aria-controls="institution-mobile-nav"
        >
            <span class="sr-only">Menüyü aç veya kapat</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M4 7h16v2H4V7zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
            </svg>
        </button>
    </div>

    <div
        id="institution-mobile-nav"
        class="mobile-drawer"
        data-mobile-nav-target="drawer"
        data-action="click->mobile-nav#closeOnNavigate"
        hidden
    >
        <nav aria-label="Mobil kurum menüsü">
            <a href="{{ path('app_institution_overview') }}" {% if current == 'overview' %}aria-current="page"{% endif %}>Genel bakış</a>
            <a href="{{ path('app_institution_classrooms') }}" {% if current == 'classrooms' %}aria-current="page"{% endif %}>Sınıflar</a>
            <a href="{{ path('app_institution_teachers') }}" {% if current == 'teachers' %}aria-current="page"{% endif %}>Öğretmenler</a>
            <a href="{{ path('app_institution_students') }}" {% if current == 'students' %}aria-current="page"{% endif %}>Öğrenciler</a>
            <a href="{{ path('app_institution_tests') }}" {% if current == 'tests' %}aria-current="page"{% endif %}>Testler</a>
            <a href="{{ path('app_account') }}">Hesabım</a>
            <a href="{{ path('app_home') }}">Ana sayfa</a>
        </nav>
        <div class="mobile-drawer__actions">
            <form method="post" action="{{ path('app_logout') }}" class="logout-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn btn--ghost btn--block">Çıkış</button>
            </form>
        </div>
    </div>
</header>
