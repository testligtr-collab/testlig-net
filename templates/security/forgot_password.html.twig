{% extends 'base.html.twig' %}

{% block title %}Şifremi unuttum — Testlig{% endblock %}

{% block body %}
<section class="page">
    <h1>Şifremi unuttum</h1>
    {% if mailAvailable is defined and not mailAvailable %}
        <p class="flash flash-error" role="alert">Parola sıfırlama e-postası şu an gönderilemiyor. E-posta gönderimi yapılandırılmamış.</p>
    {% else %}
        <p class="muted">E-posta adresinizi girin. Kullanılabilir bir hesap varsa parola yenileme bağlantısı gönderilir.</p>
    {% endif %}

    {{ form_start(requestForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(requestForm) }}
        <div class="form-row">
            {{ form_label(requestForm.email) }}
            {{ form_widget(requestForm.email) }}
            {{ form_errors(requestForm.email) }}
        </div>
        {{ form_rest(requestForm) }}
        <button class="btn" type="submit" {% if mailAvailable is defined and not mailAvailable %}disabled{% endif %}>Bağlantı gönder</button>
    {{ form_end(requestForm) }}

    <p class="muted"><a href="{{ path('app_login') }}">Girişe dön</a></p>
</section>
{% endblock %}
