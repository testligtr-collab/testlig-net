{% extends 'base.html.twig' %}

{% block title %}E-postanı kontrol et — Testlig{% endblock %}

{% block body %}
<section class="page">
    <h1>E-postanı kontrol et</h1>
    <p>{{ message }}</p>
    <p class="muted">Bağlantı yaklaşık {{ (tokenLifetime / 60)|round(0, 'floor') }} dakika geçerlidir.</p>
    <p class="muted"><a href="{{ path('app_login') }}">Girişe dön</a></p>
</section>
{% endblock %}
