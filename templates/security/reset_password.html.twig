{% extends 'base.html.twig' %}

{% block title %}Yeni parola — Testlig{% endblock %}

{% block body %}
<section class="page">
    <h1>Yeni parola belirle</h1>

    {{ form_start(resetForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(resetForm) }}
        <div class="form-row">
            {{ form_label(resetForm.plainPassword.first) }}
            {{ form_widget(resetForm.plainPassword.first) }}
            <p class="form-help">{{ resetForm.plainPassword.first.vars.help }}</p>
            {{ form_errors(resetForm.plainPassword.first) }}
        </div>
        <div class="form-row">
            {{ form_label(resetForm.plainPassword.second) }}
            {{ form_widget(resetForm.plainPassword.second) }}
            {{ form_errors(resetForm.plainPassword.second) }}
            {{ form_errors(resetForm.plainPassword) }}
        </div>
        {{ form_rest(resetForm) }}
        <button class="btn" type="submit">Parolayı güncelle</button>
    {{ form_end(resetForm) }}
</section>
{% endblock %}
