{% extends 'base.html.twig' %}

{% block title %}{{ flow.title }} — Kayıt — Testlig{% endblock %}

{% block body %}
<section class="page">
    <p class="eyebrow"><a href="{{ path('app_register') }}">← Kayıt seçenekleri</a></p>
    <h1>{{ flow.title }}</h1>

    {% if flow.requiresApplicationFollowUp %}
        <p class="muted">Önce e-posta doğrulamalı bir hesap oluşturursunuz. Doğrulayıp giriş yaptıktan sonra başvurunuzu gönderirsiniz. Başvuru inceleme tamamlanana kadar özel erişim açılmaz.</p>
    {% elseif flow.value == 'veli' %}
        <p class="muted">Veli hesabı e-posta ile oluşur. Çocuk bağlantısı bu adımda kurulmaz; veli telefonu öğrenci hesabına yazılmaz.</p>
    {% else %}
        <p class="muted">Öğrenci hesabı e-posta ile oluşur. Kayıt sonrası e-posta doğrulaması gerekir.</p>
    {% endif %}

    {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(registrationForm) }}
        <div class="form-row">
            {{ form_label(registrationForm.firstName) }}
            {{ form_widget(registrationForm.firstName) }}
            {{ form_errors(registrationForm.firstName) }}
        </div>
        <div class="form-row">
            {{ form_label(registrationForm.lastName) }}
            {{ form_widget(registrationForm.lastName) }}
            {{ form_errors(registrationForm.lastName) }}
        </div>
        <div class="form-row">
            {{ form_label(registrationForm.email) }}
            {{ form_widget(registrationForm.email) }}
            {{ form_errors(registrationForm.email) }}
        </div>
        <div class="form-row">
            {{ form_label(registrationForm.plainPassword.first) }}
            {{ form_widget(registrationForm.plainPassword.first) }}
            <p class="form-help">{{ registrationForm.plainPassword.first.vars.help }}</p>
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>
        <div class="form-row">
            {{ form_label(registrationForm.plainPassword.second) }}
            {{ form_widget(registrationForm.plainPassword.second) }}
            {{ form_errors(registrationForm.plainPassword.second) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>
        <div class="form-row checkbox-row">
            {{ form_widget(registrationForm.agreeTerms) }}
            {{ form_label(registrationForm.agreeTerms) }}
        </div>
        {{ form_errors(registrationForm.agreeTerms) }}
        {{ form_rest(registrationForm) }}
        <button class="btn btn--primary" type="submit">
            {% if flow.requiresApplicationFollowUp %}Hesap oluştur{% else %}Kayıt ol{% endif %}
        </button>
    {{ form_end(registrationForm) }}

    <p class="muted">Zaten hesabınız var mı? <a href="{{ path('app_login') }}">Giriş yapın</a>
        {% if flow.requiresApplicationFollowUp %}
            · Doğrulanmış hesabınızla
            {% if flow.value == 'ogretmen' %}
                <a href="{{ path('app_teacher_application') }}">öğretmen başvurusuna</a>
            {% else %}
                <a href="{{ path('app_institution_application') }}">kurum başvurusuna</a>
            {% endif %}
            gidin
        {% endif %}
    </p>
</section>
{% endblock %}
