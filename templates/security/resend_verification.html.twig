{% extends 'base.html.twig' %}

{% block title %}Doğrulama e-postasını yeniden gönder — Testlig{% endblock %}

{% block body %}
<section class="page">
    <h1>Doğrulama e-postasını yeniden gönder</h1>
    {% if mailAvailable is defined and not mailAvailable %}
        <p class="flash flash-error" role="alert">E-posta gönderimi şu an yapılandırılmamış. Doğrulama bağlantısı gönderilemez.</p>
    {% else %}
        <p class="muted">E-posta adresinizi girin. Hesap bulunursa ve doğrulama bekliyorsa yeni bir bağlantı gönderilir.</p>
    {% endif %}

    {{ form_start(resendForm, {attr: {novalidate: 'novalidate'}}) }}
        <div class="form-row">
            {{ form_label(resendForm.email) }}
            {{ form_widget(resendForm.email) }}
            {{ form_errors(resendForm.email) }}
        </div>
        {{ form_rest(resendForm) }}
        <button class="btn" type="submit" {% if mailAvailable is defined and not mailAvailable %}disabled{% endif %}>Gönder</button>
    {{ form_end(resendForm) }}
</section>
{% endblock %}
