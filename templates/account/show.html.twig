{% extends 'base.html.twig' %}

{% block title %}Hesabım — Testlig{% endblock %}

{% block body_class %}{% if is_granted('ROLE_STUDENT') %}is-student-surface{% endif %}{% endblock %}

{% block site_chrome %}
    {% if is_granted('ROLE_STUDENT') %}
        {% include 'student/_header.html.twig' %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block site_footer %}
    {% if is_granted('ROLE_STUDENT') %}
        {% include 'student/_footer.html.twig' %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
<div class="{% if is_granted('ROLE_STUDENT') %}student-page{% endif %}">
<section class="{% if is_granted('ROLE_STUDENT') %}student-form-card{% else %}page{% endif %}">
    <h1>Hesabım</h1>
    <dl class="account-dl">
        <dt>Ad</dt>
        <dd>{{ user.firstName }}</dd>
        <dt>Soyad</dt>
        <dd>{{ user.lastName }}</dd>
        <dt>E-posta</dt>
        <dd>{{ user.email }}</dd>
    </dl>
    <p><a class="btn" href="{{ path('app_account_change_password') }}">Parola değiştir</a></p>
    {% if learning_contents_href %}
        <p><a class="btn" href="{{ learning_contents_href }}">İçerikler</a></p>
    {% endif %}
    {% if questions_href %}
        <p><a class="btn" href="{{ questions_href }}">Sorular</a></p>
    {% endif %}
    {% if tests_href %}
        <p><a class="btn" href="{{ tests_href }}">Testler</a></p>
    {% endif %}
</section>
</div>
{% endblock %}
