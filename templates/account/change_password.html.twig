{% extends 'base.html.twig' %}

{% block title %}Parola değiştir — Testlig{% endblock %}

{% block body_class %}{% if is_granted('ROLE_STUDENT') or is_granted('ROLE_PARENT') %}is-student-surface{% endif %}{% endblock %}

{% block site_chrome %}
    {% if is_granted('ROLE_STUDENT') %}
        {% include 'student/_header.html.twig' %}
    {% elseif is_granted('ROLE_PARENT') %}
        {% include 'parent/_header.html.twig' %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block site_footer %}
    {% if is_granted('ROLE_STUDENT') %}
        {% include 'student/_footer.html.twig' %}
    {% elseif is_granted('ROLE_PARENT') %}
        {% include 'parent/_footer.html.twig' %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
<div class="account-password-page{% if is_granted('ROLE_STUDENT') %} student-page{% endif %}">
    <section class="account-password" aria-labelledby="account-password-heading">
        <header class="account-password__head">
            <h1 id="account-password-heading">Parola değiştir</h1>
            <p class="account-password__lede">Oturumunuzdaki hesabın parolasını güncelleyin. Başarılı işlemden sonra yeni parolanızla yeniden giriş yapmanız gerekir.</p>
        </header>

        <section class="account-password__card" aria-labelledby="account-password-form-heading">
            <h2 id="account-password-form-heading" class="visually-hidden">Parola formu</h2>

            {{ form_start(changePasswordForm, {
                attr: {
                    novalidate: 'novalidate',
                    class: 'account-password__form',
                }
            }) }}
                {{ form_errors(changePasswordForm) }}

                <div class="account-password__field">
                    {{ form_label(changePasswordForm.currentPassword) }}
                    {{ form_widget(changePasswordForm.currentPassword, {attr: {class: 'account-password__input'}}) }}
                    {{ form_errors(changePasswordForm.currentPassword) }}
                </div>

                <div class="account-password__field">
                    {{ form_label(changePasswordForm.newPassword.first) }}
                    {{ form_widget(changePasswordForm.newPassword.first, {
                        attr: {
                            class: 'account-password__input',
                            'aria-describedby': changePasswordForm.newPassword.first.vars.id ~ '_help',
                        }
                    }) }}
                    {% if changePasswordForm.newPassword.first.vars.help %}
                        <p class="account-password__help" id="{{ changePasswordForm.newPassword.first.vars.id }}_help">{{ changePasswordForm.newPassword.first.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(changePasswordForm.newPassword.first) }}
                </div>

                <div class="account-password__field">
                    {{ form_label(changePasswordForm.newPassword.second) }}
                    {{ form_widget(changePasswordForm.newPassword.second, {attr: {class: 'account-password__input'}}) }}
                    {{ form_errors(changePasswordForm.newPassword.second) }}
                    {{ form_errors(changePasswordForm.newPassword) }}
                </div>

                {{ form_rest(changePasswordForm) }}

                <div class="account-password__actions">
                    <button class="btn account-password__submit" type="submit">Parolayı kaydet</button>
                    <a class="btn account-password__back" href="{{ path('app_account') }}">Hesabıma dön</a>
                </div>
            {{ form_end(changePasswordForm) }}
        </section>
    </section>
</div>
{% endblock %}
