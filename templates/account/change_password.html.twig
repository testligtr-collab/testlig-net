{% extends 'base.html.twig' %}

{% block title %}Parola değiştir — Testlig{% endblock %}

{% block body_class %}{% if is_granted('ROLE_STUDENT') or is_granted('ROLE_PARENT') %}is-student-surface{% endif %}{% endblock %}

{% block site_chrome %}
    {% if is_granted('ROLE_STUDENT') %}
        {% include 'student/_header.html.twig' %}
    {% elseif is_granted('ROLE_PARENT') %}
        {% include 'parent/_header.html.twig' %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block site_footer %}
    {% if is_granted('ROLE_STUDENT') %}
        {% include 'student/_footer.html.twig' %}
    {% elseif is_granted('ROLE_PARENT') %}
        {% include 'parent/_footer.html.twig' %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
<div class="{% if is_granted('ROLE_STUDENT') %}student-page{% endif %}">
<section class="{% if is_granted('ROLE_STUDENT') %}student-form-card{% else %}page{% endif %}">
    <h1>Parola değiştir</h1>

    {{ form_start(changePasswordForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(changePasswordForm) }}
        <div class="form-row">
            {{ form_label(changePasswordForm.currentPassword) }}
            {{ form_widget(changePasswordForm.currentPassword) }}
            {{ form_errors(changePasswordForm.currentPassword) }}
        </div>
        <div class="form-row">
            {{ form_label(changePasswordForm.newPassword.first) }}
            {{ form_widget(changePasswordForm.newPassword.first) }}
            <p class="form-help">{{ changePasswordForm.newPassword.first.vars.help }}</p>
            {{ form_errors(changePasswordForm.newPassword.first) }}
        </div>
        <div class="form-row">
            {{ form_label(changePasswordForm.newPassword.second) }}
            {{ form_widget(changePasswordForm.newPassword.second) }}
            {{ form_errors(changePasswordForm.newPassword.second) }}
            {{ form_errors(changePasswordForm.newPassword) }}
        </div>
        {{ form_rest(changePasswordForm) }}
        <button class="btn" type="submit">Parolayı kaydet</button>
    {{ form_end(changePasswordForm) }}

    <p class="muted"><a href="{{ path('app_account') }}">Hesabıma dön</a></p>
</section>
</div>
{% endblock %}
