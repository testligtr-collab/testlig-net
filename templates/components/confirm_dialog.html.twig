<dialog
    id="app-confirm-dialog"
    class="confirm-dialog"
    aria-modal="true"
    aria-labelledby="app-confirm-title"
    aria-describedby="app-confirm-message"
>
    <div class="confirm-dialog__panel">
        <h2 id="app-confirm-title" class="confirm-dialog__title">İşlemi onayla</h2>
        <p id="app-confirm-message" class="confirm-dialog__message"></p>
        <div class="confirm-dialog__actions">
            <button type="button" class="btn btn--ghost" id="app-confirm-cancel">Vazgeç</button>
            <button type="button" class="btn btn--cta" id="app-confirm-accept">Onayla</button>
        </div>
    </div>
</dialog>
