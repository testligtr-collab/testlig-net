<header class="site-header" data-controller="mobile-nav">
    <div class="site-header__inner">
        {% include 'components/brand.html.twig' %}

        <nav class="site-nav" aria-label="Ana menü">
            {% include 'components/public_nav_links.html.twig' %}
        </nav>

        <div class="site-header__actions">
            {% include 'components/public_auth_actions.html.twig' with { student_links: true } %}
        </div>

        <button
            type="button"
            class="nav-toggle"
            data-mobile-nav-target="button"
            data-action="mobile-nav#toggle"
            aria-expanded="false"
            aria-controls="mobile-site-nav"
        >
            <span class="sr-only">Menüyü aç veya kapat</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M4 7h16v2H4V7zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
            </svg>
        </button>
    </div>

    <div
        id="mobile-site-nav"
        class="mobile-drawer"
        data-mobile-nav-target="drawer"
        data-action="click->mobile-nav#closeOnNavigate"
        hidden
    >
        <nav aria-label="Mobil ana menü">
            {% include 'components/public_nav_links.html.twig' %}
        </nav>
        <div class="mobile-drawer__actions">
            {% include 'components/public_auth_actions.html.twig' with { stacked: true, student_links: true } %}
        </div>
    </div>
</header>
