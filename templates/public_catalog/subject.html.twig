{% extends 'base.html.twig' %}

{% block title %}{{ catalog_title }} — Testlig{% endblock %}
{% block meta_description %}{{ catalog_description }}{% endblock %}
{% block head_extra %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:title" content="{{ catalog_title }}">
    <meta property="og:description" content="{{ catalog_description }}">
    <meta property="og:url" content="{{ canonical_url }}">
{% endblock %}
{% block body_class %}public-catalog{% endblock %}
{% block flashes %}{% endblock %}
{% block site_chrome %}{% include 'public_catalog/_chrome.html.twig' %}{% endblock %}
{% block site_footer %}{% include 'public_catalog/_footer.html.twig' %}{% endblock %}

{% block body %}
    <div class="catalog-wrap">
        <nav class="catalog-crumbs" aria-label="Konum">
            <a href="{{ path('app_public_catalog') }}">Dersler</a>
            <a href="{{ path('app_public_catalog_grade', {grade: grade}) }}">{{ grade_label }}</a>
            <span aria-current="page">{{ subject.name }}</span>
        </nav>
        <p class="catalog-kicker">{{ grade_label }}</p>
        <h1>{{ subject.name }}</h1>
        {% if subject.description %}
            <p class="catalog-lead">{{ subject.description }}</p>
        {% endif %}
        {% if units is empty %}
            <p>Bu derste yayımlanmış ünite yok.</p>
        {% else %}
            <ul class="catalog-list">
                {% for unit in units %}
                    <li class="catalog-panel">
                        <h2>{{ unit.name }}</h2>
                        {% if unit.description %}
                            <p>{{ unit.description }}</p>
                        {% endif %}
                        <p class="catalog-card__meta">{{ unit.topicCount }} konu</p>
                        {% if unit.sourceUrl %}
                            <p><a href="{{ unit.sourceUrl }}" rel="noopener noreferrer">Kaynak</a></p>
                        {% endif %}
                        <a class="btn btn--ghost" href="{{ path('app_public_catalog_unit', {grade: grade, subjectSlug: subject.slug, unitSlug: unit.slug}) }}">Üniteyi incele</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% include 'public_catalog/_cta.html.twig' %}
    </div>
{% endblock %}
