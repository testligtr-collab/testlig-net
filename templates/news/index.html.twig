{% extends 'base.html.twig' %}

{% block title %}Haberler — Testlig{% endblock %}
{% block meta_description %}Yayımlanmış Testlig haberleri.{% endblock %}
{% block body_class %}public-catalog{% endblock %}

{% block body %}
    <div class="catalog-wrap">
        <h1>Haberler</h1>
        {% if articles is empty %}
            <p>Yayımlanmış haber yok.</p>
        {% else %}
            <ul class="catalog-grid">
                {% for article in articles %}
                    <li>
                        <a href="{{ path('app_news_show', {slug: article.slug}) }}">
                            <span>{{ article.title }}</span>
                            <span>{{ article.summary }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
