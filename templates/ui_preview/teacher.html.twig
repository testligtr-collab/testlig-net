{% extends 'layouts/panel_preview.html.twig' %}

{% block title %}Öğretmen paneli önizleme — Testlig{% endblock %}

{% block panel_content %}
    <h1 class="panel-greeting" id="overview">{{ view.greeting }}</h1>

    <section class="surface stack-md" aria-labelledby="tasks-heading">
        <h2 id="tasks-heading" class="u-h">Bugünkü işler</h2>
        <ul class="list-plain">
            {% for item in view.todayTasks %}
                <li>
                    <div>
                        <strong>{{ item.label }}</strong>
                        <p class="muted u-meta">{{ item.meta }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="surface stack-md u-mt1" aria-labelledby="quick-heading">
        <h2 id="quick-heading" class="u-h">Hızlı işlem</h2>
        <div class="quick-actions">
            {% for action in view.quickActions %}
                {% include 'components/button.html.twig' with { label: action.label, variant: 'ghost', href: '#' } %}
            {% endfor %}
        </div>
        <p class="muted u-fine">Canlı ders bu aşamada yalnızca sakin bir önizleme girişidir.</p>
    </section>

    <div class="panel-grid-2 u-mt1">
        <section class="surface stack-md" aria-labelledby="class-heading">
            <h2 id="class-heading" class="u-h">Sınıf özeti</h2>
            <div class="stat-row">
                {% for item in view.classSummary %}
                    {% include 'components/stat_card.html.twig' with { label: item.label, value: item.value } %}
                {% endfor %}
            </div>
        </section>

        <section class="surface stack-md" aria-labelledby="pending-heading">
            <h2 id="pending-heading" class="u-h">Değerlendirme bekleyenler</h2>
            <ul class="list-plain">
                {% for item in view.pendingReviews %}
                    <li>
                        <strong>{{ item.label }}</strong>
                        <span class="muted">{{ item.meta }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>

    <div class="panel-grid-2 u-mt1">
        <section class="surface stack-md" aria-labelledby="analytics-heading">
            <h2 id="analytics-heading" class="u-h">Kazanım performansı</h2>
            <p class="panel-note">{{ view.privacyNote }}</p>
            <ul class="list-plain">
                {% for item in view.outcomePreview %}
                    <li>
                        <strong>{{ item.label }}</strong>
                        <span class="muted">{{ item.value }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section class="surface stack-md" aria-labelledby="cal-heading">
            <h2 id="cal-heading" class="u-h">Yaklaşan takvim</h2>
            <ul class="list-plain">
                {% for item in view.calendar %}
                    <li>
                        <strong>{{ item.label }}</strong>
                        <span class="muted">{{ item.when }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
