<section id="icerikler" class="hp-section" aria-labelledby="path-title">
    <div class="container">
        <h2 id="path-title" class="hp-section__title hp-section__title--center">İzlemekle kalma, öğrenmenin içine gir.</h2>
        <div class="hp-path-grid">
            {% for item in view.learningPath %}
                <article class="hp-path-card">
                    <img src="{{ item.image }}" alt="{{ item.imageAlt }}" width="360" height="220" loading="lazy" decoding="async">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.body }}</p>
                    <a class="hp-text-link" href="{{ item.linkHref }}">{{ item.linkLabel }} <span aria-hidden="true">→</span></a>
                </article>
            {% endfor %}
        </div>
    </div>
</section>
