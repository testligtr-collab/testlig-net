<header class="site-header" data-controller="mobile-nav">
    <div class="site-header__inner">
        {% include 'components/brand.html.twig' %}
        <nav class="site-nav" aria-label="Ana menü">
            <a href="{{ path('app_home') }}">Ana Sayfa</a>
            <a href="{{ path('app_legal_privacy') }}" {% if app.request.attributes.get('_route') == 'app_legal_privacy' %}aria-current="page"{% endif %}>Gizlilik</a>
            <a href="{{ path('app_legal_terms') }}" {% if app.request.attributes.get('_route') == 'app_legal_terms' %}aria-current="page"{% endif %}>Kullanım Koşulları</a>
            <a href="{{ path('app_legal_cookies') }}" {% if app.request.attributes.get('_route') == 'app_legal_cookies' %}aria-current="page"{% endif %}>Çerez Politikası</a>
            <a href="{{ path('app_legal_children') }}" {% if app.request.attributes.get('_route') == 'app_legal_children' %}aria-current="page"{% endif %}>Çocuk ve Veli</a>
        </nav>
        <div class="site-header__actions">
            <a class="btn btn--ghost" href="{{ path('app_login') }}">Giriş Yap</a>
            <a class="btn btn--cta" href="{{ path('app_register') }}">Ücretsiz Başla</a>
        </div>
        <button type="button" class="nav-toggle" data-mobile-nav-target="button" data-action="mobile-nav#toggle" aria-expanded="false" aria-controls="legal-mobile-nav">
            <span class="sr-only">Menüyü aç veya kapat</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M4 7h16v2H4V7zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
            </svg>
        </button>
    </div>
    <div id="legal-mobile-nav" class="mobile-drawer" data-mobile-nav-target="drawer" data-action="click->mobile-nav#closeOnNavigate" hidden>
        <nav aria-label="Mobil yasal menü">
            <a href="{{ path('app_home') }}">Ana Sayfa</a>
            <a href="{{ path('app_legal_privacy') }}">Gizlilik</a>
            <a href="{{ path('app_legal_terms') }}">Kullanım Koşulları</a>
            <a href="{{ path('app_legal_cookies') }}">Çerez Politikası</a>
            <a href="{{ path('app_legal_children') }}">Çocuk ve Veli Bilgilendirmesi</a>
            <a href="{{ path('app_login') }}">Giriş Yap</a>
            <a href="{{ path('app_register') }}">Ücretsiz Başla</a>
        </nav>
    </div>
</header>
