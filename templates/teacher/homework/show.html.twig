{% extends 'teacher/layout.html.twig' %}

{% block title %}{{ definition.title }} - Ödevlerim - Testlig{% endblock %}

{% block teacher_content %}
<section class="hw-page" aria-labelledby="hw-heading">
    <nav class="hw-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_teacher_homeworks') }}">Ödevlerim</a>
        <span aria-hidden="true">/</span>
        <span>Taslak</span>
    </nav>

    <header class="hw-head">
        <div class="hw-head__text">
            <h1 id="hw-heading" class="hw-wrap">{{ definition.title }}</h1>
            <p class="hw-sub"><span class="hw-badge hw-badge--draft">Taslak</span> Bu taslak öğrencilere atanmadı; öğrenciler göremez.</p>
        </div>
        {% if can_edit %}
            <a class="btn hw-btn hw-btn--primary" href="{{ path('app_teacher_homework_edit', {id: definition.id.toRfc4122}) }}">Düzenle</a>
        {% endif %}
    </header>

    <div class="hw-layout">
        <article class="hw-card hw-main" aria-labelledby="hw-desc-heading">
            <h2 id="hw-desc-heading">Ödev açıklaması</h2>
            <div class="hw-prose">{{ definition.description }}</div>
        </article>

        <aside class="hw-card hw-aside" aria-labelledby="hw-meta-heading">
            <h2 id="hw-meta-heading">Taslak bilgileri</h2>
            <dl class="hw-summary">
                <div><dt>Sınıf</dt><dd>{{ definition.classroom.name }}</dd></div>
                <div><dt>Kurum</dt><dd>{{ definition.institution.name }}</dd></div>
                <div><dt>Akademik yıl</dt><dd>{{ definition.academicYear.name }}</dd></div>
                <div><dt>Son teslim</dt><dd>{{ definition.dueAt|utc_present('d.m.Y H:i', 'Europe/Istanbul') }} <span class="hw-muted">(Europe/Istanbul)</span></dd></div>
                <div><dt>Durum</dt><dd>Taslak</dd></div>
                <div><dt>Sürüm</dt><dd>{{ definition.revisionNumber }}</dd></div>
                <div><dt>Son güncelleme</dt><dd>{{ definition.updatedAt|utc_present('d.m.Y H:i', 'Europe/Istanbul') }}</dd></div>
            </dl>
        </aside>
    </div>

    <p class="hw-actions">
        <a class="btn hw-btn hw-btn--ghost" href="{{ path('app_teacher_homeworks') }}">Ödevlerime dön</a>
    </p>
</section>
{% endblock %}
