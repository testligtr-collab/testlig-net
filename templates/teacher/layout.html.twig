{% extends 'base.html.twig' %}

{% block body_class %}is-workspace{% endblock %}

{% block stylesheets %}
    <meta name="robots" content="noindex, nofollow">
    {{ parent() }}
    <link rel="stylesheet" href="{{ mapped_asset('styles/workspace.css') }}">
{% endblock %}

{% block site_chrome %}
    {% include 'teacher/_header.html.twig' %}
{% endblock %}

{% block site_footer %}
    <footer class="workspace-footer">
        <p>Testlig</p>
        <nav aria-label="Yasal">
            {% include 'legal/_links.html.twig' %}
        </nav>
    </footer>
{% endblock %}

{% block body %}
    <div class="workspace-page">
        {% block teacher_content %}{% endblock %}
    </div>
{% endblock %}
