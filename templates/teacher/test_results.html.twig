{% extends 'teacher/layout.html.twig' %}

{% block title %}Sınıf test sonuçları — Testlig{% endblock %}

{% block teacher_content %}
<article class="workspace-card">
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_teacher_classrooms') }}">Sınıflarım</a>
        <span aria-hidden="true">/</span>
        <span>Sonuçlar</span>
    </nav>
    <h1>{{ report.title }}</h1>
    <p>{{ report.classroomName }}</p>
    <p>{{ report.windowLabel }}</p>
    <ul class="workspace-metrics">
        <li class="workspace-metric"><h3>Öğrenci</h3><p>{{ report.recipientCount }}</p></li>
        <li class="workspace-metric"><h3>Başlamadı</h3><p>{{ report.notStarted }}</p></li>
        <li class="workspace-metric"><h3>Devam ediyor</h3><p>{{ report.inProgress }}</p></li>
        <li class="workspace-metric"><h3>Tamamlandı</h3><p>{{ report.completed }}</p></li>
        <li class="workspace-metric"><h3>Süresi doldu</h3><p>{{ report.expired }}</p></li>
        <li class="workspace-metric"><h3>Tamamlanma</h3><p>{{ report.completionRate }}</p></li>
    </ul>
    <p>Ortalama: {{ report.averagePercentage|default('—') }}</p>
    <div class="table-scroll">
        <table class="institution-table">
            <thead>
                <tr>
                    <th>Öğrenci</th>
                    <th>Durum</th>
                    <th>Doğru</th>
                    <th>Yanlış</th>
                    <th>Boş</th>
                    <th>Puan</th>
                    <th>Yüzde</th>
                </tr>
            </thead>
            <tbody>
                {% for student in report.students %}
                    <tr>
                        <td data-label="Öğrenci">{{ student.name }}</td>
                        <td data-label="Durum">{{ student.statusLabel }}</td>
                        <td data-label="Doğru">{{ student.correct is null ? '—' : student.correct }}</td>
                        <td data-label="Yanlış">{{ student.incorrect is null ? '—' : student.incorrect }}</td>
                        <td data-label="Boş">{{ student.unanswered is null ? '—' : student.unanswered }}</td>
                        <td data-label="Puan">{{ student.earned is null ? '—' : student.earned ~ ' / ' ~ student.maximum }}</td>
                        <td data-label="Yüzde">{{ student.percentage|default('—') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</article>
{% endblock %}
