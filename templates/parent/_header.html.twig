{% set route = app.request.attributes.get('_route')|default('') %}
<header class="site-header student-header" data-controller="mobile-nav">
    <div class="site-header__inner">
        {% include 'components/brand.html.twig' with {href: path('app_parent_dashboard')} %}

        <nav class="site-nav" aria-label="Veli menüsü">
            <a href="{{ path('app_parent_dashboard') }}" {% if route == 'app_parent_dashboard' %}aria-current="page"{% endif %}>Panel</a>
            <a href="{{ path('app_parent_children') }}" {% if route == 'app_parent_children' or route == 'app_parent_child' %}aria-current="page"{% endif %}>Çocuklarım</a>
            <a href="{{ path('app_parent_tests') }}" {% if route == 'app_parent_tests' %}aria-current="page"{% endif %}>Test sonuçları</a>
            <a href="{{ path('app_account') }}" {% if route == 'app_account' or route == 'app_account_change_password' %}aria-current="page"{% endif %}>Hesabım</a>
        </nav>

        <div class="site-header__actions">
            <form method="post" action="{{ path('app_logout') }}" class="logout-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn btn--ghost">Çıkış</button>
            </form>
        </div>

        <button
            type="button"
            class="nav-toggle"
            data-mobile-nav-target="button"
            data-action="mobile-nav#toggle"
            aria-expanded="false"
            aria-controls="parent-mobile-nav"
        >
            <span class="sr-only">Menüyü aç veya kapat</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M4 7h16v2H4V7zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
            </svg>
        </button>
    </div>

    <div
        id="parent-mobile-nav"
        class="mobile-drawer"
        data-mobile-nav-target="drawer"
        data-action="click->mobile-nav#closeOnNavigate"
        hidden
    >
        <nav aria-label="Mobil veli menüsü">
            <a href="{{ path('app_parent_dashboard') }}" {% if route == 'app_parent_dashboard' %}aria-current="page"{% endif %}>Panel</a>
            <a href="{{ path('app_parent_children') }}" {% if route == 'app_parent_children' or route == 'app_parent_child' %}aria-current="page"{% endif %}>Çocuklarım</a>
            <a href="{{ path('app_parent_tests') }}" {% if route == 'app_parent_tests' %}aria-current="page"{% endif %}>Test sonuçları</a>
            <a href="{{ path('app_account') }}" {% if route == 'app_account' or route == 'app_account_change_password' %}aria-current="page"{% endif %}>Hesabım</a>
        </nav>
        <div class="mobile-drawer__actions">
            <form method="post" action="{{ path('app_logout') }}" class="logout-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn btn--ghost btn--block">Çıkış</button>
            </form>
        </div>
    </div>
</header>
