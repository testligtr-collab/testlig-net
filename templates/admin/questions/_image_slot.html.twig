<div class="admin-question-image-box">
    <div class="admin-question-image-frame" data-image-preview>
        <p>250 × 250 önizleme. Görsel oranını korur.</p>
    </div>
    {% if error %}
        <p class="admin-question-field-error" id="question-error-image">{{ error }}</p>
    {% endif %}
    <label>{{ label }}
        <input type="file" name="{{ name }}" accept="image/jpeg,image/png,image/webp" data-image-file{% if error %} aria-invalid="true" aria-describedby="question-error-image"{% endif %}>
    </label>
    {% if kept %}
        <label class="admin-question-keep">
            <input type="checkbox" name="keep_slot[]" value="{{ slot }}" checked>
            Kayıtlı görseli yeni sürümde tut
        </label>
    {% endif %}
</div>
