{% extends 'admin/layout.html.twig' %}

{% block title %}{{ question ? 'Soruyu düzenle' : 'Yeni soru' }} — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_questions') }}">Soru Havuzu</a>
        <span aria-hidden="true">/</span>
        <span>{{ question ? 'Düzenle' : 'Yeni soru' }}</span>
    </nav>
    <div class="admin-user-page admin-question-page">
        <header class="admin-user-head">
            <div>
                <p class="admin-question-kicker">Soru düzenleyici</p>
                <h1 class="panel-greeting">{{ question ? 'Soruyu düzenle' : 'Yeni soru' }}</h1>
                <p>Soru metni ve seçenekler kaydedilince yeni bir taslak sürüm oluşur. Yayımlanmış sürüm yerinde değişmez.</p>
            </div>
        </header>
        {% if errors.summary|default('') %}
            <p class="admin-question-error" role="alert">{{ errors.summary }}</p>
        {% endif %}

        <div class="admin-question-stage">
            <div class="admin-question-main">
                <form method="post" id="question-editor" enctype="multipart/form-data" data-controller="question-options question-rich-editor" action="{{ question ? path('app_admin_question_edit', {id: question.id.toRfc4122}) : path('app_admin_question_new') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('question_editor') }}">
                    <input type="hidden" name="expected_revision" value="{{ expected_revision }}">
                    <input type="hidden" name="grade" value="{{ grade }}">
                    <input type="hidden" name="subject_id" value="{{ subject_id }}">

                    <section class="admin-section">
                        <h2>Soru metni</h2>
                        {% if errors.fields.stem|default('') %}
                            <p class="admin-question-field-error" id="question-error-stem">{{ errors.fields.stem }}</p>
                        {% endif %}
                        <div class="admin-question-stem-layout">
                            <div class="q-field" data-editor-field data-initial-document="{{ values.stem_document|default('')|e('html_attr') }}">
                                {% include 'admin/questions/_editor_tools.html.twig' with { label: 'Soru kökü araçları' } only %}
                                <div class="q-surface" contenteditable="true" role="textbox" aria-multiline="true" data-editor-surface aria-label="Soru kökü"></div>
                                <textarea id="question-stem" name="stem" rows="8" required class="q-fallback" aria-invalid="{{ errors.fields.stem|default('') ? 'true' : 'false' }}" {% if errors.fields.stem|default('') %}aria-describedby="question-error-stem"{% endif %}>{{ values.stem }}</textarea>
                                <input type="hidden" name="stem_document" value="">
                            </div>
                            <div class="admin-question-image-box">
                                <div class="admin-question-image-frame" data-image-preview>
                                    <p>{{ image_note|default('250 × 250 önizleme. Görsel oranını korur.') }}</p>
                                </div>
                                {% if errors.fields.question_image|default('') %}
                                    <p class="admin-question-field-error" id="question-error-image">{{ errors.fields.question_image }}</p>
                                {% endif %}
                                <label for="question-image">Görsel
                                    <input id="question-image" type="file" name="question_image" accept="image/jpeg,image/png,image/webp" aria-invalid="{{ errors.fields.question_image|default('') ? 'true' : 'false' }}" {% if errors.fields.question_image|default('') %}aria-describedby="question-error-image"{% endif %}>
                                </label>
                                <label for="question-image-target">Görselin yeri
                                    <select id="question-image-target" name="image_target">
                                        <option value="stem" {{ values.image_slot|default('stem') == 'stem' ? 'selected' : '' }}>Soru kökü</option>
                                        <option value="explanation" {{ values.image_slot|default('') == 'explanation' ? 'selected' : '' }}>Çözüm</option>
                                        {% for text in values.options %}
                                            <option value="option:{{ loop.index }}" {{ values.image_slot|default('') == 'option:' ~ loop.index ? 'selected' : '' }}>Seçenek {{ 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[loop.index0:1] }}</option>
                                        {% endfor %}
                                    </select>
                                </label>
                                {% if values.has_image|default(false) %}
                                    <label class="admin-question-keep">
                                        <input type="checkbox" name="keep_image" value="1" checked>
                                        Kayıtlı görseli yeni sürümde tut
                                    </label>
                                {% endif %}
                                <p class="admin-question-hint">Yeni görsel taslağa bağlanır ve tarama bekler. Hazır olmayan dosya öğrenciye sunulmaz. Önizleme kutusu dosyayı küçültmez.</p>
                            </div>
                        </div>
                    </section>

                    <section class="admin-section">
                        <h2>Cevap seçenekleri</h2>
                        {% if errors.fields.options|default('') %}
                            <p class="admin-question-field-error" id="question-error-options">{{ errors.fields.options }}</p>
                        {% endif %}
                        {% if errors.fields.correct|default('') %}
                            <p class="admin-question-field-error" id="question-error-correct">{{ errors.fields.correct }}</p>
                        {% endif %}
                        <div id="option-list">
                            {% for text in values.options %}
                                <div class="option-row admin-question-option" data-editor-field data-initial-document="{{ values.option_documents[loop.index0]|default('')|e('html_attr') }}">
                                    <span class="admin-question-option__letter" aria-hidden="true">{{ 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[loop.index0:1] }}</span>
                                    {% include 'admin/questions/_editor_tools.html.twig' with { label: 'Seçenek araçları' } only %}
                                    <div class="q-surface" contenteditable="true" role="textbox" aria-multiline="true" data-editor-surface aria-label="Seçenek {{ loop.index }}"></div>
                                    <label class="q-fallback-label">Seçenek
                                        <textarea name="options[]" rows="3" required class="q-fallback">{{ text }}</textarea>
                                    </label>
                                    <input type="hidden" name="options_document[]" value="">
                                    <label class="admin-question-correct">
                                        <input type="radio" name="correct" value="{{ loop.index }}" {{ values.correct == loop.index ? 'checked' : '' }} required>
                                        Doğru cevap
                                    </label>
                                    <button class="btn btn--ghost" type="button" data-remove-option>Kaldır</button>
                                </div>
                            {% endfor %}
                        </div>
                        <button class="btn" type="button" id="add-option">Seçenek ekle</button>
                    </section>

                    <section class="admin-section">
                        <h2>Çözüm</h2>
                        {% if errors.fields.explanation|default('') %}
                            <p class="admin-question-field-error" id="question-error-explanation">{{ errors.fields.explanation }}</p>
                        {% endif %}
                        <div class="q-field" data-editor-field data-initial-document="{{ values.explanation_document|default('')|e('html_attr') }}">
                            {% include 'admin/questions/_editor_tools.html.twig' with { label: 'Çözüm araçları' } only %}
                            <div class="q-surface" contenteditable="true" role="textbox" aria-multiline="true" data-editor-surface aria-label="Çözüm"></div>
                            <label class="q-fallback-label" for="question-explanation">Çözüm metni
                                <textarea id="question-explanation" name="explanation" rows="6" class="q-fallback" aria-invalid="{{ errors.fields.explanation|default('') ? 'true' : 'false' }}" {% if errors.fields.explanation|default('') %}aria-describedby="question-error-explanation"{% endif %}>{{ values.explanation }}</textarea>
                            </label>
                            <input type="hidden" name="explanation_document" value="">
                        </div>
                        <div class="admin-question-form-actions">
                            <button class="btn admin-institution-primary" type="submit">Taslak kaydet</button>
                        </div>
                    </section>
                </form>
                {% if can_submit %}
                    <form method="post" action="{{ path('app_admin_question_submit', {id: question.id.toRfc4122}) }}" class="admin-section admin-question-submit" data-warn-unsaved="1">
                        <h2>İncelemeye gönder</h2>
                        <p class="admin-question-hint">Bu eylem kayıtlı sürümü gönderir. Kaydedilmemiş metin dahil değildir.</p>
                        <input type="hidden" name="_token" value="{{ csrf_token('question_editor') }}">
                        <input type="hidden" name="expected_revision" value="{{ expected_revision }}">
                        <label for="question-submit-note">İşlem notu
                            <textarea id="question-submit-note" name="operator_note" maxlength="500" rows="2"></textarea>
                        </label>
                        <button class="btn btn--primary" type="submit">İncelemeye gönder</button>
                    </form>
                {% endif %}
            </div>

            <aside class="admin-question-side">
                <form method="get" class="admin-section" action="{{ question ? path('app_admin_question_edit', {id: question.id.toRfc4122}) : path('app_admin_question_new') }}">
                    <h2>Kazanımları getir</h2>
                    {% if errors.fields.grade|default('') %}
                        <p class="admin-question-field-error" id="question-error-grade">{{ errors.fields.grade }}</p>
                    {% endif %}
                    <label for="question-grade">Sınıf
                        <select id="question-grade" name="grade">
                            {% for item in grades %}
                                <option value="{{ item.value }}" {{ grade == item.value ? 'selected' : '' }}>{{ item.value }}. sınıf</option>
                            {% endfor %}
                        </select>
                    </label>
                    {% if errors.fields.subject_id|default('') %}
                        <p class="admin-question-field-error" id="question-error-subject">{{ errors.fields.subject_id }}</p>
                    {% endif %}
                    <label for="question-subject">Ders
                        <select id="question-subject" name="subject_id">
                            {% for subject in subjects %}
                                <option value="{{ subject.id.toRfc4122 }}" {{ subject_id == subject.id.toRfc4122 ? 'selected' : '' }}>{{ subject.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button class="btn" type="submit">Kazanımları getir</button>
                </form>
                <section class="admin-section">
                    <h2>Sınıflandırma</h2>
                    {% if errors.fields.outcome_id|default('') %}
                        <p class="admin-question-field-error" id="question-error-outcome">{{ errors.fields.outcome_id }}</p>
                    {% endif %}
                    <label for="question-outcome">Kazanım
                        <select id="question-outcome" name="outcome_id" form="question-editor" required aria-invalid="{{ errors.fields.outcome_id|default('') ? 'true' : 'false' }}" {% if errors.fields.outcome_id|default('') %}aria-describedby="question-error-outcome"{% endif %}>
                            <option value="">Seçin</option>
                            {% for outcome in outcomes %}
                                <option value="{{ outcome.id.toRfc4122 }}" {{ values.outcome_id == outcome.id.toRfc4122 ? 'selected' : '' }}>{{ outcome.code }} — {{ outcome.description }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    {% if errors.fields.difficulty|default('') %}
                        <p class="admin-question-field-error" id="question-error-difficulty">{{ errors.fields.difficulty }}</p>
                    {% endif %}
                    <fieldset class="admin-question-difficulty">
                        <legend>Zorluk</legend>
                        {% for value, label in difficulties %}
                            <label class="admin-question-pill">
                                <input type="radio" name="difficulty" value="{{ value }}" form="question-editor" {{ values.difficulty == value ? 'checked' : '' }} {% if loop.first %}required{% endif %}>
                                {{ label }}
                            </label>
                        {% endfor %}
                    </fieldset>
                </section>
            </aside>
        </div>
    </div>
{% endblock %}
