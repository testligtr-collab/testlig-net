<div class="q-toolbar" role="toolbar" aria-label="{{ label|default('Metin araçları') }}">
    <button type="button" data-editor-command="bold" aria-label="Kalın"><b>B</b></button>
    <button type="button" data-editor-command="italic" aria-label="İtalik"><i>I</i></button>
    <button type="button" data-editor-command="underline" aria-label="Altı çizili"><u>U</u></button>
    <button type="button" data-editor-command="bullet" aria-label="Liste">Liste</button>
    <button type="button" data-editor-command="ordered" aria-label="Numaralı liste">1.</button>
    <button type="button" data-editor-command="undo" aria-label="Geri al">Geri</button>
    <button type="button" data-editor-command="redo" aria-label="Yeniden yap">İleri</button>
</div>
<div class="q-palettes">
    <div>
        <span>Matematik</span>
        <button type="button" data-editor-math="\frac{a}{b}" aria-label="Kesir">a/b</button>
        <button type="button" data-editor-math="\sqrt{x}" aria-label="Kök">√</button>
        <button type="button" data-editor-math="x^{2}" aria-label="Üs">x²</button>
        <button type="button" data-editor-math="x_{n}" aria-label="İndis">xₙ</button>
        <button type="button" data-editor-math="\left(x\right)" aria-label="Parantez">( )</button>
        <button type="button" data-editor-math="\sum_{i=1}^{n}" aria-label="Toplam">∑</button>
        <button type="button" data-editor-math="\int_{a}^{b}" aria-label="İntegral">∫</button>
        <button type="button" data-editor-math="\le" aria-label="Küçük eşit">≤</button>
        <button type="button" data-editor-math="x < y" aria-label="Küçüktür">&lt;</button>
        <button type="button" data-editor-math="x > y" aria-label="Büyüktür">&gt;</button>
        <button type="button" data-editor-math="\pi" aria-label="Pi">π</button>
    </div>
    <div>
        <span>Geometri</span>
        <button type="button" data-editor-math="\angle ABC" aria-label="Açı">∠</button>
        <button type="button" data-editor-math="90^{\circ}" aria-label="Derece">°</button>
        <button type="button" data-editor-math="AB \parallel CD" aria-label="Paralellik">∥</button>
        <button type="button" data-editor-math="AB \perp CD" aria-label="Diklik">⊥</button>
        <button type="button" data-editor-math="\overline{AB}" aria-label="Doğru parçası">AB</button>
        <button type="button" data-editor-math="\triangle ABC" aria-label="Üçgen">△</button>
    </div>
    <div>
        <span>Kimya</span>
        <button type="button" data-editor-math="H_{2}O" aria-label="Su">H₂O</button>
        <button type="button" data-editor-math="Fe^{3+}" aria-label="İyon yükü">Fe³⁺</button>
        <button type="button" data-editor-math="A \rightarrow B" aria-label="Tepkime oku">→</button>
        <button type="button" data-editor-math="A \leftrightarrow B" aria-label="Çift yönlü ok">⇌</button>
    </div>
    <div>
        <span>Biyoloji</span>
        <button type="button" data-editor-math="CO_{2}" aria-label="Karbondioksit">CO₂</button>
        <button type="button" data-editor-math="O_{2}" aria-label="Oksijen">O₂</button>
        <button type="button" data-editor-math="a \times 10^{n}" aria-label="Bilimsel gösterim">×10ⁿ</button>
    </div>
</div>
