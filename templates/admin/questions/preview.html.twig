{% extends 'admin/layout.html.twig' %}

{% block title %}Soru önizleme — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_question_show', {id: question.id.toRfc4122}) }}">Soru</a>
        <span aria-hidden="true">/</span>
        <span>Önizleme</span>
    </nav>
    <div class="admin-user-page admin-question-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Önizleme</h1>
                <p>Bu görünüm cevap anahtarını göstermez.</p>
            </div>
        </header>
        <section class="admin-section admin-question-preview" aria-label="Soru önizlemesi">
            <div class="admin-question-preview__body">
                {% if stem_blocks|default([]) is not empty %}
                    {% include 'components/question_blocks.html.twig' with { blocks: stem_blocks } only %}
                {% else %}
                    {% for line in stem_lines %}
                        <p>{{ line }}</p>
                    {% endfor %}
                {% endif %}
                <ol class="admin-question-choices">
                    {% for line in option_lines %}
                        <li>
                            <span class="admin-question-option__letter" aria-hidden="true">{{ 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[loop.index0:1] }}</span>
                            {% if option_blocks[loop.index0]|default([]) is not empty %}
                                {% include 'components/question_blocks.html.twig' with { blocks: option_blocks[loop.index0] } only %}
                            {% else %}
                                {{ line }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
                {% if explanation_blocks|default([]) is not empty %}
                    <h2>Çözüm</h2>
                    {% include 'components/question_blocks.html.twig' with { blocks: explanation_blocks } only %}
                {% elseif explanation_lines is not empty %}
                    <h2>Çözüm</h2>
                    {% for line in explanation_lines %}
                        <p>{{ line }}</p>
                    {% endfor %}
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
