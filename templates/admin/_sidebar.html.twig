<aside id="panel-sidebar" class="panel-sidebar" aria-label="{{ workspace_shell|default(false) ? 'Çalışma alanı menüsü' : 'Yönetim menüsü' }}">
    <div class="admin-sidebar__brand">
        {% include 'components/brand.html.twig' with { href: (workspace_shell|default(false) ? path('app_workspace_dashboard') : path('app_home')) } only %}
        <p class="admin-sidebar__context">{{ workspace_shell|default(false) ? 'Çalışma alanı' : 'Yönetim' }}</p>
    </div>
    <div class="admin-sidebar__user">
        {% include 'components/avatar.html.twig' with { initials: avatar_initials } only %}
        <div>
            <p class="admin-sidebar__name">{{ display_name }}</p>
            <p class="panel-role">{{ panel_role_label }}</p>
        </div>
    </div>
    <nav class="panel-sidebar__nav" aria-label="Yönetim bölümleri">
        {% for section in nav_sections|default([]) %}
            {% if workspace_shell|default(false) %}
                <div class="panel-nav-group panel-nav-group--{{ section.id }}">
                    <p class="panel-nav-group__label" id="nav-group-{{ section.id }}">{{ section.label }}</p>
                    <div role="group" aria-labelledby="nav-group-{{ section.id }}">
                        {% for item in section['items'] %}
                            <a
                                class="panel-nav-link"
                                href="{{ item.href }}"
                                data-action="click->panel-shell#closeMenu"
                                {% if item.current %}aria-current="page"{% endif %}
                            >
                                {% include 'components/admin_icon.html.twig' with { icon: item.icon|default('default') } only %}
                                <span>{{ item.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% elseif section.id == 'overview' %}
                <div class="panel-nav-group panel-nav-group--overview" id="nav-group-overview">
                    {% for item in section['items'] %}
                        <a class="panel-nav-link" href="{{ item.href }}" data-action="click->panel-shell#closeMenu" {% if item.current %}aria-current="page"{% endif %}>
                            {% include 'components/admin_icon.html.twig' with {icon: item.icon|default('default')} only %}
                            <span>{{ item.label }}</span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                {% set group_icons = {
                    overview: 'dashboard',
                    people: 'users',
                    campus: 'institutions',
                    learning: 'catalog',
                    media: 'learning_contents',
                    interactive: 'questions',
                    communication: 'account',
                    site: 'default',
                    commerce: 'payments',
                    integrations: 'webhooks',
                    system: 'system'
                } %}
                <details class="panel-nav-group panel-nav-group--{{ section.id }}" id="nav-group-{{ section.id }}" {% if section.open|default(false) %}open{% endif %}>
                    <summary class="panel-nav-group__label">
                        <span class="panel-nav-group__mark">
                            {% include 'components/admin_icon.html.twig' with { icon: group_icons[section.id]|default('default') } only %}
                        </span>
                        <span class="panel-nav-group__title">{{ section.label }}</span>
                    </summary>
                    <div>
                        {% for item in section['items'] %}
                            <a
                                class="panel-nav-link"
                                href="{{ item.href }}"
                                data-action="click->panel-shell#closeMenu"
                                {% if item.current %}aria-current="page"{% endif %}
                            >
                                {% include 'components/admin_icon.html.twig' with { icon: item.icon|default('default') } only %}
                                <span>{{ item.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </details>
            {% endif %}
        {% endfor %}
    </nav>
    <div class="admin-sidebar__foot">
        <a class="panel-nav-link" href="{{ path('app_home') }}" data-action="click->panel-shell#closeMenu">
            {% include 'components/admin_icon.html.twig' with { icon: 'default' } only %}
            <span>Ana sayfa</span>
        </a>
        <a class="panel-nav-link" href="{{ path('app_account') }}" data-action="click->panel-shell#closeMenu">
            {% include 'components/admin_icon.html.twig' with { icon: 'account' } only %}
            <span>Hesabım</span>
        </a>
        <form method="post" action="{{ path('app_logout') }}" class="admin-logout-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="panel-nav-link admin-sidebar__logout">
                {% include 'components/admin_icon.html.twig' with { icon: 'default' } only %}
                <span>Çıkış</span>
            </button>
        </form>
        <button
            type="button"
            class="btn btn--ghost admin-sidebar__collapse"
            data-action="panel-shell#toggle"
            data-panel-shell-target="toggle"
            aria-pressed="false"
        >Kenar çubuğunu daralt</button>
    </div>
</aside>
