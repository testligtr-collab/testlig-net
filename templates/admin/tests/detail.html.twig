{% extends 'admin/layout.html.twig' %}

{% block title %}Test detayı — Testlig{% endblock %}

{% block panel_content %}
    {% set test_status = admin_status(assessment.status.value) %}
    {% set policy_variant = 'warning' %}
    {% if access_policy and access_policy.accessClass.value == 'free' %}
        {% set policy_variant = 'success' %}
    {% elseif access_policy and access_policy.accessClass.value == 'entitlement_required' %}
        {% set policy_variant = 'limited' %}
    {% endif %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_tests') }}">Testler</a>
        <span aria-hidden="true">/</span>
        <span>Test detayı</span>
    </nav>
    <div class="admin-user-page admin-test-page admin-test-detail">
        <header class="admin-user-head admin-test-detail__head">
            <div class="admin-test-detail__title">
                <h1 class="panel-greeting">{{ revision.title }}</h1>
                <span class="admin-status admin-status--{{ test_status.variant }} admin-test-detail__status"><span class="admin-status__dot" aria-hidden="true"></span>{{ test_status.label }}</span>
            </div>
            <div class="admin-test-detail__actions">
                <a class="btn btn--ghost" href="{{ path('app_admin_test_preview', {id: assessment.id.toRfc4122}) }}">Önizleme</a>
                {% if can_view_results %}
                    <a class="btn btn--ghost" href="{{ path('app_admin_test_results', {id: assessment.id.toRfc4122}) }}">Sonuçlar</a>
                {% endif %}
                {% if can_edit %}
                    <a class="btn admin-test-primary" href="{{ path('app_admin_test_edit', {id: assessment.id.toRfc4122}) }}">Düzenle</a>
                {% endif %}
            </div>
        </header>

        <section class="admin-test-detail__card admin-test-detail__summary" aria-label="Test özeti">
            <ul class="admin-test-detail__metrics">
                <li>
                    <span class="admin-test-detail__metric-icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'tests' } only %}</span>
                    <span class="admin-test-detail__metric-copy"><span>Test türü</span><strong>{{ type_label }}</strong></span>
                </li>
                <li>
                    <span class="admin-test-detail__metric-icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span>
                    <span class="admin-test-detail__metric-copy"><span>Ders</span><strong>{{ subject_name }}</strong></span>
                </li>
                <li>
                    <span class="admin-test-detail__metric-icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'classrooms' } only %}</span>
                    <span class="admin-test-detail__metric-copy"><span>Sınıf</span><strong>{{ grade_label }}</strong></span>
                </li>
                <li>
                    <span class="admin-test-detail__metric-icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'questions' } only %}</span>
                    <span class="admin-test-detail__metric-copy"><span>Soru sayısı</span><strong class="admin-test-detail__count">{{ question_count }}</strong></span>
                </li>
                <li>
                    <span class="admin-test-detail__metric-icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'tests' } only %}</span>
                    <span class="admin-test-detail__metric-copy"><span>Toplam puan</span><strong class="admin-test-detail__points">{{ total_points }}</strong></span>
                </li>
                <li>
                    <span class="admin-test-detail__metric-icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'clock' } only %}</span>
                    <span class="admin-test-detail__metric-copy"><span>Süre</span><strong class="admin-test-detail__duration">{{ duration_label }}</strong></span>
                </li>
            </ul>
        </section>

        <div class="admin-test-detail__layout">
            <div class="admin-test-detail__main">
                <section class="admin-test-detail__card" aria-labelledby="test-content-heading">
                    <h2 id="test-content-heading">Test içeriği</h2>
                    <h3>Yönerge</h3>
                    {% if revision.instructions %}
                        <p class="admin-test-detail__instructions">{{ revision.instructions }}</p>
                    {% else %}
                        <p class="admin-test-detail__empty">Yönerge yok.</p>
                    {% endif %}
                    <h3>Sorular</h3>
                    {% if rows is empty %}
                        <p class="admin-test-detail__empty">Bu sürümde soru yok.</p>
                    {% else %}
                        <ol class="admin-test-detail__questions">
                            {% for row in rows %}
                                <li class="admin-test-detail__question">
                                    <span class="admin-test-detail__index">{{ row.position }}</span>
                                    <p>{{ row.stem ?: 'Soru özeti yok.' }}</p>
                                    <span class="admin-test-detail__score">{{ row.points }} puan</span>
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                    <details class="admin-test-tech admin-test-detail__ops">
                        <summary role="button">Teknik bilgiler</summary>
                        <div class="admin-test-tech__panel admin-test-detail__ops-panel">
                            <dl>
                                <div><dt>Teknik kod</dt><dd><code>{{ assessment.code }}</code></dd></div>
                                <div><dt>Sürüm</dt><dd>{{ revision.revisionNumber }}</dd></div>
                                {% for row in rows %}
                                    <div><dt>{{ row.position }}. soru</dt><dd><code>{{ row.code }}</code></dd></div>
                                {% endfor %}
                            </dl>
                        </div>
                    </details>
                </section>
            </div>

            <div class="admin-test-detail__side">
                <section class="admin-test-detail__card" aria-labelledby="test-publish-heading">
                    <div class="admin-test-detail__card-head">
                        <h2 id="test-publish-heading">Yayın durumu</h2>
                        <span class="admin-status admin-status--{{ test_status.variant }}"><span class="admin-status__dot" aria-hidden="true"></span>{{ test_status.label }}</span>
                    </div>
                    {% if assessment.status.value == 'published' %}
                        <p>Yayımlanmış sürüm korunur.</p>
                    {% endif %}
                    <p><strong>{{ progress.next.label }}</strong> {{ progress.next.hint }}</p>
                    {% if progress.next.kind == 'submit' or progress.next.kind == 'return' or progress.next.kind == 'publish' or progress.next.kind == 'archive' %}
                        <details class="admin-test-detail__ops">
                            <summary role="button">İşlemler</summary>
                            <div class="admin-test-detail__ops-panel">
                                {% if progress.next.kind == 'submit' %}
                                    <form method="post" action="{{ path('app_admin_test_submit', {id: assessment.id.toRfc4122}) }}" class="stack-sm">
                                        <input type="hidden" name="_token" value="{{ csrf_token('test_editor') }}">
                                        <input type="hidden" name="expected_revision" value="{{ revision.revisionNumber }}">
                                        <label>İşlem notu
                                            <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                                        </label>
                                        <button class="btn admin-test-primary" type="submit">İncelemeye gönder</button>
                                    </form>
                                {% elseif progress.next.kind == 'return' %}
                                    <form method="post" action="{{ path('app_admin_test_return', {id: assessment.id.toRfc4122}) }}" class="stack-sm">
                                        <input type="hidden" name="_token" value="{{ csrf_token('test_editor') }}">
                                        <input type="hidden" name="expected_revision" value="{{ revision.revisionNumber }}">
                                        <label>İşlem notu
                                            <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                                        </label>
                                        <button class="btn admin-test-primary" type="submit">Taslağa döndür</button>
                                    </form>
                                {% elseif progress.next.kind == 'publish' %}
                                    <form method="post" action="{{ path('app_admin_test_publish', {id: assessment.id.toRfc4122}) }}" class="stack-sm">
                                        <input type="hidden" name="_token" value="{{ csrf_token('test_editor') }}">
                                        <input type="hidden" name="expected_revision" value="{{ revision.revisionNumber }}">
                                        <label>İşlem notu
                                            <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                                        </label>
                                        <button class="btn admin-test-primary" type="submit">Yayınla</button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('app_admin_test_archive', {id: assessment.id.toRfc4122}) }}" class="stack-sm">
                                        <input type="hidden" name="_token" value="{{ csrf_token('test_editor') }}">
                                        <input type="hidden" name="expected_revision" value="{{ revision.revisionNumber }}">
                                        <label>İşlem notu
                                            <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                                        </label>
                                        <p>Bu işlem geri alınamaz.</p>
                                        <button class="btn admin-test-detail__danger" type="submit">Arşivle</button>
                                    </form>
                                {% endif %}
                            </div>
                        </details>
                    {% endif %}
                </section>

                <section class="admin-test-detail__card" aria-labelledby="access-policy-heading">
                    <div class="admin-test-detail__card-head">
                        <h2 id="access-policy-heading">Öğrenci erişimi</h2>
                        <span class="admin-status admin-status--{{ policy_variant }} admin-test-detail__policy">{{ access_policy_label }}</span>
                    </div>
                    <p>Yayın ve erişim ayrı yönetilir.</p>
                    <p class="admin-test-detail__hint">Bu politika platform öğrenci keşfi ve yeni deneme başlangıcına uygulanır. Öğrencinin kendi devam eden veya tamamlanmış denemesi politika değişikliğinden kesilmez. Kurum atamaları bu politikadan bağımsızdır.</p>
                    {% if can_set_access_policy %}
                        <details class="admin-test-detail__ops">
                            <summary role="button">Erişimi yönet</summary>
                            <div class="admin-test-detail__ops-panel">
                                <p>Ücretsiz seçimi açık onay gerektirir.</p>
                                <form method="post" action="{{ path('app_admin_test_policy', {id: assessment.id.toRfc4122}) }}" class="stack-sm">
                                    <input type="hidden" name="_token" value="{{ csrf_token('assessment_access_policy_' ~ assessment.id.toRfc4122) }}">
                                    <label>Politika
                                        <select name="access_class" id="access_class">
                                            <option value="entitlement_required" {% if access_policy and access_policy.accessClass.value == 'entitlement_required' %}selected{% endif %}>Lisans gerekli</option>
                                            <option value="free" {% if access_policy and access_policy.accessClass.value == 'free' %}selected{% endif %}>Ücretsiz</option>
                                        </select>
                                    </label>
                                    <label class="admin-test-detail__check">
                                        <input type="checkbox" name="confirm_free" value="1">
                                        Bu test ücretsiz erişime açılacak
                                    </label>
                                    <button type="submit" class="btn admin-test-primary">Politikayı kaydet</button>
                                </form>
                            </div>
                        </details>
                    {% endif %}
                </section>

                <section class="admin-test-detail__card" aria-labelledby="placements-heading">
                    <h2 id="placements-heading">Katalog yerleşimleri</h2>
                    <p class="admin-test-detail__hint">Katalog yayını ayrı işlemdir. Yerleşim yalnızca navigasyondur; öğrenci test gövdesi burada gösterilmez.</p>
                    {% if placements is empty %}
                        <p class="admin-test-detail__empty">Henüz yerleşim yok.</p>
                    {% else %}
                        <ul class="admin-test-detail__placements">
                            {% for p in placements %}
                                <li class="admin-test-detail__placement">
                                    <div>
                                        <p class="admin-test-detail__placement-path">
                                            {% if is_granted('ADMIN_CATALOG_VIEW') %}
                                                <a href="{{ path('app_admin_catalog_topic', {id: p.catalogTopic.id.toRfc4122}) }}">{{ p.catalogTopic.unit.subject.name }} / {{ p.catalogTopic.unit.name }} / {{ p.catalogTopic.name }}</a>
                                            {% else %}
                                                {{ p.catalogTopic.unit.subject.name }} / {{ p.catalogTopic.unit.name }} / {{ p.catalogTopic.name }}
                                            {% endif %}
                                        </p>
                                        <p>{{ p.displayTitle }}</p>
                                        <p class="admin-test-detail__hint"><code>{{ p.slug }}</code> · Sıra {{ p.position }}</p>
                                    </div>
                                    <span class="admin-status admin-status--{{ p.visibilityStatus.value == 'published' ? 'success' : (p.visibilityStatus.value == 'in_review' ? 'warning' : 'neutral') }} admin-test-detail__placement-status">{{ p.visibilityStatus.value|workflow_label('status') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if can_create_placement or placements is not empty %}
                        <details class="admin-test-detail__ops">
                            <summary role="button">Yerleşim işlemleri</summary>
                            <div class="admin-test-detail__ops-panel">
                                {% for p in placements %}
                                    {% if is_granted('CATALOG_TOPIC_ASSESSMENT_PUBLISH', p) and p.visibilityStatus.value == 'draft' %}
                                        <form method="post" action="{{ path('app_admin_test_placement_publish', {placementId: p.id.toRfc4122}) }}" class="stack-sm" data-controller="confirm-submit" data-action="submit->confirm-submit#submit" data-confirm-submit-message-value="Yerleşimi yayımlamak istediğinize emin misiniz?">
                                            <input type="hidden" name="_token" value="{{ csrf_token('test_placement_publish_' ~ p.id.toRfc4122) }}">
                                            <input type="hidden" name="note" value="{{ reason_placement_publish }}">
                                            <p>{{ p.displayTitle }}</p>
                                            <label class="admin-test-detail__check">
                                                <input type="checkbox" name="confirm_publish" value="1" required>
                                                Onaylıyorum
                                            </label>
                                            <button type="submit" class="btn admin-test-primary">Yerleşimi yayımla</button>
                                        </form>
                                    {% endif %}
                                    {% if is_granted('CATALOG_TOPIC_ASSESSMENT_ARCHIVE', p) and p.visibilityStatus.value != 'archived' %}
                                        <form method="post" action="{{ path('app_admin_test_placement_archive', {placementId: p.id.toRfc4122}) }}" class="stack-sm" data-controller="confirm-submit" data-action="submit->confirm-submit#submit" data-confirm-submit-message-value="Arşivleme geri alınamaz. Devam?">
                                            <input type="hidden" name="_token" value="{{ csrf_token('test_placement_archive_' ~ p.id.toRfc4122) }}">
                                            <input type="hidden" name="note" value="{{ reason_placement_archive }}">
                                            <p>{{ p.displayTitle }}</p>
                                            <button type="submit" class="btn btn--ghost">Arşivle</button>
                                        </form>
                                    {% endif %}
                                {% endfor %}
                                {% if can_create_placement %}
                                    <h3 id="placement-form">Yerleşim ekle</h3>
                                    {% if bindable_topics is empty %}
                                        <p class="admin-test-detail__empty">Eşlenmiş katalog konusu yok. Önce müfredatta canonical eşleme yapın ve test ders/sınıfı ile uyuşan konuları yayımlayın.</p>
                                    {% else %}
                                        <form method="post" action="{{ path('app_admin_test_placement_create', {id: assessment.id.toRfc4122}) }}" class="stack-sm" id="placement-create-form" data-controller="placement-defaults">
                                            <input type="hidden" name="_token" value="{{ csrf_token('test_placement_' ~ assessment.id.toRfc4122) }}">
                                            <input type="hidden" name="note" value="{{ reason_placement_create }}">
                                            <label>Katalog konusu
                                                <select name="catalog_topic_id" id="placement-topic" required>
                                                    <option value="">Seçin</option>
                                                    {% for t in bindable_topics %}
                                                        <option value="{{ t.id.toRfc4122 }}" data-next-position="{{ suggested_positions[t.id.toRfc4122]|default(0) }}">{{ t.unit.subject.name }} / {{ t.unit.name }} / {{ t.name }}</option>
                                                    {% endfor %}
                                                </select>
                                            </label>
                                            <label>Görünen başlık
                                                <input type="text" name="display_title" required minlength="2" maxlength="200" value="{{ revision.title }}">
                                            </label>
                                            <p class="admin-test-detail__hint">Kısa adres başlıktan otomatik üretilir.</p>
                                            <label>Özet
                                                <textarea name="summary" maxlength="3000" rows="3" class="revision-text"></textarea>
                                            </label>
                                            <label>Sıra
                                                <input type="number" name="position" id="placement-position" required value="0" min="0" step="1">
                                            </label>
                                            <label>İşlem notu (opsiyonel)
                                                <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                                            </label>
                                            <button type="submit" class="btn admin-test-primary">Taslak yerleşim oluştur</button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </details>
                    {% endif %}
                </section>
            </div>
        </div>
    </div>
{% endblock %}
