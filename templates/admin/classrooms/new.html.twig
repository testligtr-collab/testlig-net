{% extends 'admin/layout.html.twig' %}

{% block title %}Yeni sınıf — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_classrooms') }}">Sınıflar</a>
        <span aria-hidden="true">/</span>
        <span>Yeni</span>
    </nav>
{% endblock %}

{% block panel_content %}
    <div class="admin-user-page admin-classroom-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Yeni sınıf</h1>
                <p>Sınıfı mevcut bir kurumun akademik yılına bağlayın. Sınıf adı ile müfredat sınıf düzeyi ayrıdır.</p>
            </div>
            <a class="btn btn--ghost admin-institution-back" href="{{ path('app_admin_classrooms') }}"><span aria-hidden="true">← </span>Listeye dön</a>
        </header>

        {{ form_start(form, { attr: { class: 'admin-institution-create', novalidate: 'novalidate' } }) }}
            <div class="admin-institution-create__main">
                <section class="admin-institution-card" aria-labelledby="classroom-create-identity">
                    <h2 id="classroom-create-identity"><span class="admin-institution-heading-icon admin-institution-heading-icon--blue" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'classrooms' } only %}</span> Sınıf bilgileri</h2>
                    <div class="admin-institution-field">
                        {{ form_label(form.institutionId) }}
                        {{ form_widget(form.institutionId) }}
                        {{ form_errors(form.institutionId) }}
                    </div>
                    <div class="admin-institution-field">
                        {{ form_label(form.academicYearId) }}
                        {{ form_widget(form.academicYearId) }}
                        {{ form_errors(form.academicYearId) }}
                    </div>
                    <div class="admin-institution-field">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name, { attr: { placeholder: 'Sınıf adı' } }) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div class="admin-institution-field">
                        {{ form_label(form.gradeLevel) }}
                        {{ form_widget(form.gradeLevel) }}
                        {{ form_errors(form.gradeLevel) }}
                    </div>
                    <div class="admin-institution-field">
                        {{ form_label(form.sectionCode) }}
                        {{ form_widget(form.sectionCode, { attr: { placeholder: 'İsteğe bağlı', maxlength: '32' } }) }}
                        {{ form_errors(form.sectionCode) }}
                    </div>
                    <div class="admin-institution-field">
                        {{ form_label(form.capacity) }}
                        {{ form_widget(form.capacity, { attr: { inputmode: 'numeric', placeholder: 'İsteğe bağlı' } }) }}
                        {{ form_errors(form.capacity) }}
                    </div>
                </section>
                <section class="admin-institution-card" aria-labelledby="classroom-create-reason">
                    <h2 id="classroom-create-reason"><span class="admin-institution-heading-icon admin-institution-heading-icon--teal" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'learning_contents' } only %}</span> İşlem gerekçesi</h2>
                    <div class="admin-institution-field">
                        {{ form_label(form.reasonCode, 'Gerekçe') }}
                        {{ form_widget(form.reasonCode) }}
                        {{ form_errors(form.reasonCode) }}
                    </div>
                    <div class="admin-institution-field">
                        {{ form_widget(form.confirm) }}
                        {{ form_label(form.confirm) }}
                        {{ form_errors(form.confirm) }}
                    </div>
                    <div class="admin-institution-actions">
                        <button class="btn admin-institution-primary" type="submit">Sınıfı oluştur</button>
                        <a class="btn btn--ghost" href="{{ path('app_admin_classrooms') }}">İptal</a>
                    </div>
                </section>
            </div>
            <aside class="admin-institution-card admin-institution-aside" aria-labelledby="classroom-create-summary">
                <h2 id="classroom-create-summary">İşlem özeti</h2>
                <ol>
                    <li><span class="admin-institution-heading-icon admin-institution-heading-icon--blue" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'classrooms' } only %}</span><span><strong>Aktif olarak oluşur</strong> Yeni sınıf taslak bırakılmaz. Arşiv ayrı onay ister.</span></li>
                    <li><span class="admin-institution-heading-icon admin-institution-heading-icon--violet" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}</span><span><strong>Kurum ve yıl sabit kalır</strong> Kayıtlı sınıfın kurumu ve akademik yılı bu ekrandan değiştirilemez.</span></li>
                    <li><span class="admin-institution-heading-icon admin-institution-heading-icon--teal" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'users' } only %}</span><span><strong>Erişim vermez</strong> Oluşturma üyelik, rol, öğretmen ataması veya öğrenci kaydı oluşturmaz.</span></li>
                </ol>
                <p class="admin-institution-note">Yeni sınıf aktif oluşur. Kapalı akademik yıla sınıf eklenemez. Sınıf adı, müfredattaki sınıf düzeyi değildir.</p>
            </aside>
        {{ form_end(form) }}
    </div>
{% endblock %}
