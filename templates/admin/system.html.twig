{% extends 'admin/layout.html.twig' %}

{% block title %}Sistem durumu — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <span>Sistem</span>
    </nav>
    <h1 class="panel-greeting">Sistem durumu</h1>

    <dl class="admin-health-list">
        <div><dt>Uygulama</dt><dd>{{ system.applicationStatus }}</dd></div>
        <div><dt>Veritabanı</dt><dd>{{ system.databaseStatus }}</dd></div>
        <div><dt>Redis</dt><dd>{{ system.redisStatus }}</dd></div>
        <div><dt>Migrasyon</dt><dd>{{ system.migrationStatus }}</dd></div>
    </dl>

    <p class="muted">{{ system.utcNote }}</p>

    {% if system.webhookQueueSummary %}
        <section class="surface stack-md" aria-labelledby="whq-heading">
            <h2 id="whq-heading" class="u-h-sm">Webhook kuyruğu</h2>
            <ul class="list-plain">
                <li>Zamanı gelen: {{ system.webhookQueueSummary.due }}</li>
                <li>Yeniden denenecek: {{ system.webhookQueueSummary.retry_pending }}</li>
                <li>İşleniyor: {{ system.webhookQueueSummary.processing }}</li>
                <li>Süresi geçmiş işlem: {{ system.webhookQueueSummary.stale_lease }}</li>
                <li>Teslim edilemeyen: {{ system.webhookQueueSummary.dead_letter }}</li>
            </ul>
        </section>
    {% endif %}
{% endblock %}
