{% extends 'admin/layout.html.twig' %}

{% block title %}Genel Bakış — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <span>Yönetim</span>
        <span aria-hidden="true">/</span>
        <span>Genel Bakış</span>
    </nav>
{% endblock %}

{% block panel_content %}
    {% set published = overview.published_contents|default(0) %}
    {% set review = workspace ? workspace.reviewContents : 0 %}
    {% set draft = workspace ? workspace.draftContents : 0 %}
    {% set content_total = published + review + draft %}
    {% set published_share = content_total > 0 ? ((published * 100) / content_total)|round(0, 'floor') : 0 %}
    {% set review_share = content_total > 0 ? ((review * 100) / content_total)|round(0, 'floor') : 0 %}
    {% set draft_share = content_total > 0 ? (100 - published_share - review_share) : 0 %}
    {% set section_blurbs = {
        people: 'Kullanıcılar, başvurular ve roller.',
        campus: 'Kurumlar, kampüsler, yıllar ve sınıflar.',
        learning: 'Müfredat, içerik, soru ve testler.',
        media: 'Depolama, doküman ve video.',
        interactive: 'Simülasyon, oyun ve canlı ders.',
        communication: 'Mesaj, bildirim ve destek.',
        site: 'Haber, sayfa ve site ayarları.',
        commerce: 'Paket, sipariş ve ödeme işlemleri.',
        integrations: 'SMS, yapay zeka ve dış bağlantılar.',
        system: 'Sistem durumu, denetim ve operasyon.'
    } %}
    {% set section_icons = {
        people: 'users',
        campus: 'institutions',
        learning: 'catalog',
        media: 'learning_contents',
        interactive: 'questions',
        communication: 'account',
        site: 'default',
        commerce: 'payments',
        integrations: 'webhooks',
        system: 'system'
    } %}

    <header class="admin-hello-row">
        <div>
            <h1 class="panel-greeting admin-hello">Genel Bakış</h1>
            <p class="admin-hello__lead">İzinli bölümler, kayıt sayıları ve hızlı işlemler.</p>
        </div>
        {% if (workspace and (workspace.canCreateContent or workspace.canCreateQuestion or workspace.canCreateTest)) or overview.can_create_news or overview.can_create_institution %}
            <div class="admin-quick">
                {% if workspace and workspace.canCreateContent %}
                    <a class="btn btn--primary" href="{{ path('app_admin_learning_content_new') }}">Yeni içerik</a>
                {% endif %}
                {% if overview.can_create_news %}
                    <a class="btn admin-btn-accent" href="{{ path('app_admin_news_new') }}">Haber oluştur</a>
                {% endif %}
                {% if workspace and workspace.canCreateQuestion %}
                    <a class="btn admin-btn-outline" href="{{ path('app_admin_question_new') }}">Yeni soru</a>
                {% endif %}
                {% if workspace and workspace.canCreateTest %}
                    <a class="btn admin-btn-outline" href="{{ path('app_admin_test_new') }}">Yeni test</a>
                {% endif %}
                {% if overview.can_create_institution %}
                    <a class="btn admin-btn-outline" href="{{ path('app_admin_institution_new') }}">Yeni kurum</a>
                {% endif %}
            </div>
        {% endif %}
    </header>

    {% if shell_metrics is defined and shell_metrics is not empty %}
        <section class="admin-section" aria-labelledby="metrics-heading">
            <h2 id="metrics-heading">Kayıt sayıları</h2>
            <div class="admin-metric-grid" aria-label="Yetkili kayıt sayıları">
                {% for card in shell_metrics %}
                    {% if card.href %}
                        <a class="admin-metric admin-metric--link admin-metric--{{ card.tone }}" href="{{ card.href }}">
                            <span class="admin-metric__icon">{% include 'components/admin_icon.html.twig' with { icon: card.icon|default('default') } only %}</span>
                            <span class="admin-metric__label">{{ card.label }}</span>
                            <span class="admin-metric__value">{{ card.value }}</span>
                        </a>
                    {% else %}
                        <div class="admin-metric admin-metric--{{ card.tone }}">
                            <span class="admin-metric__icon">{% include 'components/admin_icon.html.twig' with { icon: card.icon|default('default') } only %}</span>
                            <span class="admin-metric__label">{{ card.label }}</span>
                            <span class="admin-metric__value">{{ card.value }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if nav_sections|default([]) is not empty %}
        <section class="admin-section" id="admin-nav-shortcuts" aria-labelledby="nav-shortcuts-heading">
            <h2 id="nav-shortcuts-heading">Yönetim bölümleri</h2>
            <div class="admin-directory">
                {% for section in nav_sections %}
                    {% if section.id != 'overview' %}
                        {% set ready_items = section['items']|filter(item => item.stage != 'planned') %}
                        {% set planned_items = section['items']|filter(item => item.stage == 'planned') %}
                        <article class="admin-directory-card" aria-labelledby="nav-shortcut-{{ section.id }}">
                            <div class="admin-directory-card__head">
                                <span class="admin-directory-card__icon admin-directory-card__icon--{{ section.id }}">
                                    {% include 'components/admin_icon.html.twig' with { icon: section_icons[section.id]|default('default') } only %}
                                </span>
                                <div>
                                    <h3 id="nav-shortcut-{{ section.id }}">{{ section.label }}</h3>
                                    <p>{{ section_blurbs[section.id]|default('İzinli yönetim bağlantıları.') }}</p>
                                </div>
                            </div>
                            {% if ready_items is not empty %}
                                <p class="admin-stage-label">Çalışıyor</p>
                                <ul>
                                    {% for item in ready_items %}
                                        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            {% if planned_items is not empty %}
                                <p class="admin-stage-label">Geliştirme aşamasında</p>
                                <ul>
                                    {% for item in planned_items %}
                                        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </article>
                    {% endif %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="admin-panel-card admin-content-summary" aria-labelledby="content-status-heading">
        <h2 id="content-status-heading">İçerik özeti</h2>
        {% if content_total > 0 %}
            <div
                class="admin-mix"
                role="img"
                aria-label="İçerik durumu: yayımlanmış {{ published }}, incelemede {{ review }}, taslak {{ draft }}"
            >
                <svg class="admin-mix__bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <rect x="0" y="0" width="{{ published_share }}" height="8" class="admin-mix__seg admin-mix__seg--published"></rect>
                    <rect x="{{ published_share }}" y="0" width="{{ review_share }}" height="8" class="admin-mix__seg admin-mix__seg--review"></rect>
                    <rect x="{{ published_share + review_share }}" y="0" width="{{ draft_share }}" height="8" class="admin-mix__seg admin-mix__seg--draft"></rect>
                </svg>
            </div>
        {% else %}
            <p class="muted u-m0">Henüz kayıtlı içerik yok.</p>
        {% endif %}
        <ul class="admin-mix__legend">
            <li><span class="admin-mix__swatch admin-mix__swatch--published" aria-hidden="true"></span> Yayımlanmış içerik <strong>{{ published }}</strong></li>
            <li><span class="admin-mix__swatch admin-mix__swatch--review" aria-hidden="true"></span> İncelemede <strong>{{ review }}</strong></li>
            <li><span class="admin-mix__swatch admin-mix__swatch--draft" aria-hidden="true"></span> Taslak <strong>{{ draft }}</strong></li>
        </ul>
    </section>
{% endblock %}
