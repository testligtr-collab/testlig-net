{% set ready_items = section['items']|filter(item => item.stage != 'planned') %}
{% set planned_items = section['items']|filter(item => item.stage == 'planned') %}
<article class="admin-directory-card{% if section.id == 'media' %} admin-directory-card--media{% endif %}" aria-labelledby="nav-shortcut-{{ section.id }}">
    <details class="admin-section-links">
        <summary class="admin-directory-card__head">
            <span class="admin-directory-card__icon admin-directory-card__icon--{{ section.id }}">{% include 'components/admin_icon.html.twig' with {icon: section_icons[section.id]|default('default')} only %}</span>
            <span class="admin-directory-card__copy">
                <span class="admin-directory-card__title" id="nav-shortcut-{{ section.id }}">{{ section.label }}</span>
                <span class="admin-directory-card__blurb">{{ section_blurbs[section.id]|default('İzinli yönetim bağlantıları.') }}</span>
            </span>
            <span class="admin-section-stage admin-section-stage--{{ ready_items is empty ? 'planned' : (planned_items is empty ? 'ready' : 'partial') }}">{{ ready_items is empty ? 'Geliştiriliyor' : (planned_items is empty ? 'Kullanılabilir' : 'Kısmen hazır') }}</span>
            <span class="admin-section-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="admin-section-links__body">
            {% if section.id == 'media' %}
                {% include 'admin/_overview_media_links.html.twig' with { items: section['items'] } only %}
            {% else %}
            {% if ready_items is not empty %}
                <p class="admin-stage-label">Çalışıyor</p>
                <ul>{% for item in ready_items %}<li><a href="{{ item.href }}">{{ item.label }}</a></li>{% endfor %}</ul>
            {% endif %}
            {% if planned_items is not empty %}
                <p class="admin-stage-label">Geliştirme aşamasında</p>
                <ul>{% for item in planned_items %}<li><a href="{{ item.href }}">{{ item.label }}</a></li>{% endfor %}</ul>
            {% endif %}
            {% endif %}
        </div>
    </details>
</article>
