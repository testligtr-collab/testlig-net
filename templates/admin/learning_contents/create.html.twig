{% extends 'admin/layout.html.twig' %}

{% block title %}Yeni içerik — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_contents') }}">Öğrenme İçerikleri</a>
        <span aria-hidden="true">/</span>
        <span>Yeni içerik</span>
    </nav>
{% endblock %}

{% block panel_content %}
    <div class="admin-user-page admin-learning-content-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Yeni içerik</h1>
                <p>Platform kapsamında taslak oluşur. Gövde boş bir paragraftır. Kazanım, erişim politikası ve katalog yerleşimi bundan sonra ayrı adımlardır.</p>
            </div>
            {% if can_create_subject %}
                <a class="btn btn--ghost" href="{{ path('app_admin_learning_content_subject_new') }}">Konu alanı ekle</a>
            {% endif %}
        </header>

        {{ form_start(form, { attr: { class: 'admin-learning-content-create' } }) }}
            <fieldset class="admin-section">
                <legend>Temel bilgiler</legend>
                {{ form_row(form.code) }}
                {{ form_row(form.title) }}
                {{ form_row(form.summary) }}
                {{ form_row(form.contentType) }}
            </fieldset>
            <fieldset class="admin-section">
                <legend>Ders ve sınıf</legend>
                {{ form_row(form.gradeLevel) }}
                {{ form_row(form.subjectId) }}
            </fieldset>
            <fieldset class="admin-section">
                <legend>Kazanım</legend>
                {{ form_row(form.learningOutcomeId) }}
                <p class="muted">Seçilen kazanım bu taslağın ilk sürümüne birincil bağlantı olarak yazılır. Yayını açmaz.</p>
            </fieldset>
            <div class="admin-learning-content-head__actions">
                <button type="submit" class="btn admin-institution-primary">Taslak oluştur</button>
                <a class="btn btn--ghost" href="{{ path('app_admin_learning_contents') }}">İptal</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
