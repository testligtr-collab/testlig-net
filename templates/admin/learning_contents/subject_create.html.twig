{% extends 'admin/layout.html.twig' %}

{% block title %}Yeni konu alanı — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_contents') }}">Öğrenme İçerikleri</a>
        <span aria-hidden="true">/</span>
        <span>Konu alanı</span>
    </nav>
    <div class="admin-user-page admin-learning-content-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Yeni canonical konu alanı</h1>
                <p>Yalnız Süper Yönetici. Bu form bir öğrenme içeriği oluşturmaz.</p>
            </div>
        </header>

        {{ form_start(form, { attr: { class: 'admin-learning-content-create' } }) }}
            <fieldset class="admin-section">
                <legend>Konu alanı</legend>
                {{ form_row(form.code) }}
                {{ form_row(form.name) }}
            </fieldset>
            <div class="admin-learning-content-head__actions">
                <button type="submit" class="btn admin-institution-primary">Oluştur</button>
                <a class="btn btn--ghost" href="{{ path('app_admin_learning_contents') }}">İptal</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
