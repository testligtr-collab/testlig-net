{% extends 'admin/layout.html.twig' %}

{% block title %}Yeni konu alanı — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_contents') }}">Öğrenme İçerikleri</a>
        <span aria-hidden="true">/</span>
        <span>Konu alanı</span>
    </nav>
    <div class="admin-user-page admin-learning-content-page">
        {{ form_start(form, { attr: { class: 'admin-learning-content-create admin-learning-content-subject' } }) }}
            <section class="admin-section" aria-labelledby="subject-create-heading">
                <div class="admin-learning-content-subject__head">
                    <h1 id="subject-create-heading" class="panel-greeting admin-learning-content-cardhead">
                        <span class="admin-institution-heading-icon admin-institution-heading-icon--teal" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span>
                        Yeni konu alanı
                    </h1>
                    <p class="admin-learning-content-subject__badge"><span class="admin-status admin-status--neutral"><span class="admin-status__dot" aria-hidden="true"></span>Yalnız Süper Yönetici</span></p>
                </div>
                <p class="muted">İçerikleri ilişkilendirmek için bir konu alanı ekleyin.</p>
                {{ form_row(form.name) }}
                {{ form_row(form.code) }}
                <p class="admin-learning-content-note">Bu işlem öğrenme içeriği oluşturmaz.</p>
                <div class="admin-learning-content-form-actions">
                    <a class="btn btn--ghost" href="{{ path('app_admin_learning_contents') }}">İptal</a>
                    <button type="submit" class="btn admin-institution-primary">Konu alanını oluştur</button>
                </div>
            </section>
        {{ form_end(form) }}
    </div>
{% endblock %}
