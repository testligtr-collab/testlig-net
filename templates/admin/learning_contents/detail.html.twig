{% extends 'admin/layout.html.twig' %}

{% block title %}{{ content.title }} — Öğrenme İçerikleri — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_contents') }}">Öğrenme İçerikleri</a>
        <span aria-hidden="true">/</span>
        <span>{{ content.title }}</span>
    </nav>
    {% set status_variant = {
        draft: 'neutral',
        in_review: 'warning',
        published: 'success',
        archived: 'neutral'
    } %}
    {% set variant = status_variant[content.status.value]|default('') %}
    {% set shown_alignment = alignments|filter(alignment => alignment.primary)|first|default(alignments|first|default(null)) %}
    {% set published_placements = placements|filter(placement => placement.visibilityStatus.value == 'published') %}
    {% set draft_placements = placements|filter(placement => placement.visibilityStatus.value == 'draft') %}
    {% set open_steps = workflow.steps|filter(step => not step.done) %}
    {% if content.status.value == 'published' %}
        {% set publish_hint = 'Yayın öğrenci erişimini açmaz.' %}
    {% elseif content.status.value == 'draft' %}
        {% set publish_hint = 'Taslak öğrencide görünmez.' %}
    {% elseif content.status.value == 'in_review' %}
        {% set publish_hint = 'İnceleme öğrencide görünmez.' %}
    {% else %}
        {% set publish_hint = 'Arşiv öğrencide görünmez.' %}
    {% endif %}
    {% if policy is null %}
        {% set access_label = 'Yapılandırılmamış' %}
        {% set access_hint = 'Politika yokken öğrenci gövdesi kapalıdır.' %}
        {% set access_variant = 'warning' %}
    {% elseif policy.accessClass.value == 'free' %}
        {% set access_label = 'Ücretsiz' %}
        {% set access_hint = 'Politika açık onayla ücretsiz. Yayın bunu kendiliğinden vermez.' %}
        {% set access_variant = 'success' %}
    {% else %}
        {% set access_label = policy.accessClass.value|workflow_label('access') %}
        {% set access_hint = 'Öğrenci gövdesi bu politikayla yetki gerektirir.' %}
        {% set access_variant = 'limited' %}
    {% endif %}
    {% if published_placements is not empty %}
        {% set catalog_label = 'Yerleştirilmiş' %}
        {% set catalog_hint = 'Yayımlı katalog yerleşimi var. Yerleşim yayını içeriğin yayını değildir.' %}
        {% set catalog_variant = 'success' %}
    {% elseif draft_placements is not empty %}
        {% set catalog_label = 'Taslak' %}
        {% set catalog_hint = 'Taslak yerleşim öğrencide görünmez.' %}
        {% set catalog_variant = 'warning' %}
    {% else %}
        {% set catalog_label = 'Yok' %}
        {% set catalog_hint = 'Katalog yerleşimi yok.' %}
        {% set catalog_variant = 'neutral' %}
    {% endif %}
    <div class="admin-user-page admin-learning-content-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">{{ content.title }}</h1>
                <dl class="admin-learning-content-statusline">
                    <dt class="visually-hidden">Durum</dt>
                    <dd><span class="admin-status{{ variant ? ' admin-status--' ~ variant : '' }}"><span class="admin-status__dot" aria-hidden="true"></span>{{ content.status.value|workflow_label('status') }}</span></dd>
                    {% if content.currentRevision %}
                        <dt class="visually-hidden">Sürüm</dt>
                        <dd>Sürüm #{{ content.currentRevision.revisionNumber }}{% if content.currentRevision.sealed %} · Mühürlü{% else %} · Taslak{% endif %}</dd>
                        {% if content.publishedRevisionNumber and content.publishedRevisionNumber != content.currentRevision.revisionNumber %}
                            <dt class="visually-hidden">Yayımlı sürüm</dt>
                            <dd>Yayın #{{ content.publishedRevisionNumber }}</dd>
                        {% endif %}
                    {% else %}
                        <dt class="visually-hidden">Sürüm</dt>
                        <dd>Sürüm yok</dd>
                    {% endif %}
                </dl>
            </div>
            <div class="admin-learning-content-head__actions">
                {% if can_manage %}
                    <a class="btn admin-institution-primary" href="{{ path('app_admin_learning_content_revision', {id: content.id.toRfc4122}) }}">Sürümü düzenle</a>
                    <a class="btn btn--ghost" href="{{ path('app_admin_learning_content_revision_preview', {id: content.id.toRfc4122}) }}">Önizleme</a>
                {% elseif is_granted('ADMIN_LEARNING_CONTENT_VIEW') %}
                    <a class="btn btn--ghost" href="{{ path('app_admin_learning_content_revision_preview', {id: content.id.toRfc4122}) }}">Önizleme</a>
                {% endif %}
            </div>
        </header>

        <div class="admin-learning-content-stage">
            <div class="admin-learning-content-main">
                <section class="admin-section admin-learning-content-preview" aria-labelledby="preview-heading">
                    <h2 id="preview-heading" class="admin-learning-content-cardhead">
                        <span class="admin-institution-heading-icon admin-institution-heading-icon--blue" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'learning_contents' } only %}</span>
                        İçerik önizlemesi
                    </h2>
                    <div class="admin-learning-content-preview__body">
                        {% include 'admin/learning_contents/_preview_blocks.html.twig' with { preview_blocks: preview_blocks, content: content } only %}
                    </div>
                </section>

                <section class="admin-learning-content-next" aria-labelledby="workflow-heading">
                    <h2 id="workflow-heading">{{ workflow.next.label }}</h2>
                    <p class="muted">{{ workflow.next.hint }}</p>
                    {% if open_steps is not empty %}
                        <ul class="admin-learning-content-gaps">
                            {% for step in open_steps %}
                                <li>{{ step.label }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if workflow.next.kind == 'edit_revision' and can_manage %}
                        <p class="admin-learning-content-form-actions">
                            <a class="btn admin-institution-primary" href="{{ path('app_admin_learning_content_revision', {id: content.id.toRfc4122}) }}">Sürümü hazırla</a>
                        </p>
                    {% elseif workflow.next.kind == 'submit_review' %}
                        <form method="post" action="{{ path('app_admin_learning_content_submit_review', {id: content.id.toRfc4122}) }}" class="stack-sm">
                            <input type="hidden" name="_token" value="{{ csrf_token('learning_content_lifecycle_' ~ content.id.toRfc4122) }}">
                            <input type="hidden" name="note" value="{{ reason_submit }}">
                            <label>İşlem notu (opsiyonel)
                                <textarea name="operator_note" maxlength="500" rows="2" class="revision-text"></textarea>
                            </label>
                            <button type="submit" class="btn admin-institution-primary">İncelemeye gönder</button>
                        </form>
                    {% elseif workflow.next.kind == 'publish' %}
                        <form method="post" action="{{ path('app_admin_learning_content_publish', {id: content.id.toRfc4122}) }}" class="stack-sm" data-controller="confirm-submit" data-action="submit->confirm-submit#submit" data-confirm-submit-message-value="İçeriği yayımlamak istediğinize emin misiniz?">
                            <input type="hidden" name="_token" value="{{ csrf_token('learning_content_lifecycle_' ~ content.id.toRfc4122) }}">
                            <input type="hidden" name="note" value="{{ reason_publish }}">
                            <label>İşlem notu (opsiyonel)
                                <textarea name="operator_note" maxlength="500" rows="2" class="revision-text"></textarea>
                            </label>
                            <button type="submit" class="btn admin-institution-primary">Yayımla</button>
                        </form>
                    {% elseif workflow.next.kind == 'set_policy' %}
                        <p class="admin-learning-content-form-actions"><a class="btn admin-institution-primary" href="#policy-heading">Erişim politikasını kaydet</a></p>
                    {% elseif workflow.next.kind == 'publish_placement' %}
                        <p class="muted">Aşağıdaki taslak yerleşimde onay kutusunu işaretleyip yayımla.</p>
                    {% endif %}
                </section>
            </div>

            <aside class="admin-learning-content-side">
                <section class="admin-section" aria-labelledby="access-heading">
                    <h2 id="access-heading" class="admin-learning-content-cardhead">
                        <span class="admin-institution-heading-icon admin-institution-heading-icon--green" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'globe' } only %}</span>
                        Yayın ve erişim
                    </h2>
                    <ul class="admin-learning-content-facts">
                        <li>
                            <span class="admin-institution-heading-icon admin-institution-heading-icon--green" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'media_play' } only %}</span>
                            <span>
                                <strong>Yayın</strong>
                                <span>{{ publish_hint }}</span>
                            </span>
                            <span class="admin-status{{ variant ? ' admin-status--' ~ variant : '' }}"><span class="admin-status__dot" aria-hidden="true"></span>{{ content.status.value|workflow_label('status') }}</span>
                        </li>
                        <li>
                            <span class="admin-institution-heading-icon admin-institution-heading-icon--blue" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'users' } only %}</span>
                            <span>
                                <strong>Erişim</strong>
                                <span>{{ access_hint }}</span>
                            </span>
                            <span class="admin-status admin-status--{{ access_variant }}"><span class="admin-status__dot" aria-hidden="true"></span>{{ access_label }}</span>
                        </li>
                        <li>
                            <span class="admin-institution-heading-icon admin-institution-heading-icon--violet" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span>
                            <span>
                                <strong>Katalog</strong>
                                <span>{{ catalog_hint }}</span>
                            </span>
                            <span class="admin-status admin-status--{{ catalog_variant }}"><span class="admin-status__dot" aria-hidden="true"></span>{{ catalog_label }}</span>
                        </li>
                    </ul>
                </section>

                <section class="admin-section" aria-labelledby="relations-heading">
                    <h2 id="relations-heading" class="admin-learning-content-cardhead">
                        <span class="admin-institution-heading-icon admin-institution-heading-icon--teal" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span>
                        Ders ve kazanım
                    </h2>
                    <p class="admin-learning-content-relation-title">{{ content.subject.name }} · {{ content.gradeLevel.value }}. sınıf</p>
                    {% if shown_alignment %}
                        <p>{{ shown_alignment.learningOutcome.description }}</p>
                    {% else %}
                        <p>Bu sürümde program veya kazanım bağlantısı yok.</p>
                    {% endif %}
                    <details class="admin-learning-content-fold">
                        <summary role="button">Bağlantıları göster</summary>
                        <div class="admin-learning-content-fold__panel">
                            {% if alignments is empty %}
                                <p>Bu sürümde program veya kazanım bağlantısı yok.</p>
                            {% else %}
                                <ul class="admin-learning-content-links">
                                    {% for alignment in alignments %}
                                        <li>
                                            <p>
                                                {% if can_view_curriculum %}
                                                    <a href="{{ path('app_admin_curriculum_show', { id: alignment.curriculumProgram.id.toRfc4122 }) }}">{{ alignment.curriculumProgram.name }}</a>
                                                {% else %}
                                                    {{ alignment.curriculumProgram.name }}
                                                {% endif %}
                                                · {{ alignment.curriculumProgram.gradeLevel.value }}. sınıf
                                                · {{ alignment.curriculumTopic.unit.title }}
                                                · {{ alignment.curriculumTopic.title }}
                                                {% if alignment.primary %}<span class="admin-status admin-status--neutral"><span class="admin-status__dot" aria-hidden="true"></span>Birincil</span>{% endif %}
                                            </p>
                                            <p>{{ alignment.learningOutcome.description }}</p>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </details>
                </section>
            </aside>
        </div>

        <details class="admin-section admin-learning-content-fold">
            <summary role="button">Sürümler ve teknik bilgiler</summary>
            <div class="admin-learning-content-fold__panel">
                <dl>
                    <div><dt>Güncel sürüm</dt><dd>{% if content.currentRevision %}#{{ content.currentRevision.revisionNumber }}{% if content.currentRevision.sealed %} · mühürlü{% else %} · taslak{% endif %}{% else %}Yok{% endif %}</dd></div>
                    <div><dt>Yayımlı sürüm</dt><dd>{% if content.publishedRevisionNumber %}#{{ content.publishedRevisionNumber }}{% else %}Yok{% endif %}</dd></div>
                    <div><dt>Tür</dt><dd>{{ content.contentType.value|workflow_label('type') }}</dd></div>
                    <div><dt>Kapsam</dt><dd>{{ content.scope.value|workflow_label('scope') }}</dd></div>
                    <div><dt>Yazar</dt><dd>{{ content.createdBy.firstName }} {{ content.createdBy.lastName }}</dd></div>
                    {% if content.summary %}
                        <div><dt>Özet</dt><dd>{{ content.summary }}</dd></div>
                    {% endif %}
                    <div><dt>Teknik kod</dt><dd><code>{{ content.code }}</code></dd></div>
                    <div><dt>Kısa ref</dt><dd><code>{{ content.id.toRfc4122|slice(0, 8) }}</code></dd></div>
                </dl>
            </div>
        </details>

        <details class="admin-section admin-learning-content-fold" {% if workflow.next.kind in ['set_policy', 'create_placement', 'publish_placement'] %}open{% endif %}>
            <summary role="button">Yönetim işlemleri</summary>
            <div class="admin-learning-content-fold__panel">
                {% if can_return_draft and content.status.value == 'in_review' %}
                    <form method="post" action="{{ path('app_admin_learning_content_return_draft', {id: content.id.toRfc4122}) }}" class="stack-sm">
                        <input type="hidden" name="_token" value="{{ csrf_token('learning_content_lifecycle_' ~ content.id.toRfc4122) }}">
                        <input type="hidden" name="note" value="{{ reason_return }}">
                        <label>İşlem notu (opsiyonel)
                            <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                        </label>
                        <button type="submit" class="btn btn--ghost">Taslağa döndür</button>
                    </form>
                {% endif %}
                {% if can_archive %}
                    <form method="post" action="{{ path('app_admin_learning_content_archive', {id: content.id.toRfc4122}) }}" class="stack-sm" data-controller="confirm-submit" data-action="submit->confirm-submit#submit" data-confirm-submit-message-value="Arşivleme geri alınamaz. Devam edilsin mi?">
                        <input type="hidden" name="_token" value="{{ csrf_token('learning_content_lifecycle_' ~ content.id.toRfc4122) }}">
                        <input type="hidden" name="note" value="{{ reason_archive }}">
                        <label>İşlem notu (opsiyonel)
                            <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                        </label>
                        <button type="submit" class="btn btn--ghost">Arşivle</button>
                    </form>
                {% endif %}

                {% if can_set_policy %}
                    <h3 id="policy-heading">Erişim politikası</h3>
                    <p class="muted">Varsayılan kapalı kalır. Ücretsiz yalnız açık onay ile işaretlenir. İçeriğin yayında olması bu politikayı değiştirmez.</p>
                    <form method="post" action="{{ path('app_admin_learning_content_policy', {id: content.id.toRfc4122}) }}" class="stack-sm">
                        <input type="hidden" name="_token" value="{{ csrf_token('learning_content_policy_' ~ content.id.toRfc4122) }}">
                        <label>Politika
                            <select name="access_class" id="access_class">
                                <option value="entitlement_required" {% if policy and policy.accessClass.value == 'entitlement_required' %}selected{% endif %}>Yetki gerekli</option>
                                <option value="free" {% if policy and policy.accessClass.value == 'free' %}selected{% endif %}>Ücretsiz</option>
                            </select>
                        </label>
                        <label>
                            <input type="checkbox" name="confirm_free" value="1">
                            Bu içerik ücretsiz erişime açılacak
                        </label>
                        <button type="submit" class="btn btn--primary">Politikayı kaydet</button>
                    </form>
                {% endif %}

                <h3 id="placements-heading">Katalog yerleşimleri</h3>
                <p class="muted">Yerleşim yalnızca navigasyondur. Öğrenci gövde içeriği burada gösterilmez ve program bağlantısı yerleşim oluşturmaz.</p>
                {% if placements is empty %}
                    <p>Henüz yerleşim yok.</p>
                {% else %}
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead><tr><th>Konu</th><th>Başlık</th><th>Slug</th><th>Sıra</th><th>Durum</th><th></th></tr></thead>
                            <tbody>
                                {% for p in placements %}
                                    <tr>
                                        <td>
                                            {% if is_granted('ADMIN_CATALOG_VIEW') %}
                                                <a href="{{ path('app_admin_catalog_topic', {id: p.catalogTopic.id.toRfc4122}) }}">{{ p.catalogTopic.name }}</a>
                                            {% else %}
                                                {{ p.catalogTopic.name }}
                                            {% endif %}
                                        </td>
                                        <td>{{ p.displayTitle }}</td>
                                        <td><code>{{ p.slug }}</code></td>
                                        <td>{{ p.position }}</td>
                                        <td>{{ p.visibilityStatus.value|workflow_label('status') }}</td>
                                        <td>
                                            {% if is_granted('CATALOG_TOPIC_LESSON_PUBLISH', p) and p.visibilityStatus.value == 'draft' %}
                                                <form method="post" action="{{ path('app_admin_learning_content_placement_publish', {placementId: p.id.toRfc4122}) }}" class="stack-sm u-inline-block" data-controller="confirm-submit" data-action="submit->confirm-submit#submit" data-confirm-submit-message-value="Yerleşimi yayımlamak istediğinize emin misiniz?">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('learning_content_placement_publish_' ~ p.id.toRfc4122) }}">
                                                    <input type="hidden" name="note" value="{{ reason_placement_publish }}">
                                                    <label>
                                                        <input type="checkbox" name="confirm_publish" value="1" required>
                                                        Onaylıyorum
                                                    </label>
                                                    <button type="submit" class="btn btn--primary">Yerleşimi yayımla</button>
                                                </form>
                                            {% endif %}
                                            {% if is_granted('CATALOG_TOPIC_LESSON_ARCHIVE', p) and p.visibilityStatus.value != 'archived' %}
                                                <form method="post" action="{{ path('app_admin_learning_content_placement_archive', {placementId: p.id.toRfc4122}) }}" class="u-inline" data-controller="confirm-submit" data-action="submit->confirm-submit#submit" data-confirm-submit-message-value="Arşivleme geri alınamaz. Devam?">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('learning_content_placement_archive_' ~ p.id.toRfc4122) }}">
                                                    <input type="hidden" name="note" value="{{ reason_placement_archive }}">
                                                    <button type="submit" class="btn btn--ghost">Arşivle</button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if can_create_placement %}
                    <h3 id="placement-form">Yerleşim ekle</h3>
                    {% if bindable_topics is empty %}
                        <p class="muted">Eşlenmiş katalog konusu yok. Önce müfredatta canonical eşleme yapın.</p>
                    {% else %}
                        <form method="post" action="{{ path('app_admin_learning_content_placement_create', {id: content.id.toRfc4122}) }}" class="stack-sm" id="placement-create-form" data-controller="placement-defaults">
                            <input type="hidden" name="_token" value="{{ csrf_token('learning_content_placement_' ~ content.id.toRfc4122) }}">
                            <input type="hidden" name="note" value="{{ reason_placement_create }}">
                            <label>Katalog konusu
                                <select name="catalog_topic_id" id="placement-topic" required>
                                    <option value="">Seçin</option>
                                    {% for t in bindable_topics %}
                                        <option value="{{ t.id.toRfc4122 }}" data-next-position="{{ suggested_positions[t.id.toRfc4122]|default(0) }}">{{ t.unit.subject.name }} / {{ t.unit.name }} / {{ t.name }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label>Görünen başlık
                                <input type="text" name="display_title" required minlength="2" maxlength="200" value="{{ content.title }}">
                            </label>
                            <p class="muted">Kısa adres başlıktan otomatik üretilir.</p>
                            <label>Özet
                                <textarea name="summary" maxlength="3000" rows="3" class="revision-text">{{ content.summary }}</textarea>
                            </label>
                            <label>Sıra
                                <input type="number" name="position" id="placement-position" required value="0" min="0" step="1">
                            </label>
                            <label>İşlem notu (opsiyonel)
                                <textarea name="operator_note" maxlength="500" rows="2"></textarea>
                            </label>
                            <button type="submit" class="btn btn--primary">Taslak yerleşim oluştur</button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </details>
    </div>
{% endblock %}
