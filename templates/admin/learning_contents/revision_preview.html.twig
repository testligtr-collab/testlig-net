{% extends 'admin/layout.html.twig' %}

{% block title %}Önizleme — {{ content.title }} — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_contents') }}">Öğrenme İçerikleri</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_content', {id: content.id.toRfc4122}) }}">{{ content.title }}</a>
        <span aria-hidden="true">/</span>
        <span>Önizleme</span>
    </nav>
    <div class="admin-user-page admin-learning-content-page">
    <header class="admin-user-head">
        <div>
            <h1 class="panel-greeting">{{ content.title }}</h1>
            <p>Yönetici önizleme. Öğrenci yüzü değildir. Metin otomatik kaçış ile gösterilir; ham HTML ve JSON yoktur.</p>
        </div>
        {% if can_manage %}
            <a class="btn btn--ghost" href="{{ path('app_admin_learning_content_revision', {id: content.id.toRfc4122}) }}">Düzenle</a>
        {% endif %}
    </header>

    <article class="admin-section admin-learning-content-preview" aria-label="Sürüm gövdesi">
        {% include 'admin/learning_contents/_preview_blocks.html.twig' with { preview_blocks: preview_blocks, content: content } only %}
    </article>
    </div>
{% endblock %}
