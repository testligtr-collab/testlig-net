{% extends 'admin/layout.html.twig' %}

{% block title %}Sürüm düzenle — {{ content.title }} — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_dashboard') }}">Yönetim</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_contents') }}">İçerikler</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_learning_content', {id: content.id.toRfc4122}) }}">{{ content.title }}</a>
        <span aria-hidden="true">/</span>
        <span>Sürüm</span>
    </nav>
    <div class="admin-page-header">
        <h1 class="panel-greeting">Sürüm düzenleyici</h1>
        <a class="btn btn--ghost" href="{{ path('app_admin_learning_content_revision_preview', {id: content.id.toRfc4122}) }}">Önizleme</a>
    </div>

    <dl class="account-dl">
        <dt>İçerik</dt><dd>{{ content.title }} · <code>{{ content.code }}</code></dd>
        <dt>Sürüm</dt><dd>#{{ revision.revisionNumber }}{% if revision.sealed %} · mühürlü{% else %} · taslak{% endif %}</dd>
    </dl>

    {% if revision.sealed %}
        <section class="admin-section" aria-labelledby="clone-heading">
            <h2 id="clone-heading">Mühürlü sürüm</h2>
            <p class="muted">Bu sürüm değiştirilemez. Düzenlemek için yeni bir taslak sürüm klonlayın.</p>
            <form method="post" action="{{ path('app_admin_learning_content_revision_clone', {id: content.id.toRfc4122}) }}" class="stack-sm">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <button type="submit" class="btn btn--primary">Yeni sürüm klonla</button>
            </form>
        </section>

        <section class="admin-section" aria-labelledby="readonly-heading">
            <h2 id="readonly-heading">Bloklar (salt okunur)</h2>
            <ol class="stack-sm">
                {% for block in editor_blocks %}
                    <li>
                        <strong>{{ block.type_label }}</strong>
                        {% if block.type == 'heading' %}
                            <p>H{{ block.level }}: {{ block.text }}</p>
                        {% elseif block.type == 'list' %}
                            <pre>{{ block.items_text }}</pre>
                        {% elseif block.type == 'math' %}
                            <code>{{ block.latex }}</code>
                        {% elseif block.type == 'callout' %}
                            <p>[{{ block.variant }}] {{ block.callout_text }}</p>
                        {% else %}
                            <p>{{ block.text }}</p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>
    {% else %}
        <section class="admin-section" aria-labelledby="blocks-heading">
            <h2 id="blocks-heading">Bloklar</h2>
            <p class="muted">JSON/HTML yok. Düz metin alanları; kaydetmeden önce önizleyin.</p>

            <form method="post" action="{{ path('app_admin_learning_content_revision_save', {id: content.id.toRfc4122}) }}" class="stack-sm" id="revision-save-form">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <input type="hidden" name="expected_revision_id" value="{{ revision.id.toRfc4122 }}">
                <input type="hidden" name="expected_content_hash" value="{{ revision.contentHash }}">

                {% for block in editor_blocks %}
                    <fieldset class="admin-section">
                        <legend>{{ loop.index }}. {{ block.type_label }}</legend>
                        <input type="hidden" name="blocks[{{ loop.index0 }}][type]" value="{{ block.type }}">

                        {% if block.type == 'heading' %}
                            <label>Seviye
                                <select name="blocks[{{ loop.index0 }}][level]">
                                    {% for level in 1..3 %}
                                        <option value="{{ level }}" {% if block.level == level %}selected{% endif %}>H{{ level }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label>Metin
                                <input type="text" name="blocks[{{ loop.index0 }}][text]" value="{{ block.text }}" required>
                            </label>
                        {% elseif block.type == 'paragraph' or block.type == 'quote' %}
                            <label>Metin
                                <textarea name="blocks[{{ loop.index0 }}][text]" rows="3" required>{{ block.text }}</textarea>
                            </label>
                        {% elseif block.type == 'list' %}
                            <label>Maddeler (satır başına bir)
                                <textarea name="blocks[{{ loop.index0 }}][items]" rows="4" required>{{ block.items_text }}</textarea>
                            </label>
                        {% elseif block.type == 'math' %}
                            <label>LaTeX
                                <input type="text" name="blocks[{{ loop.index0 }}][latex]" value="{{ block.latex }}" required>
                            </label>
                        {% elseif block.type == 'callout' %}
                            <label>Tür
                                <select name="blocks[{{ loop.index0 }}][variant]">
                                    {% for variant in ['info', 'warning', 'tip', 'note'] %}
                                        <option value="{{ variant }}" {% if block.variant == variant %}selected{% endif %}>{{ variant }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label>Metin
                                <textarea name="blocks[{{ loop.index0 }}][callout_text]" rows="3" required>{{ block.callout_text }}</textarea>
                            </label>
                        {% endif %}
                    </fieldset>
                {% endfor %}

                <button type="submit" class="btn btn--primary">Kaydet</button>
            </form>

            <div class="stack-sm" style="margin-top: 1rem;">
                {% for block in editor_blocks %}
                    <div class="admin-actions">
                        <span class="muted">Blok {{ loop.index }}:</span>
                        {% if not loop.first %}
                            <form method="post" action="{{ path('app_admin_learning_content_revision_move_block', {id: content.id.toRfc4122}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                                <input type="hidden" name="expected_revision_id" value="{{ revision.id.toRfc4122 }}">
                                <input type="hidden" name="expected_content_hash" value="{{ revision.contentHash }}">
                                <input type="hidden" name="index" value="{{ loop.index0 }}">
                                <input type="hidden" name="direction" value="up">
                                <button type="submit" class="btn btn--ghost">Yukarı</button>
                            </form>
                        {% endif %}
                        {% if not loop.last %}
                            <form method="post" action="{{ path('app_admin_learning_content_revision_move_block', {id: content.id.toRfc4122}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                                <input type="hidden" name="expected_revision_id" value="{{ revision.id.toRfc4122 }}">
                                <input type="hidden" name="expected_content_hash" value="{{ revision.contentHash }}">
                                <input type="hidden" name="index" value="{{ loop.index0 }}">
                                <input type="hidden" name="direction" value="down">
                                <button type="submit" class="btn btn--ghost">Aşağı</button>
                            </form>
                        {% endif %}
                        {% if editor_blocks|length > 1 %}
                            <form method="post" action="{{ path('app_admin_learning_content_revision_remove_block', {id: content.id.toRfc4122}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                                <input type="hidden" name="expected_revision_id" value="{{ revision.id.toRfc4122 }}">
                                <input type="hidden" name="expected_content_hash" value="{{ revision.contentHash }}">
                                <input type="hidden" name="index" value="{{ loop.index0 }}">
                                <button type="submit" class="btn btn--ghost">Kaldır</button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="admin-section" aria-labelledby="add-heading">
            <h2 id="add-heading">Blok ekle</h2>
            <form method="post" action="{{ path('app_admin_learning_content_revision_add_block', {id: content.id.toRfc4122}) }}" class="stack-sm">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <input type="hidden" name="expected_revision_id" value="{{ revision.id.toRfc4122 }}">
                <input type="hidden" name="expected_content_hash" value="{{ revision.contentHash }}">
                <label>Tür
                    <select name="block_type" required>
                        {% for label, value in type_choices %}
                            <option value="{{ value }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <button type="submit" class="btn btn--primary">Blok ekle</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
