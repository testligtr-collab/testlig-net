<div class="admin-link-panel">
    {% for item in items %}
        <a class="admin-mini-link" href="{{ item.href }}">
            <span class="admin-mini-link__icon">{% include 'components/admin_icon.html.twig' with { icon: icons[item.id]|default('default') } only %}</span>
            <span class="admin-mini-link__copy">
                <span class="admin-mini-link__line">
                    <span class="admin-mini-link__title">{{ item.label }}</span>
                    <span class="admin-mini-link__stage">{{ item.stage == 'planned' ? 'Geliştirme aşamasında' : 'Çalışıyor' }}</span>
                </span>
                <span class="admin-mini-link__blurb">{{ blurbs[item.id]|default('') }}</span>
            </span>
            <span class="admin-mini-link__arrow" aria-hidden="true">›</span>
        </a>
    {% endfor %}
</div>
