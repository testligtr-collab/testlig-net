{% extends 'admin/layout.html.twig' %}

{% block title %}Kurum başvuruları — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <span>Kurum başvuruları</span>
    </nav>
{% endblock %}

{% block panel_content %}
    {% set month_labels = {
        '1': 'Oca', '2': 'Şub', '3': 'Mar', '4': 'Nis', '5': 'May', '6': 'Haz',
        '7': 'Tem', '8': 'Ağu', '9': 'Eyl', '10': 'Eki', '11': 'Kas', '12': 'Ara'
    } %}
    {% set status_labels = {
        'pending': 'Bekliyor',
        'approved': 'Onaylandı',
        'rejected': 'Reddedildi',
        'withdrawn': 'Geri çekildi',
        'superseded': 'Yerine yenisi geldi'
    } %}
    <div class="admin-user-page admin-institution-app-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Kurum başvuruları</h1>
                <p>Gönderilmiş kurum başvurularını inceleyin ve sonuçlandırın.</p>
                <p>Başvuru onayı kurum, üyelik veya rol vermez.</p>
            </div>
            {% if admin_filters_active(filters|default({})) %}
                <a class="admin-user-clear" href="{{ path('app_admin_institution_applications') }}">Filtreleri temizle</a>
            {% endif %}
        </header>

        <section class="admin-user-stats" aria-label="Başvuru özeti">
            <article class="admin-user-stat admin-user-stat--total">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Toplam</span>
                    <strong class="admin-user-stat__value" data-institution-app-summary="total">{{ summary.total }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--pending">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'clock' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Bekliyor</span>
                    <strong class="admin-user-stat__value" data-institution-app-summary="pending">{{ summary.pending }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--active">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'tests' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Onaylandı</span>
                    <strong class="admin-user-stat__value" data-institution-app-summary="approved">{{ summary.approved }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--suspended">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'ban' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Reddedildi</span>
                    <strong class="admin-user-stat__value" data-institution-app-summary="rejected">{{ summary.rejected }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--withdrawn">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'account' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Geri çekildi</span>
                    <strong class="admin-user-stat__value" data-institution-app-summary="withdrawn">{{ summary.withdrawn }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--superseded">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'default' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Yerine yenisi geldi</span>
                    <strong class="admin-user-stat__value" data-institution-app-summary="superseded">{{ summary.superseded }}</strong>
                </span>
            </article>
        </section>

        <form method="get" class="admin-filters admin-user-filters" action="{{ path('app_admin_institution_applications') }}">
            <h2>Başvuruları filtrele</h2>
            <div class="admin-user-filters__fields">
                <label class="admin-user-search" for="institution-app-filter-q">
                    <span class="sr-only">Ara</span>
                    <span class="admin-user-search__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'search' } only %}</span>
                    <input id="institution-app-filter-q" type="search" name="q" value="{{ filters.q|default('') }}" maxlength="100" autocomplete="off" placeholder="Kurum, ad veya e-posta ile ara...">
                </label>
                <label for="institution-app-filter-status">
                    <span class="sr-only">Durum</span>
                    <select id="institution-app-filter-status" name="status">
                        <option value="">Durum</option>
                        {% for code, label in status_labels %}
                            <option value="{{ code }}" {% if filters.status|default('') == code %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <div class="admin-user-filters__actions">
                    <button type="submit" class="btn admin-user-filters__submit">{% include 'components/admin_icon.html.twig' with { icon: 'filter' } only %} Filtrele</button>
                </div>
            </div>
        </form>

        <section class="admin-user-list" aria-labelledby="institution-app-list-heading">
            <header class="admin-user-list__head">
                <h2 id="institution-app-list-heading">Başvuru listesi</h2>
                <span class="admin-user-list__count">{{ result.totalCount }} başvuru</span>
            </header>
            {% if result.items is empty %}
                {% if admin_filters_active(filters|default({})) %}
                    {% include 'components/empty_state.html.twig' with {
                        title: 'Sonuç yok',
                        body: 'Filtrelere uygun başvuru bulunamadı.'
                    } %}
                {% else %}
                    {% include 'components/empty_state.html.twig' with {
                        title: 'Kayıt yok',
                        body: 'Henüz kurum başvurusu yok.'
                    } %}
                {% endif %}
            {% else %}
                <div class="admin-table-wrap">
                    <table class="admin-table admin-user-table">
                        <thead>
                            <tr>
                                <th>Kurum</th>
                                <th>Başvuran</th>
                                <th>Başvuru</th>
                                <th>Durum</th>
                                <th><span class="sr-only">İşlem</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in result.items %}
                                {% set submitted_month = row.submittedAt|utc_present('n') %}
                                <tr>
                                    <td class="admin-user-person" data-label="Kurum">
                                        <span class="admin-user-person__layout">
                                            <span class="admin-user-avatar admin-user-avatar--{{ row.avatarTone() }}" aria-hidden="true">{{ row.institutionInitial() }}</span>
                                            <span class="admin-user-person__copy">
                                                <span class="admin-user-person__name">{{ row.proposedName }}</span>
                                                <span class="admin-user-person__email">{{ include('admin/institution_applications/_type.html.twig', { type: row.proposedType.value }, false) }}</span>
                                            </span>
                                        </span>
                                    </td>
                                    <td data-label="Başvuran">
                                        <span class="admin-user-person__copy">
                                            <span class="admin-user-person__name">{{ row.displayName() }}</span>
                                            <span class="admin-user-person__email">{{ row.email }}</span>
                                        </span>
                                    </td>
                                    <td class="admin-user-date" data-label="Başvuru">
                                        <span class="admin-user-date__stack">
                                            <span>{{ row.submittedAt|utc_present('j') }} {{ month_labels[submitted_month]|default(submitted_month) }} {{ row.submittedAt|utc_present('Y') }}</span>
                                            <span>{{ row.submittedAt|utc_present('H:i') }}</span>
                                        </span>
                                    </td>
                                    <td data-label="Durum">
                                        {% include 'admin/institution_applications/_status.html.twig' with { code: row.status.value } only %}
                                    </td>
                                    <td class="admin-user-action" data-label="İşlem">
                                        <a class="admin-user-detail" href="{{ path('app_admin_institution_application', { id: row.id }) }}">İncele <span aria-hidden="true">›</span></a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {% include 'components/admin_pagination.html.twig' with {
                result: result,
                route: 'app_admin_institution_applications',
                query: {
                    q: filters.q|default(''),
                    status: filters.status|default('')
                }
            } %}
        </section>
    </div>
{% endblock %}
