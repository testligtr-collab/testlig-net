{% extends 'admin/layout.html.twig' %}

{% block title %}Kurum başvurusu — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_institution_applications') }}">Kurum başvuruları</a>
        <span aria-hidden="true">/</span>
        <span>{{ row.shortRef }}</span>
    </nav>
{% endblock %}

{% block panel_content %}
    {% set role_labels = {
        'ROLE_USER': 'Kullanıcı',
        'ROLE_STUDENT': 'Öğrenci',
        'ROLE_PARENT': 'Veli',
        'ROLE_TEACHER': 'Öğretmen',
        'ROLE_EXPERT_TEACHER': 'Uzman öğretmen',
        'ROLE_HEAD_TEACHER': 'Zümre başkanı',
        'ROLE_INSTITUTION_MANAGER': 'Kurum yöneticisi',
        'ROLE_MODERATOR': 'Moderatör',
        'ROLE_ADMIN': 'Yönetici',
        'ROLE_SUPER_ADMIN': 'Süper Yönetici'
    } %}
    {% set role_tones = {
        'ROLE_STUDENT': 'student',
        'ROLE_PARENT': 'parent',
        'ROLE_TEACHER': 'teacher',
        'ROLE_EXPERT_TEACHER': 'teacher',
        'ROLE_HEAD_TEACHER': 'teacher',
        'ROLE_INSTITUTION_MANAGER': 'admin',
        'ROLE_MODERATOR': 'moderator',
        'ROLE_ADMIN': 'admin',
        'ROLE_SUPER_ADMIN': 'admin'
    } %}
    {% set month_labels = {
        '1': 'Oca', '2': 'Şub', '3': 'Mar', '4': 'Nis', '5': 'May', '6': 'Haz',
        '7': 'Tem', '8': 'Ağu', '9': 'Eyl', '10': 'Eki', '11': 'Kas', '12': 'Ara'
    } %}
    {% set institution_status_labels = {
        'pending': 'Beklemede',
        'active': 'Aktif',
        'suspended': 'Askıda',
        'archived': 'Arşiv'
    } %}
    {% set submitted_month = row.submittedAt|utc_present('n') %}
    {% set decided_month = row.decidedAt ? row.decidedAt|utc_present('n') : null %}
    <div class="admin-user-detail-page admin-institution-app-page">
        <header class="admin-user-detail-head">
            <div>
                <h1 class="panel-greeting">Kurum başvurusu</h1>
                <p>Başvuru onayı kurum, üyelik veya rol vermez.</p>
            </div>
            <div class="admin-user-detail-head__actions">
                <a class="admin-user-detail-link" href="{{ path('app_admin_institution_applications') }}">
                    <span aria-hidden="true">←</span>
                    Listeye dön
                </a>
                {% if audit_href %}
                    <a class="admin-user-detail-link" href="{{ audit_href }}">
                        {% include 'components/admin_icon.html.twig' with { icon: 'clock' } only %}
                        İşlem geçmişi
                    </a>
                {% endif %}
            </div>
        </header>

        <section class="admin-user-detail-profile" aria-label="Başvuran">
            <div class="admin-user-detail-identity">
                <span class="admin-user-avatar admin-user-avatar--{{ row.avatarTone() }}" aria-hidden="true">{{ row.initials() }}</span>
                <div class="admin-user-detail-identity__copy">
                    <h2 class="admin-user-detail-name">{{ row.displayName() }}</h2>
                    <p class="admin-user-detail-email">{{ row.email }}</p>
                    <p class="admin-user-detail-ref">Ref {{ row.shortRef }}</p>
                    <div class="admin-user-detail-pills">
                        {% include 'admin/institution_applications/_status.html.twig' with { code: row.status.value } only %}
                        {% if row.accountStatus.value == 'suspended' %}
                            {% include 'admin/_status.html.twig' with { code: row.accountStatus.value, variant: 'danger' } only %}
                        {% else %}
                            {% include 'admin/_status.html.twig' with { code: row.accountStatus.value } only %}
                        {% endif %}
                        {% for role in row.globalRoles %}
                            <span class="admin-user-role admin-user-role--{{ role_tones[role]|default('user') }}">{{ role_labels[role]|default('Diğer / eski kayıt') }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <dl class="admin-user-detail-meta">
                <div>
                    <dt>E-posta doğrulaması</dt>
                    <dd class="admin-user-verify admin-user-verify--{{ row.emailVerified ? 'yes' : 'no' }}">
                        {% include 'components/admin_icon.html.twig' with { icon: row.emailVerified ? 'tests' : 'clock' } only %}
                        <span>{{ row.emailVerified ? 'Doğrulanmış' : 'Doğrulanmamış' }}</span>
                    </dd>
                </div>
                <div>
                    <dt>Başvuru tarihi</dt>
                    <dd class="admin-user-detail-date">{{ row.submittedAt|utc_present('j') }} {{ month_labels[submitted_month]|default(submitted_month) }} {{ row.submittedAt|utc_present('Y') }} · {{ row.submittedAt|utc_present('H:i') }}</dd>
                </div>
            </dl>
        </section>

        <section class="admin-user-detail-card" aria-labelledby="institution-app-facts-heading">
            <h2 id="institution-app-facts-heading">
                {% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}
                Başvuru kaydı
            </h2>
            <dl class="admin-institution-app-facts">
                <div>
                    <dt>Kurum adı</dt>
                    <dd class="admin-institution-app-name">{{ row.proposedName }}</dd>
                </div>
                <div>
                    <dt>Kurum türü</dt>
                    <dd>{{ include('admin/institution_applications/_type.html.twig', { type: row.proposedType.value }, false) }}</dd>
                </div>
                <div>
                    <dt>Durum</dt>
                    <dd>{% include 'admin/institution_applications/_status.html.twig' with { code: row.status.value } only %}</dd>
                </div>
                <div>
                    <dt>Karar tarihi</dt>
                    <dd>
                        {% if row.decidedAt %}
                            {{ row.decidedAt|utc_present('j') }} {{ month_labels[decided_month]|default(decided_month) }} {{ row.decidedAt|utc_present('Y') }} · {{ row.decidedAt|utc_present('H:i') }}
                        {% else %}
                            Kayıtlı karar tarihi yok
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt>Karar gerekçesi</dt>
                    <dd>
                        {% if row.decisionReasonCode %}
                            {{ reject_reasons[row.decisionReasonCode]|default(legacy_reason_label) }}
                        {% else %}
                            Kayıtlı gerekçe yok
                        {% endif %}
                    </dd>
                </div>
            </dl>
        </section>

        {% if application.createdInstitution %}
            <section class="admin-user-detail-card" aria-labelledby="institution-app-created-heading">
                <h2 id="institution-app-created-heading">
                    {% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}
                    Oluşturulan kurum
                </h2>
                <p>Bu başvurudan kurum oluşturuldu.</p>
                <dl class="admin-institution-app-facts">
                    <div>
                        <dt>Kurum</dt>
                        <dd class="admin-institution-app-name">{{ application.createdInstitution.name }}</dd>
                    </div>
                    <div>
                        <dt>Kurum durumu</dt>
                        <dd>{{ institution_status_labels[application.createdInstitution.status.value]|default(legacy_reason_label) }}</dd>
                    </div>
                </dl>
                {% if institution_href %}
                    <div class="admin-user-detail-actions">
                        <a class="admin-user-detail-link" href="{{ institution_href }}">Kurum detayına git</a>
                    </div>
                {% endif %}
            </section>
        {% elseif application.status.value == 'approved' %}
            <section class="admin-user-detail-card" aria-labelledby="institution-app-create-heading">
                <h2 id="institution-app-create-heading">
                    {% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}
                    Kurum oluştur
                </h2>
                <p>Bu işlem onay bekleyen bir kurum oluşturur ve başvuranı kurum sahibi yapar.</p>
                <form class="admin-user-detail-form" method="post" action="{{ path('app_admin_institution_application_create', { id: application.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('institution_application_create_institution') }}">
                    <label class="admin-user-detail-confirm">
                        <input type="checkbox" name="confirm" value="1">
                        <span>Kurum oluşturmayı onaylıyorum</span>
                    </label>
                    <div class="admin-user-detail-actions">
                        <button class="admin-user-detail-submit" type="submit">Kurum oluştur</button>
                    </div>
                </form>
            </section>
        {% endif %}

        {% if application.status.value == 'pending' %}
            <div class="admin-user-detail-forms">
                <section class="admin-user-detail-card" aria-labelledby="institution-app-approve-heading">
                    <h2 id="institution-app-approve-heading">
                        {% include 'components/admin_icon.html.twig' with { icon: 'tests' } only %}
                        Başvuruyu onayla
                    </h2>
                    <p>Onay yalnız bu başvurunun durumunu değiştirir.</p>
                    <form class="admin-user-detail-form" method="post" action="{{ path('app_admin_institution_application_approve', { id: application.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('institution_application_approve') }}">
                        <div class="admin-user-detail-actions">
                            <button class="admin-user-detail-submit" type="submit">Onayla</button>
                        </div>
                    </form>
                </section>
                <section class="admin-user-detail-card" aria-labelledby="institution-app-reject-heading">
                    <h2 id="institution-app-reject-heading">
                        {% include 'components/admin_icon.html.twig' with { icon: 'ban' } only %}
                        Başvuruyu reddet
                    </h2>
                    <p>Ret nedenini listeden seçin.</p>
                    <form class="admin-user-detail-form" method="post" action="{{ path('app_admin_institution_application_reject', { id: application.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('institution_application_reject') }}">
                        {% if reason_invalid %}
                            <p class="admin-user-detail-errors" role="alert">{{ reason_error }}</p>
                        {% endif %}
                        <label class="admin-user-detail-field" for="institution-application-reason">
                            <span>Ret nedeni</span>
                            <select id="institution-application-reason" name="reason_code" {% if reason_invalid %}aria-invalid="true"{% endif %}>
                                <option value="" {% if posted_reason == '' %}selected{% endif %}>Ret nedeni seçin</option>
                                {% for code, label in reject_reasons %}
                                    <option value="{{ code }}" {% if posted_reason == code %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                                {% if posted_reason != '' and posted_reason not in reject_reasons|keys %}
                                    <option value="{{ posted_reason }}" selected>{{ legacy_reason_label }}</option>
                                {% endif %}
                            </select>
                        </label>
                        <div class="admin-user-detail-actions">
                            <button class="admin-user-detail-submit admin-institution-app-reject" type="submit">Reddet</button>
                        </div>
                    </form>
                </section>
            </div>
        {% endif %}
    </div>
{% endblock %}
