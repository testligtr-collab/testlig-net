{% extends 'admin/layout.html.twig' %}

{% block title %}Müfredat kataloğu — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <span>Müfredat</span>
    </nav>
{% endblock %}

{% block panel_content %}
    <div class="admin-user-page admin-curriculum-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Müfredat kataloğu</h1>
                <p>Öğrenci, yayımlanmış dersin yayımlanmış ünitesindeki yayımlanmış konuyu görür. Bu ekran program sürümünü ve kazanımı yönetmez. Operasyonel sınıf adı, örneğin 5-A, bu katalog değildir.</p>
            </div>
            {% if can_manage %}
                <a class="btn admin-institution-primary" href="{{ path('app_admin_catalog_subject_new') }}"><span aria-hidden="true">+ </span>Yeni ders</a>
            {% endif %}
        </header>
        <p class="admin-institution-note">Program sürümü ve kazanım <a href="{{ path('app_admin_curriculum') }}">Programlar</a> ekranındadır. İki kayıt birbirinin yerine geçmez. Katalog yayını programın yayınını değiştirmez.</p>

        {% if subjects is empty %}
            {% include 'components/empty_state.html.twig' with {
                title: 'Henüz ders yok',
                body: 'İlk dersi ekleyerek öğrenci kataloğunu doldurabilirsiniz.'
            } %}
        {% else %}
            <div class="admin-table-wrap">
                <table class="admin-table admin-user-table">
                    <thead>
                        <tr>
                            <th>Sınıf</th>
                            <th>Ad</th>
                            <th>Slug</th>
                            <th>Durum</th>
                            <th>Sıra</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for s in subjects %}
                            <tr>
                                <td data-label="Sınıf">{{ s.gradeLevel.value }}. sınıf</td>
                                <td data-label="Ad">{{ s.name }}</td>
                                <td data-label="Slug"><code>{{ s.slug }}</code></td>
                                <td data-label="Durum">{{ s.status.labelTr }}</td>
                                <td data-label="Sıra">{{ s.position }}</td>
                                <td data-label="İşlem"><a class="btn btn--ghost admin-institution-detail" href="{{ path('app_admin_catalog_subject', {id: s.id.toRfc4122}) }}">Detay <span aria-hidden="true">→</span></a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
