{% extends 'admin/layout.html.twig' %}

{% block title %}{{ topic.name }} — Müfredat — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_catalog') }}">Müfredat</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_catalog_subject', {id: subject.id.toRfc4122}) }}">{{ subject.name }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_catalog_unit', {id: unit.id.toRfc4122}) }}">{{ unit.name }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ topic.name }}</span>
    </nav>
    <div class="admin-page-header">
        <h1 class="panel-greeting">{{ topic.name }}</h1>
        {% if can_manage %}
            <a class="btn btn--ghost" href="{{ path('app_admin_catalog_topic_edit', {id: topic.id.toRfc4122}) }}">Düzenle</a>
        {% endif %}
    </div>
    <dl class="account-dl">
        <dt>Durum</dt><dd>{{ topic.status.labelTr }}</dd>
        <dt>Slug</dt><dd><code>{{ topic.slug }}</code></dd>
        <dt>Sıra</dt><dd>{{ topic.position }}</dd>
        <dt>Canonical</dt>
        <dd>
            {% if subject.canonicalSubject %}
                {{ subject.canonicalSubject.name }} · <code>{{ subject.canonicalSubject.code }}</code>
            {% else %}
                <span class="muted">Eşleme yok — yerleşim subject uyumu doğrulanamaz</span>
            {% endif %}
        </dd>
    </dl>

    <section class="admin-section" aria-labelledby="placements-heading">
        <h2 id="placements-heading">Öğrenme yerleşimleri</h2>
        <p class="muted">Yerleşim yayınlamak için bağlı öğrenme içeriği yayımlanmış ve mühürlü olmalıdır. Öğrenci gövdesi burada gösterilmez.</p>

        {% if placements is empty %}
            <p class="muted">Henüz yerleşim yok.</p>
        {% else %}
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Başlık</th><th>İçerik</th><th>Slug</th><th>Sıra</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                        {% for p in placements %}
                            <tr>
                                <td>{{ p.displayTitle }}</td>
                                <td>
                                    <a href="{{ path('app_admin_learning_content', {id: p.learningContent.id.toRfc4122}) }}">{{ p.learningContent.title }}</a>
                                    · <code>{{ p.learningContent.status.value }}</code>
                                </td>
                                <td><code>{{ p.slug }}</code></td>
                                <td>{{ p.position }}</td>
                                <td>{{ p.visibilityStatus.value }}</td>
                                <td>
                                    {% if is_granted('CATALOG_TOPIC_LESSON_PUBLISH', p) and p.visibilityStatus.value == 'draft' %}
                                        <form method="post" action="{{ path('app_admin_catalog_placement_publish', {id: p.id.toRfc4122}) }}" class="stack-sm" style="display:inline-block" onsubmit="return confirm('Yerleşimi yayımlamak istediğinize emin misiniz?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('catalog_placement_publish_' ~ p.id.toRfc4122) }}">
                                            <input type="hidden" name="note" value="admin_placement_publish">
                                            <label>
                                                <input type="checkbox" name="confirm_publish" value="1" required>
                                                Onaylıyorum
                                            </label>
                                            <button type="submit" class="btn btn--ghost">Yayımla</button>
                                        </form>
                                    {% endif %}
                                    {% if is_granted('CATALOG_TOPIC_LESSON_ARCHIVE', p) and p.visibilityStatus.value != 'archived' %}
                                        <form method="post" action="{{ path('app_admin_catalog_placement_archive', {id: p.id.toRfc4122}) }}" style="display:inline" onsubmit="return confirm('Arşivleme geri alınamaz. Devam?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('catalog_placement_archive_' ~ p.id.toRfc4122) }}">
                                            <input type="hidden" name="note" value="admin_placement_archive">
                                            <button type="submit" class="btn btn--ghost">Arşivle</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if can_create_placement %}
            <h3>Yeni yerleşim</h3>
            {% if not subject.canonicalSubject %}
                <p class="muted">Canonical konu alanı eşlemesi yok. Önce ders sayfasından eşleyin.</p>
            {% elseif published_contents is empty %}
                <p class="muted">Bu canonical subject için yayımlanmış platform içeriği yok.</p>
            {% else %}
                <form method="post" action="{{ path('app_admin_catalog_topic_placement_create', {id: topic.id.toRfc4122}) }}" class="stack-sm">
                    <input type="hidden" name="_token" value="{{ csrf_token('catalog_topic_placement_' ~ topic.id.toRfc4122) }}">
                    <label>Yayımlanmış içerik
                        <select name="learning_content_id" required>
                            <option value="">Seçin</option>
                            {% for c in published_contents %}
                                <option value="{{ c.id.toRfc4122 }}">{{ c.title }} ({{ c.code }})</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>Görünen başlık
                        <input type="text" name="display_title" required minlength="2" maxlength="200">
                    </label>
                    <label>Slug (opsiyonel)
                        <input type="text" name="slug" maxlength="180" placeholder="otomatik">
                    </label>
                    <label>Özet
                        <textarea name="summary" maxlength="3000" rows="2"></textarea>
                    </label>
                    <label>Sıra
                        <input type="number" name="position" required value="0" min="0" step="1">
                    </label>
                    <label>Not
                        <input type="text" name="note" maxlength="64" value="admin_placement_create">
                    </label>
                    <button type="submit" class="btn btn--primary">Taslak yerleşim oluştur</button>
                </form>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
