{% extends 'admin/layout.html.twig' %}

{% block title %}{{ title }} — Müfredat — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_catalog_unit', {id: unit.id.toRfc4122}) }}">{{ unit.name }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ title }}</span>
    </nav>
    <h1 class="panel-greeting">{{ title }}</h1>
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'admin-form'}}) }}
        {{ form_errors(form) }}
        <div class="form-row">{{ form_label(form.name) }}{{ form_widget(form.name) }}{{ form_errors(form.name) }}</div>
        <div class="form-row">{{ form_label(form.summary) }}{{ form_widget(form.summary) }}{{ form_errors(form.summary) }}</div>
        <div class="form-row">{{ form_label(form.position) }}{{ form_widget(form.position) }}{{ form_errors(form.position) }}</div>
        <div class="form-row">{{ form_label(form.estimatedMinutes) }}{{ form_widget(form.estimatedMinutes) }}{{ form_errors(form.estimatedMinutes) }}</div>
        <button type="submit" class="btn btn--primary">Kaydet</button>
    {{ form_end(form) }}
{% endblock %}
