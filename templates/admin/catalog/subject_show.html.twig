{% extends 'admin/layout.html.twig' %}

{% block title %}{{ subject.name }} — Müfredat — Testlig{% endblock %}

{% block panel_content %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_admin_dashboard') }}">Yönetim</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_catalog') }}">Müfredat</a>
        <span aria-hidden="true">/</span>
        <span>{{ subject.name }}</span>
    </nav>
    <div class="admin-page-header">
        <h1 class="panel-greeting">{{ subject.name }}</h1>
        {% if can_manage %}
            <a class="btn btn--ghost" href="{{ path('app_admin_catalog_subject_edit', {id: subject.id.toRfc4122}) }}">Düzenle</a>
            <a class="btn btn--primary" href="{{ path('app_admin_catalog_unit_new', {id: subject.id.toRfc4122}) }}">Ünite ekle</a>
        {% endif %}
    </div>
    <dl class="account-dl">
        <dt>Sınıf</dt><dd>{{ subject.gradeLevel.value }}. sınıf</dd>
        <dt>Slug</dt><dd><code>{{ subject.slug }}</code></dd>
        <dt>Durum</dt><dd>{{ subject.status.labelTr }}</dd>
        <dt>Sıra</dt><dd>{{ subject.position }}</dd>
        {% if subject.sourceCode %}
            <dt>Kaynak kod</dt><dd><code>{{ subject.sourceCode }}</code>{% if subject.sourceOccurrence > 1 %} · occ {{ subject.sourceOccurrence }}{% endif %}</dd>
            <dt>Kaynak sürüm</dt><dd><code>{{ subject.sourceVersion }}</code></dd>
            {% if subject.sourceUrl %}
                <dt>Kaynak</dt><dd><a href="{{ subject.sourceUrl }}" rel="noopener noreferrer" target="_blank">Resmî program</a></dd>
            {% endif %}
        {% endif %}
    </dl>

    <section class="admin-section" aria-labelledby="canonical-map-heading">
        <h2 id="canonical-map-heading">Canonical konu alanı</h2>
        <p class="muted">Eşleme yalnız açık UUID seçimi ile yapılır; isim veya slug otomatik eşlenmez.</p>
        <dl class="account-dl">
            <dt>Mevcut eşleme</dt>
            <dd>
                {% if subject.canonicalSubject %}
                    <strong>{{ subject.canonicalSubject.name }}</strong>
                    · <code>{{ subject.canonicalSubject.code }}</code>
                    · <code>{{ subject.canonicalSubject.id.toRfc4122 }}</code>
                {% else %}
                    <span class="muted">Eşleme yok</span>
                {% endif %}
            </dd>
        </dl>
        {% if can_map_canonical %}
            <form method="post" action="{{ path('app_admin_catalog_subject_canonical', {id: subject.id.toRfc4122}) }}" class="stack-sm">
                <input type="hidden" name="_token" value="{{ csrf_token('catalog_canonical_map_' ~ subject.id.toRfc4122) }}">
                <label>Aktif konu alanı
                    <select name="canonical_subject_id">
                        <option value="">— Eşlemeyi kaldır —</option>
                        {% for cs in canonical_subjects %}
                            <option value="{{ cs.id.toRfc4122 }}"
                                {% if subject.canonicalSubject and subject.canonicalSubject.id.equals(cs.id) %}selected{% endif %}>
                                {{ cs.name }} ({{ cs.code }}) · {{ cs.id.toRfc4122 }}
                            </option>
                        {% endfor %}
                    </select>
                </label>
                <button type="submit" class="btn btn--primary">Eşlemeyi kaydet</button>
            </form>
        {% endif %}
    </section>

    {% if can_manage %}
        <div class="admin-actions stack-sm">
            {% if subject.status.value == 'draft' %}
                <form method="post" action="{{ path('app_admin_catalog_subject_publish', {id: subject.id.toRfc4122}) }}" onsubmit="return confirm('Bu dersi yayımlamak istediğinize emin misiniz?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('catalog_publish_' ~ subject.id.toRfc4122) }}">
                    <button type="submit" class="btn btn--primary">Yayımla</button>
                </form>
            {% endif %}
            {% if subject.status.value != 'archived' %}
                <form method="post" action="{{ path('app_admin_catalog_subject_archive', {id: subject.id.toRfc4122}) }}" onsubmit="return confirm('Bu dersi arşivlemek istediğinize emin misiniz?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('catalog_archive_' ~ subject.id.toRfc4122) }}">
                    <button type="submit" class="btn btn--ghost">Arşivle</button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <h2>Üniteler</h2>
    {% if units is empty %}
        <p class="muted">Henüz ünite yok.</p>
    {% else %}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Ad</th><th>Slug</th><th>Durum</th><th>Sıra</th><th></th></tr></thead>
                <tbody>
                    {% for u in units %}
                        <tr>
                            <td>{{ u.name }}</td>
                            <td><code>{{ u.slug }}</code></td>
                            <td>{{ u.status.labelTr }}</td>
                            <td>{{ u.position }}</td>
                            <td><a href="{{ path('app_admin_catalog_unit', {id: u.id.toRfc4122}) }}">Detay</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
