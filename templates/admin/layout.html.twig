{% extends 'base.html.twig' %}

{% block body_class %}is-admin-panel{% endblock %}

{% block site_chrome %}{% endblock %}
{% block site_footer %}{% endblock %}
{% block flashes %}{% endblock %}

{% block body %}
<div
    class="panel-shell"
    data-controller="panel-shell"
    data-panel-shell-collapsed-class="is-collapsed"
>
    {% include 'components/panel_sidebar.html.twig' %}

    <div class="panel-main">
        <header class="panel-topbar">
            <div class="panel-topbar__meta">
                {% include 'components/avatar.html.twig' with { initials: avatar_initials, name: display_name } %}
                <div>
                    <p class="panel-topbar__title">{{ display_name }}</p>
                    <p class="muted" style="margin:0;font-size:0.85rem;">{{ panel_role_label }}</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a class="btn btn--ghost" href="{{ path('app_home') }}">Ana sayfa</a>
                <form method="post" action="{{ path('app_logout') }}" class="admin-logout-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="btn btn--ghost">Çıkış</button>
                </form>
            </div>
        </header>

        <div class="panel-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="admin-flash admin-flash--{{ label }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block panel_content %}{% endblock %}
        </div>
    </div>

    {% include 'components/mobile_bottom_nav.html.twig' %}
</div>
{% endblock %}
