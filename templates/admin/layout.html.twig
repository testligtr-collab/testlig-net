{% extends 'base.html.twig' %}

{% block body_class %}{{ workspace_shell|default(false) ? 'is-admin-panel is-workspace' : 'is-admin-panel' }}{% endblock %}

{% block site_chrome %}{% endblock %}
{% block site_footer %}{% endblock %}
{% block flashes %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if workspace_shell|default(false) %}
        <link rel="stylesheet" href="{{ mapped_asset('styles/workspace.css') }}">
    {% else %}
        <link rel="stylesheet" href="{{ mapped_asset('styles/admin.css') }}">
    {% endif %}
{% endblock %}

{% block body %}
<div
    class="panel-shell"
    data-controller="panel-shell"
    data-panel-shell-collapsed-class="is-collapsed"
>
    {% include 'admin/_sidebar.html.twig' %}

    <div class="panel-main">
        <header class="panel-topbar">
            {% if workspace_shell|default(false) %}
                <div class="panel-topbar__meta">
                    <button
                        type="button"
                        class="admin-menu-btn"
                        data-action="panel-shell#menu"
                        aria-expanded="false"
                        aria-controls="panel-sidebar"
                    >Menü</button>
                    <p class="panel-topbar__title">Çalışma alanı</p>
                </div>
                <p class="admin-topbar-initials" aria-hidden="true">{{ avatar_initials }}</p>
            {% else %}
                <div class="panel-topbar__meta">
                    <button
                        type="button"
                        class="admin-menu-btn"
                        data-action="panel-shell#menu"
                        aria-expanded="false"
                        aria-controls="panel-sidebar"
                    >Menü</button>
                    {% block panel_breadcrumb %}{% endblock %}
                </div>
                <div class="admin-toolbar">
                    <div class="admin-search">
                        <label>
                            <span class="sr-only" id="admin-search-note">Arama şu an kapalı</span>
                            <input type="search" placeholder="Kullanıcı, kurum veya içerik ara…" disabled tabindex="-1" autocomplete="off" aria-describedby="admin-search-note">
                        </label>
                    </div>
                    <div class="admin-topbar-tools">
                        <button type="button" class="admin-icon-btn" disabled tabindex="-1" title="Bildirimler henüz yok" aria-describedby="admin-bell-note">
                            <svg class="admin-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M6 9.5a6 6 0 0 1 12 0c0 4 1.2 5.5 1.2 5.5H4.8S6 13.5 6 9.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                                <path d="M10 18a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            </svg>
                            <span class="sr-only" id="admin-bell-note">Bildirimler henüz yok</span>
                        </button>
                        <p class="admin-topbar-initials" aria-hidden="true">{{ avatar_initials }}</p>
                    </div>
                </div>
            {% endif %}
        </header>
        <button type="button" class="admin-nav-backdrop" data-action="panel-shell#closeMenu"><span class="sr-only">Menüyü kapat</span></button>

        <div class="panel-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="admin-flash admin-flash--{{ label }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block panel_content %}{% endblock %}
        </div>
    </div>

    {% include 'components/mobile_bottom_nav.html.twig' %}
</div>
{% endblock %}
