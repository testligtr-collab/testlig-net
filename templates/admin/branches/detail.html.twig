{% extends 'admin/layout.html.twig' %}

{% block title %}Şube detayı — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_branches') }}">Şube ve kampüsler</a>
        <span aria-hidden="true">/</span>
        <span>Ref {{ branch.shortRef }}</span>
    </nav>
{% endblock %}

{% block panel_content %}
    {% set kind_labels = { 'branch': 'Şube', 'campus': 'Kampüs' } %}
    {% set status_labels = { 'pending': 'Beklemede', 'active': 'Aktif', 'suspended': 'Askıda', 'archived': 'Arşiv' } %}
    <div class="admin-user-page admin-branch-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Şube detayı</h1>
                <p>Kayıt bilgileri, bağlı kurum ve yerel durum.</p>
            </div>
            <a class="btn btn--ghost admin-institution-back" href="{{ path('app_admin_branches') }}">← Listeye dön</a>
        </header>

        <section class="admin-institution-card admin-institution-profile" aria-labelledby="branch-profile-name">
            <div class="admin-institution-profile__main">
                <span class="admin-institution-profile__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}</span>
                <div>
                    <h2 id="branch-profile-name" class="admin-institution-name">{{ branch.name }}</h2>
                    <p>Kod {{ branch.code }} · {{ branch.institutionName }}</p>
                    <p>
                        <span class="admin-institution-type{{ branch.kind.value == 'campus' ? ' admin-institution-type--campus' : '' }}">{{ kind_labels[branch.kind.value]|default(branch.kind.value) }}</span>
                        <span class="admin-institution-status admin-institution-status--{{ branch.status.value }}">{{ status_labels[branch.status.value]|default(branch.status.value) }}</span>
                    </p>
                    <p data-branch-access>{{ branch.accessNote }}</p>
                </div>
            </div>
        </section>

        <div class="admin-institution-create">
            <div class="admin-institution-create__main">
                <section class="admin-institution-card" aria-labelledby="branch-facts">
                    <h2 id="branch-facts"><span class="admin-institution-heading-icon admin-institution-heading-icon--teal" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'learning_contents' } only %}</span> Bağlı kurum</h2>
                    <dl class="admin-institution-facts">
                        <div><dt>Kurum</dt><dd>{{ branch.institutionName }}</dd></div>
                        <div><dt>Kurum durumu</dt><dd>{{ status_labels[branch.institutionStatus.value]|default(branch.institutionStatus.value) }}</dd></div>
                        <div><dt>Yerel durum</dt><dd>{{ status_labels[branch.status.value]|default(branch.status.value) }}</dd></div>
                        <div><dt>Erişim</dt><dd>{{ branch.accessNote }}</dd></div>
                    </dl>
                    <p class="admin-institution-note">Bağlı kurum bu kayıtta değiştirilemez. Kurum askıda veya arşivdeyken şube erişimi açılmaz.</p>
                </section>

                {% if update_form %}
                    <section class="admin-institution-card" aria-labelledby="branch-edit">
                        <h2 id="branch-edit"><span class="admin-institution-heading-icon admin-institution-heading-icon--blue" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'institutions' } only %}</span> Temel bilgiler</h2>
                        {{ form_start(update_form, { attr: { novalidate: 'novalidate' } }) }}
                            <div class="admin-institution-field">
                                {{ form_label(update_form.name) }}
                                {{ form_widget(update_form.name) }}
                                {{ form_errors(update_form.name) }}
                            </div>
                            <div class="admin-institution-field">
                                {{ form_label(update_form.code) }}
                                {{ form_widget(update_form.code) }}
                                {{ form_errors(update_form.code) }}
                            </div>
                            <div class="admin-institution-field">
                                {{ form_label(update_form.kind) }}
                                {{ form_widget(update_form.kind) }}
                                {{ form_errors(update_form.kind) }}
                            </div>
                            <div class="admin-institution-field">
                                {{ form_label(update_form.reasonCode, 'Gerekçe') }}
                                {{ form_widget(update_form.reasonCode) }}
                                {{ form_errors(update_form.reasonCode) }}
                            </div>
                            <div class="admin-institution-field">
                                {{ form_widget(update_form.confirm) }}
                                {{ form_label(update_form.confirm) }}
                                {{ form_errors(update_form.confirm) }}
                            </div>
                            <button class="btn admin-institution-primary" type="submit">Bilgileri kaydet</button>
                        {{ form_end(update_form) }}
                    </section>
                {% endif %}
            </div>

            <aside class="admin-institution-card" aria-labelledby="branch-status">
                <h2 id="branch-status"><span class="admin-institution-heading-icon admin-institution-heading-icon--amber" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'refresh' } only %}</span> Durumu güncelle</h2>
                <p>Mevcut durum: <span class="admin-institution-status admin-institution-status--{{ branch.status.value }}">{{ status_labels[branch.status.value]|default(branch.status.value) }}</span></p>
                {% if status_form %}
                    {{ form_start(status_form, { attr: { novalidate: 'novalidate' } }) }}
                        <div class="admin-institution-field">
                            {{ form_label(status_form.action) }}
                            {{ form_widget(status_form.action) }}
                            {{ form_errors(status_form.action) }}
                        </div>
                        <div class="admin-institution-field">
                            {{ form_label(status_form.reasonCode, 'İşlem gerekçesi') }}
                            {{ form_widget(status_form.reasonCode) }}
                            {{ form_errors(status_form.reasonCode) }}
                        </div>
                        <div class="admin-institution-field">
                            {{ form_widget(status_form.confirm) }}
                            {{ form_label(status_form.confirm) }}
                            {{ form_errors(status_form.confirm) }}
                        </div>
                        <button class="btn admin-institution-primary" type="submit">Durumu kaydet</button>
                    {{ form_end(status_form) }}
                {% else %}
                    <p class="admin-institution-note">Bu kayıt için durum geçişi yok.</p>
                {% endif %}
                <p class="admin-institution-note">Aktifleştirme, bağlı kurum aktifse uygulanır.</p>
            </aside>
        </div>
    </div>
{% endblock %}
