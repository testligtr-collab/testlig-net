{% extends 'admin/layout.html.twig' %}

{% block title %}Müfredat Yönetimi — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <span>Müfredat Yönetimi</span>
    </nav>
{% endblock %}

{% block panel_content %}
    {% set status_labels = { 'draft': 'Taslak', 'published': 'Yayında', 'retired': 'Emekli' } %}
    {% set status_variants = { 'draft': 'neutral', 'published': 'success', 'retired': 'neutral' } %}
    {% set stage_grades = { 'ilkokul': [1, 2, 3, 4], 'ortaokul': [5, 6, 7, 8], 'lise': [9, 10, 11, 12] } %}
    {% set stage_gates = [] %}
    {% set grade_gates = {} %}
    {% for gate in gates %}
        {% if gate.kind == 'stage' %}
            {% set stage_gates = stage_gates|merge([gate]) %}
        {% else %}
            {% set grade_gates = grade_gates|merge({ ('g' ~ gate.gateKey): gate }) %}
        {% endif %}
    {% endfor %}
    {% set selected_stage = filters.kademe %}
    {% if filters.sinif %}
        {% set selected_value = filters.sinif + 0 %}
        {% set selected_stage = selected_value <= 4 ? 'ilkokul' : (selected_value <= 8 ? 'ortaokul' : 'lise') %}
    {% endif %}
    <div class="admin-user-page admin-curriculum-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Müfredat Yönetimi</h1>
                <p>Kademe, sınıf düzeyi, ders ve programı buradan seçin. Kazanımlar programın içindedir. Öğrenci kataloğu ayrı bir yayın zinciridir. Operasyonel sınıf adı, örneğin 5-A, bu listedeki sınıf düzeyi değildir.</p>
            </div>
            {% if can_manage %}
                <a class="btn admin-institution-primary" href="{{ path('app_admin_curriculum_new') }}"><span aria-hidden="true">+ </span>Yeni program</a>
            {% endif %}
        </header>
        <p class="admin-institution-note">Kademe ve sınıf düzeyi sabittir. Yeni düzey eklenmez. Sınıf düzeyi silinmez. Pasif kayıt öğrenci erişimini kapatır; yeniden açmak alt kayıtların kendi durumunu değiştirmez. Arşiv ve emekli ayrıdır, geri açılmaz. Sayaçlar seçili filtreden bağımsızdır.</p>

        <section class="admin-curriculum-stages" aria-label="Kademe">
            {% for gate in stage_gates %}
                <article class="admin-curriculum-stage admin-curriculum-stage--{{ gate.gateKey }}{% if selected_stage == gate.gateKey %} is-selected{% endif %}">
                    <div class="admin-curriculum-stage__head">
                        <h2>
                            <a href="{{ path('app_admin_curriculum', { q: filters.q, ders: filters.ders, kademe: gate.gateKey, durum: filters.durum }) }}"{% if selected_stage == gate.gateKey %} aria-current="page"{% endif %}>{{ gate.label }}</a>
                        </h2>
                        <span class="admin-institution-status admin-institution-status--{{ gate.status.value == 'active' ? 'active' : 'suspended' }}">{{ gate.status.value == 'active' ? 'Aktif' : 'Pasif' }}</span>
                    </div>
                    <p>Sabit kademe. Oluşturulmaz ve silinmez.</p>
                </article>
            {% endfor %}
        </section>
        {% if selected_stage %}
            <div class="admin-curriculum-grades" aria-label="Seçilen kademenin sınıf düzeyleri">
                {% for grade in stage_grades[selected_stage] %}
                    {% set grade_gate = grade_gates['g' ~ grade]|default(null) %}
                    <a class="admin-curriculum-grade{% if filters.sinif == grade ~ '' %} is-selected{% endif %}" href="{{ path('app_admin_curriculum', { q: filters.q, ders: filters.ders, sinif: grade, durum: filters.durum }) }}"{% if filters.sinif == grade ~ '' %} aria-current="page"{% endif %}>
                        <span>{{ grade }}. sınıf</span>
                        <small>{{ grade_gate and grade_gate.status.value == 'active' ? 'Aktif' : 'Pasif' }}</small>
                    </a>
                {% endfor %}
            </div>
            {% if can_manage or can_availability %}
                <details class="admin-curriculum-actions">
                    <summary role="button">İşlemler</summary>
                    {% for gate in stage_gates %}
                        {% if gate.gateKey == selected_stage %}
                            {% if can_manage %}
                                <form method="post" action="{{ path('app_admin_curriculum_stage_rename', { key: gate.gateKey }) }}">
                                    <p>Ad değişikliği kademenin kimliğini değiştirmez.</p>
                                    <label>Görünen ad<input name="admin_curriculum_rename_gate[title]" value="{{ gate.label }}" maxlength="80"></label>
                                    <input type="hidden" name="admin_curriculum_rename_gate[reasonCode]" value="curriculum_correction">
                                    <label><input type="checkbox" name="admin_curriculum_rename_gate[confirm]" value="1"> Ad değişikliğini onaylıyorum</label>
                                    <input type="hidden" name="admin_curriculum_rename_gate[_token]" value="{{ csrf_token('admin_curriculum_rename_gate_stage_' ~ gate.gateKey) }}">
                                    <button class="btn btn--ghost" type="submit">Adı kaydet</button>
                                </form>
                            {% endif %}
                            {% if can_availability and gate.status.value == 'active' %}
                                <form method="post" action="{{ path('app_admin_curriculum_stage_access', { key: gate.gateKey, mode: 'pasif' }) }}">
                                    <p>Pasif yapmak öğrenciyi kapatır. Alt kayıtların kendi durumu değişmez. Bu işlem arşiv değildir.</p>
                                    <label><input type="checkbox" name="admin_curriculum_passive_gate[confirm]" value="1"> Pasif yapmayı onaylıyorum. Alt kayıtların kendi durumu değişmez.</label>
                                    <input type="hidden" name="admin_curriculum_passive_gate[reasonCode]" value="curriculum_passive">
                                    <input type="hidden" name="admin_curriculum_passive_gate[_token]" value="{{ csrf_token('admin_curriculum_pasif_gate_stage_' ~ gate.gateKey) }}">
                                    <button class="btn btn--ghost" type="submit">{{ gate.gateKey == 'ilkokul' ? 'İlkokulu pasif yap' : (gate.gateKey == 'ortaokul' ? 'Ortaokulu pasif yap' : 'Liseyi pasif yap') }}</button>
                                </form>
                            {% elseif can_availability %}
                                <form method="post" action="{{ path('app_admin_curriculum_stage_access', { key: gate.gateKey, mode: 'aktif' }) }}">
                                    <p>Yeniden açmak alt kayıtların kendi durumunu yazmaz.</p>
                                    <label><input type="checkbox" name="admin_curriculum_active_gate[confirm]" value="1"> Yeniden aktif etmeyi onaylıyorum. Alt kayıtların kendi durumu değişmez.</label>
                                    <input type="hidden" name="admin_curriculum_active_gate[reasonCode]" value="curriculum_activate">
                                    <input type="hidden" name="admin_curriculum_active_gate[_token]" value="{{ csrf_token('admin_curriculum_aktif_gate_stage_' ~ gate.gateKey) }}">
                                    <button class="btn btn--ghost" type="submit">{{ gate.label }} düzeyini yeniden aktif yap</button>
                                </form>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    {% for grade in stage_grades[selected_stage] %}
                        {% set grade_gate = grade_gates['g' ~ grade]|default(null) %}
                        {% if grade_gate and can_manage %}
                            <form method="post" action="{{ path('app_admin_curriculum_grade_rename', { grade: grade_gate.gateKey }) }}">
                                <label>{{ grade }}. sınıf görünen adı<input name="admin_curriculum_rename_gate[title]" value="{{ grade_gate.label }}" maxlength="80"></label>
                                <input type="hidden" name="admin_curriculum_rename_gate[reasonCode]" value="curriculum_correction">
                                <label><input type="checkbox" name="admin_curriculum_rename_gate[confirm]" value="1"> Ad değişikliğini onaylıyorum</label>
                                <input type="hidden" name="admin_curriculum_rename_gate[_token]" value="{{ csrf_token('admin_curriculum_rename_gate_grade_' ~ grade_gate.gateKey) }}">
                                <button class="btn btn--ghost" type="submit">Adı kaydet</button>
                            </form>
                        {% endif %}
                        {% if grade_gate and can_availability and grade_gate.status.value == 'active' %}
                            <form method="post" action="{{ path('app_admin_curriculum_grade_access', { grade: grade_gate.gateKey, mode: 'pasif' }) }}">
                                <label><input type="checkbox" name="admin_curriculum_passive_gate[confirm]" value="1"> Pasif yapmayı onaylıyorum. Alt kayıtların kendi durumu değişmez.</label>
                                <input type="hidden" name="admin_curriculum_passive_gate[reasonCode]" value="curriculum_passive">
                                <input type="hidden" name="admin_curriculum_passive_gate[_token]" value="{{ csrf_token('admin_curriculum_pasif_gate_grade_' ~ grade_gate.gateKey) }}">
                                <button class="btn btn--ghost" type="submit">{{ grade_gate.label }} düzeyini pasif yap</button>
                            </form>
                        {% elseif grade_gate and can_availability %}
                            <form method="post" action="{{ path('app_admin_curriculum_grade_access', { grade: grade_gate.gateKey, mode: 'aktif' }) }}">
                                <label><input type="checkbox" name="admin_curriculum_active_gate[confirm]" value="1"> Yeniden aktif etmeyi onaylıyorum. Alt kayıtların kendi durumu değişmez.</label>
                                <input type="hidden" name="admin_curriculum_active_gate[reasonCode]" value="curriculum_activate">
                                <input type="hidden" name="admin_curriculum_active_gate[_token]" value="{{ csrf_token('admin_curriculum_aktif_gate_grade_' ~ grade_gate.gateKey) }}">
                                <button class="btn btn--ghost" type="submit">{{ grade_gate.label }} düzeyini yeniden aktif yap</button>
                            </form>
                        {% endif %}
                    {% endfor %}
                </details>
            {% endif %}
        {% else %}
            <p class="admin-institution-note">Bir kademe seçin. Sınıf düzeyleri seçilen kademenin altında açılır.</p>
        {% endif %}

        <section class="admin-user-stats" aria-label="Program özeti">
            <article class="admin-user-stat admin-user-stat--total">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Toplam program</span>
                    <strong class="admin-user-stat__value" data-curriculum-summary="total">{{ summary.total }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--pending">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'learning_contents' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Taslak</span>
                    <strong class="admin-user-stat__value" data-curriculum-summary="draft">{{ summary.draft }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--active">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'tests' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Yayında</span>
                    <strong class="admin-user-stat__value" data-curriculum-summary="published">{{ summary.published }}</strong>
                </span>
            </article>
            <article class="admin-user-stat admin-user-stat--members">
                <span class="admin-user-stat__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'system' } only %}</span>
                <span class="admin-user-stat__copy">
                    <span class="admin-user-stat__label">Emekli</span>
                    <strong class="admin-user-stat__value" data-curriculum-summary="retired">{{ summary.retired }}</strong>
                </span>
            </article>
        </section>

        <section aria-labelledby="curriculum-programs">
        <h2 id="curriculum-programs">Program ve kazanımlar</h2>
        <p>{% if filters.sinif %}{{ filters.sinif }}. sınıf düzeyinin programları. Katalog kaydı bu listeden ayrıdır.{% else %}Sınıf seçilince liste o düzeyle sınırlanır. Katalog yayını programın yayınını değiştirmez.{% endif %}</p>
        <form method="get" class="admin-filters admin-user-filters" action="{{ path('app_admin_curriculum') }}" aria-label="Programları filtrele">
            <h3>Programları filtrele</h3>
            {% if filters.kademe %}
                <input type="hidden" name="kademe" value="{{ filters.kademe }}">
            {% endif %}
            <div class="admin-user-filters__fields">
                <label class="admin-user-search" for="curriculum-filter-q">
                    <span class="sr-only">Program adı veya kod</span>
                    <span class="admin-user-search__icon" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'search' } only %}</span>
                    <input id="curriculum-filter-q" type="search" name="q" value="{{ filters.q }}" maxlength="100" autocomplete="off" placeholder="Program adı veya kod">
                </label>
                <label for="curriculum-filter-subject">
                    <span class="sr-only">Ders</span>
                    <select id="curriculum-filter-subject" name="ders">
                        <option value="">Tüm dersler</option>
                        {% for subject in subjects %}
                            <option value="{{ subject.id }}" {% if filters.ders == subject.id %}selected{% endif %}>{{ subject.name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label for="curriculum-filter-grade">
                    <span class="sr-only">Sınıf düzeyi</span>
                    <select id="curriculum-filter-grade" name="sinif">
                        <option value="">Tüm sınıflar</option>
                        {% for grade in grades %}
                            <option value="{{ grade.value }}" {% if filters.sinif == grade.value ~ '' %}selected{% endif %}>{{ grade.value }}. sınıf</option>
                        {% endfor %}
                    </select>
                </label>
                <label for="curriculum-filter-status">
                    <span class="sr-only">Durum</span>
                    <select id="curriculum-filter-status" name="durum">
                        <option value="">Tüm durumlar</option>
                        {% for value, label in status_labels %}
                            <option value="{{ value }}" {% if filters.durum == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <button class="btn admin-institution-primary" type="submit">Filtrele</button>
                <a class="btn btn--ghost" href="{{ path('app_admin_curriculum') }}">Temizle</a>
            </div>
        </form>

        {% if rows is empty %}
            <section class="admin-institution-card">
                <h2>Kayıt yok</h2>
                <p>{% if filters.sinif %}Bu sınıf düzeyinde program yok.{% else %}Filtrelere uygun program bulunamadı.{% endif %}</p>
            </section>
        {% else %}
            <div class="admin-table-wrap">
                <table class="admin-table admin-user-table admin-curriculum-program-table">
                    <thead>
                        <tr>
                            <th>Program</th>
                            <th>Ders</th>
                            <th>Sınıf</th>
                            <th>Sürüm</th>
                            <th>Durum</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td class="admin-curriculum-program__identity" data-label="Program">
                                    <div class="admin-curriculum-program__head">
                                        <span class="admin-user-person__name">{{ row.name }}</span>
                                        <span class="admin-status admin-status--{{ status_variants[row.status.value] }} admin-curriculum-program__card-status">
                                            <span class="admin-status__dot" aria-hidden="true"></span>
                                            {{ status_labels[row.status.value] }}
                                        </span>
                                    </div>
                                    <p class="admin-curriculum-program__meta">{{ row.subject.name }} · {{ row.gradeLevel.value }}. sınıf · {{ row.version }}</p>
                                    <div class="admin-curriculum-program__foot">
                                        <details class="admin-curriculum-tech">
                                            <summary role="button">Teknik bilgiler</summary>
                                            <div class="admin-curriculum-tech__panel">
                                                <dl>
                                                    <dt>Teknik kod</dt>
                                                    <dd><code>{{ row.code }}</code></dd>
                                                </dl>
                                                <p>Bu kod resmî kazanım kodu değildir.</p>
                                            </div>
                                        </details>
                                        <a class="btn btn--ghost admin-institution-detail admin-curriculum-program__open" href="{{ path('app_admin_curriculum_show', { id: row.id }) }}">İncele <span aria-hidden="true">→</span></a>
                                    </div>
                                </td>
                                <td class="admin-curriculum-program__subject" data-label="Ders">{{ row.subject.name }}</td>
                                <td class="admin-curriculum-program__grade" data-label="Sınıf">{{ row.gradeLevel.value }}. sınıf</td>
                                <td class="admin-curriculum-program__version" data-label="Sürüm">{{ row.version }}</td>
                                <td class="admin-curriculum-program__status" data-label="Durum">
                                    <span class="admin-status admin-status--{{ status_variants[row.status.value] }}">
                                        <span class="admin-status__dot" aria-hidden="true"></span>
                                        {{ status_labels[row.status.value] }}
                                    </span>
                                </td>
                                <td class="admin-curriculum-program__action" data-label="İşlem"><a class="btn btn--ghost admin-institution-detail" href="{{ path('app_admin_curriculum_show', { id: row.id }) }}">İncele <span aria-hidden="true">→</span></a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if pages > 1 %}
                <nav class="admin-institution-pager" aria-label="Sayfalar">
                    <span class="admin-institution-pager__current">{{ page }}</span>
                    <span>Sayfa {{ page }} / {{ pages }}</span>
                </nav>
            {% endif %}
        {% endif %}
        </section>
        {% if filters.sinif and can_catalog %}
            <section class="admin-curriculum-catalog" aria-labelledby="curriculum-catalog">
                <h2 id="curriculum-catalog">Öğrenci kataloğu</h2>
                <p>Bu liste {{ filters.sinif }}. sınıf düzeyinin katalog dersleridir. Katalog yayını programın yayınını değiştirmez. Program yayını katalog kaydını yayınlamaz.</p>
                {% if catalog_subjects is empty %}
                    <p>Bu sınıf düzeyinde öğrenci kataloğu kaydı yok.</p>
                {% else %}
                    <ul class="admin-curriculum-catalog-list">
                        {% for subject in catalog_subjects %}
                            {% set catalog_labels = { 'draft': 'Katalog taslağı', 'published': 'Katalog yayında', 'archived': 'Katalog arşivi' } %}
                            <li>
                                <a href="{{ path('app_admin_catalog_subject', { id: subject.id }) }}">{{ subject.name }}</a>
                                <span>{{ catalog_labels[subject.status.value]|default(subject.status.value) }}</span>
                                {% if subject.canonicalSubject %}
                                    <span>Bağlı ders: {{ subject.canonicalSubject.name }}</span>
                                {% else %}
                                    <span>Programa bağlı ders yok</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}
        {% if gate_error %}
            <p class="admin-institution-note">{{ gate_error }}</p>
        {% endif %}
        {% if can_catalog %}
            <p class="admin-institution-note"><a href="{{ path('app_admin_catalog') }}">Müfredat kataloğu</a> yayımlanmış ders, ünite ve konu zinciri içindir. Program sürümünü değiştirmez.</p>
        {% endif %}
    </div>
{% endblock %}
