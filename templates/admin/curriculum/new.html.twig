{% extends 'admin/layout.html.twig' %}

{% block title %}Yeni program — Testlig{% endblock %}

{% block panel_breadcrumb %}
    <nav class="admin-breadcrumb" aria-label="Konum">
        {% include 'admin/_crumb_root.html.twig' %}
        <span aria-hidden="true">/</span>
        <a href="{{ path('app_admin_curriculum') }}">Programlar</a>
        <span aria-hidden="true">/</span>
        <span>Yeni</span>
    </nav>
{% endblock %}

{% block panel_content %}
    <div class="admin-user-page admin-curriculum-page">
        <header class="admin-user-head">
            <div>
                <h1 class="panel-greeting">Yeni program</h1>
                <p>Program taslak oluşur. Bu form programı yayınlamaz. Sınıf düzeyi 1–12 enum değeridir.</p>
            </div>
            <a class="btn btn--ghost admin-institution-back" href="{{ path('app_admin_curriculum') }}"><span aria-hidden="true">← </span>Listeye dön</a>
        </header>

        <div class="admin-institution-create">
            <div class="admin-institution-create__main">
                {{ form_start(subject_form, { attr: { class: 'admin-institution-card', novalidate: 'novalidate' } }) }}
                    <h2 id="curriculum-subject-create"><span class="admin-institution-heading-icon admin-institution-heading-icon--blue" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span> Ders</h2>
                    <p>Ders, programların bağlandığı genel kayıttır. Kodu sonradan değişmez.</p>
                    {% for field in subject_form %}
                        {% if field.vars.name != '_token' %}
                            <div class="admin-institution-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {{ form_errors(field) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                    {{ form_errors(subject_form) }}
                    <button class="btn admin-institution-primary" type="submit">Dersi oluştur</button>
                {{ form_end(subject_form) }}
                {% if rename_error %}
                    <p class="admin-institution-note">{{ rename_error }}</p>
                {% endif %}
                {% for subject in subjects %}
                    <form class="admin-institution-card" method="post" action="{{ path('app_admin_curriculum_subject_rename', { subject: subject.id }) }}">
                        <h3>{{ subject.name }}</h3>
                        <p>Teknik kod: {{ subject.code }}. Kod değişmez.</p>
                        <div class="admin-institution-field">
                            <label for="subject-name-{{ subject.id }}">Ders adı</label>
                            <input id="subject-name-{{ subject.id }}" name="admin_curriculum_rename_subject[title]" value="{{ subject.name }}" maxlength="160">
                        </div>
                        <input type="hidden" name="admin_curriculum_rename_subject[reasonCode]" value="curriculum_correction">
                        <label><input type="checkbox" name="admin_curriculum_rename_subject[confirm]" value="1"> Ad değişikliğini onaylıyorum</label>
                        <input type="hidden" name="admin_curriculum_rename_subject[_token]" value="{{ csrf_token('admin_curriculum_rename_' ~ subject.id) }}">
                        <button class="btn btn--ghost" type="submit">Ders adını kaydet</button>
                    </form>
                {% endfor %}
            </div>
            <div class="admin-institution-create__main">
                {{ form_start(program_form, { attr: { class: 'admin-institution-card', novalidate: 'novalidate' } }) }}
                    <h2 id="curriculum-program-create"><span class="admin-institution-heading-icon admin-institution-heading-icon--teal" aria-hidden="true">{% include 'components/admin_icon.html.twig' with { icon: 'catalog' } only %}</span> Program sürümü</h2>
                    <p>Kod, program içindeki teknik koddur. Resmî kazanım kodu değildir.</p>
                    {% if subjects is empty %}
                        <p>Önce bir ders oluşturun. Boş listeden örnek ders seçilmez.</p>
                    {% endif %}
                    {% for field in program_form %}
                        {% if field.vars.name != '_token' %}
                            <div class="admin-institution-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {{ form_errors(field) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                    {{ form_errors(program_form) }}
                    <button class="btn admin-institution-primary" type="submit">Taslak programı oluştur</button>
                    <a class="btn btn--ghost" href="{{ path('app_admin_curriculum') }}">İptal</a>
                {{ form_end(program_form) }}
            </div>
        </div>
    </div>
{% endblock %}
