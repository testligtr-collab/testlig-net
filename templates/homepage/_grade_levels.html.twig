<section id="siniflar" class="hp-section" aria-labelledby="siniflar-title">
    <div class="container">
        <h2 id="siniflar-title" class="hp-section__title hp-section__title--center">Sınıfını seç, içerikleri keşfet.</h2>

        <div data-controller="grade-books">
            <div
                class="hp-books"
                role="tablist"
                aria-label="Sınıf seçimi"
            >
                {% for book in view.gradeBooks %}
                    <button
                        type="button"
                        class="hp-book{% if not book.ready %} hp-book--soon{% endif %}"
                        id="{{ book.id }}"
                        role="tab"
                        aria-selected="{{ book.selected ? 'true' : 'false' }}"
                        aria-controls="{{ book.panelId }}"
                        aria-label="{{ book.grade }}. sınıf{{ book.grade == 8 ? ' LGS' : '' }}, {{ book.ready ? 'dersler yayında' : 'içerikler hazırlanıyor' }}"
                        tabindex="{{ book.selected ? '0' : '-1' }}"
                        data-grade-books-target="tab"
                        data-grade="{{ book.grade }}"
                        data-action="click->grade-books#select keydown->grade-books#onKeydown"
                    >{{ book.label }}</button>
                {% endfor %}
            </div>

            {% for book in view.gradeBooks %}
                <div
                    class="hp-grade-panel"
                    id="{{ book.panelId }}"
                    role="tabpanel"
                    aria-labelledby="{{ book.id }}"
                    data-grade-books-target="panel"
                    data-grade-ready="{{ book.ready ? 'true' : 'false' }}"
                    tabindex="0"
                    {% if not book.selected %}hidden{% endif %}
                >
                    <div class="hp-grade-panel__intro">
                        <h3>{{ book.grade }}. Sınıf{{ book.grade == 8 ? ' · LGS' : '' }}</h3>
                        {% if book.ready %}
                            <p>Yayımlanmış dersleri ders kataloğunda inceleyebilirsin. Ders içeriği öğrenci hesabıyla açılır.</p>
                        {% else %}
                            <p>Bu sınıfın dersleri henüz yayımlanmadı.</p>
                        {% endif %}
                    </div>
                    {% if book.ready %}
                        <div class="hp-grade-status hp-grade-status--ready">
                            <p class="hp-grade-status__text">
                                <strong>{{ book.subjectCount }} ders · {{ book.unitCount }} ünite</strong>
                                <span>yayımlanmış</span>
                            </p>
                            <a class="btn btn--cta" href="{{ path('app_public_catalog_grade', {grade: book.grade}) }}">{{ book.grade }}. sınıf derslerini gör</a>
                        </div>
                    {% else %}
                        <div class="hp-grade-status hp-grade-status--soon">
                            <span class="hp-chip" role="status">İçerikler hazırlanıyor</span>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <noscript>
            <ul class="hp-grade-fallback" aria-label="Sınıf dersleri">
                {% for book in view.gradeBooks %}
                    <li>
                        {% if book.ready %}
                            <a href="{{ path('app_public_catalog_grade', {grade: book.grade}) }}">{{ book.grade }}. sınıf derslerini gör</a>
                        {% else %}
                            {{ book.grade }}. sınıf: içerikler hazırlanıyor
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </noscript>

        <p class="hp-note hp-note--center" role="note">{{ view.gradeSelectionNote }}</p>
    </div>
</section>
