<section id="kurumlar" class="hp-section hp-section--institution" aria-labelledby="kurumlar-title">
    <div class="container hp-split">
        <div>
            <h2 id="kurumlar-title" class="hp-section__title">{{ view.institutionTitle }}</h2>
            <p class="hp-section__lead">{{ view.institutionBody }}</p>
            <span class="hp-chip" role="status">İçerikler hazırlanıyor</span>
        </div>
        <figure class="hp-sample-figure">
            <img
                src="{{ view.institutionImage }}"
                alt="{{ view.institutionImageAlt }}"
                width="520"
                height="320"
                loading="lazy"
                decoding="async"
            >
            <figcaption class="hp-sample-caption">Örnek arayüz — veriler temsilidir.</figcaption>
        </figure>
    </div>
</section>
