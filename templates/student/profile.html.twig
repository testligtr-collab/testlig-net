{% extends 'student/layout.html.twig' %}

{% block title %}Profilim — Öğrenci — Testlig{% endblock %}

{% block student_content %}
<section class="student-form-card">
    <nav class="student-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_student_dashboard') }}">Panel</a>
        <span aria-hidden="true">/</span>
        <span>Profil</span>
    </nav>
    <h1>Profilim</h1>
    <p class="muted">Sınıf ve öğrenme bilgilerini buradan güncelleyebilirsin. E-posta ve parola için <a href="{{ path('app_account') }}">Hesabım</a> sayfasını kullan.</p>

    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'student-setup__form'}}) }}
        {{ form_errors(form) }}

        <div class="form-row">
            {{ form_label(form.gradeLevel) }}
            {{ form_widget(form.gradeLevel) }}
            {{ form_errors(form.gradeLevel) }}
        </div>

        <div class="form-row">
            {{ form_label(form.schoolName) }}
            {{ form_widget(form.schoolName) }}
            {{ form_errors(form.schoolName) }}
        </div>

        <div class="form-row">
            {{ form_label(form.city) }}
            {{ form_widget(form.city) }}
            {{ form_errors(form.city) }}
        </div>

        <div class="form-row">
            {{ form_label(form.learningGoal) }}
            {{ form_widget(form.learningGoal) }}
            {{ form_errors(form.learningGoal) }}
        </div>

        <button type="submit" class="btn btn--cta">Kaydet</button>
    {{ form_end(form) }}
</section>
{% endblock %}
