{% extends 'base.html.twig' %}

{% block title %}Testler — Testlig{% endblock %}
{% block body_class %}is-student-surface{% endblock %}

{% block body %}
<section class="page student-catalog">
    <nav class="student-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_student_dashboard') }}">Panel</a>
        <span aria-hidden="true">/</span>
        <span>Testler</span>
    </nav>
    <h1>Testler</h1>
    <p class="muted">{{ gradeLevel.value }}. sınıf için yayımlanmış testler</p>
    <p><a href="{{ path('app_student_test_history') }}">Test geçmişim</a></p>

    {% if tests is empty %}
        <div class="empty-state" role="status">
            <p>Sınıfın için henüz yayımlanmış test bulunmuyor.</p>
        </div>
    {% else %}
        <ul class="student-catalog-grid">
            {% for test in tests %}
                <li>
                    <a class="student-catalog-card" href="{{ path('app_student_test_show', {code: test.code}) }}">
                        <span class="student-catalog-card__title">{{ test.title }}</span>
                        <span class="student-catalog-card__meta muted">{{ test.subject }}</span>
                        <span class="student-catalog-card__meta">{{ test.question_count }} soru · {{ test.duration_label }}</span>
                        <span class="student-test-state">
                            {% if test.state == 'resume' %}Devam et{% elseif test.state == 'done' %}Tamamlandı{% else %}Başla{% endif %}
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endblock %}
