{% extends 'student/layout.html.twig' %}

{% block title %}Testler — Testlig{% endblock %}

{% block student_content %}
<section class="student-catalog">
    <nav class="student-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_student_dashboard') }}">Panel</a>
        <span aria-hidden="true">/</span>
        <span>Testler</span>
    </nav>
    <h1>Testler</h1>
    <p class="muted">{{ gradeLevel.value }}. sınıf için yayımlanmış testler</p>
    <p><a href="{{ path('app_student_test_history') }}">Test geçmişim</a></p>

    {% if tests is empty %}
        <div class="empty-state" role="status">
            <p>Sınıfın için henüz yayımlanmış test bulunmuyor.</p>
        </div>
    {% else %}
        <ul class="student-catalog-grid">
            {% for test in tests %}
                {% if test.state == 'done' %}
                    {% set testHref = path('app_student_test_result', {code: test.code}) %}
                    {% set testCta = 'Sonucu gör' %}
                {% elseif test.state == 'resume' %}
                    {% set testHref = path('app_student_test_solve', {code: test.code}) %}
                    {% set testCta = 'Devam et' %}
                {% elseif test.state == 'soon' or test.state == 'expired' %}
                    {% set testHref = path('app_student_test_show', {code: test.code}) %}
                    {% set testCta = test.status_label|default('Kapalı') %}
                {% else %}
                    {% set testHref = path('app_student_test_show', {code: test.code}) %}
                    {% set testCta = 'Teste başla' %}
                {% endif %}
                <li>
                    <a class="student-catalog-card" href="{{ testHref }}">
                        <span class="student-catalog-card__title">{{ test.title }}</span>
                        <span class="student-catalog-card__meta muted">{{ test.subject }}{% if test.institution|default(null) %} · {{ test.institution }}{% if test.classroom|default(null) %} · {{ test.classroom }}{% endif %}{% endif %}</span>
                        <span class="student-catalog-card__meta">{{ test.question_count }} soru · {{ test.duration_label }}</span>
                        {% if test.status_label|default(null) %}
                            <span class="student-test-state">{{ test.status_label }}</span>
                        {% endif %}
                        <span class="student-test-state">{{ testCta }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endblock %}
