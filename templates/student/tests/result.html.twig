{% extends 'base.html.twig' %}

{% block title %}Sonuç — Testlig{% endblock %}
{% block body_class %}is-student-surface{% endblock %}

{% block body %}
<section class="page student-catalog">
    <nav class="student-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_student_tests') }}">Testler</a>
        <span aria-hidden="true">/</span>
        <span>Sonuç</span>
    </nav>
    {% if result is null %}
        <h1>Sonuç</h1>
        <p role="status">Sonuç gösterilemiyor.</p>
    {% else %}
        <h1>{{ result.title }}</h1>
        <ul class="student-test-facts">
            <li>Toplam soru: {{ result.questions|length }}</li>
            <li>Doğru: {{ result.correct }}</li>
            <li>Yanlış: {{ result.incorrect }}</li>
            <li>Boş: {{ result.unanswered }}</li>
            <li>Kazanılan puan: {{ result.earned }}</li>
            <li>Toplam puan: {{ result.total }}</li>
            <li>Yüzde: {{ result.percentage }}</li>
        </ul>
        <ol class="student-test-review">
            {% for question in result.questions %}
                <li>
                    <h2>Soru {{ question.position }}</h2>
                    {% for line in question.stem %}
                        <p>{{ line }}</p>
                    {% endfor %}
                    <p>Cevabın: {% if question.student_answer %}{{ question.student_answer }}{% else %}Boş{% endif %}</p>
                    <p>Doğru cevap: {{ question.correct_answer }}</p>
                    <p>{{ question.label }}</p>
                    {% if question.explanation %}
                        <div class="student-test-explanation">
                            {% for line in question.explanation %}
                                <p>{{ line }}</p>
                            {% endfor %}
                        </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</section>
{% endblock %}
