{% extends 'student/layout.html.twig' %}

{% block title %}Sonuç — Testlig{% endblock %}

{% block student_content %}
<section class="student-catalog">
    <nav class="student-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_student_tests') }}">Testler</a>
        <span aria-hidden="true">/</span>
        <span>Sonuç</span>
    </nav>
    {% if result is null %}
        <h1>Sonuç</h1>
        <p role="status">Sonuç gösterilemiyor.</p>
    {% else %}
        <h1>{{ result.title }}</h1>
        <p class="student-score">{{ result.earned }} / {{ result.total }}</p>
        <p class="student-score__note">Yüzde: {{ result.percentage }}</p>
        <ul class="student-metrics">
            <li>
                <span>Doğru</span>
                <strong>{{ result.correct }}</strong>
            </li>
            <li>
                <span>Yanlış</span>
                <strong>{{ result.incorrect }}</strong>
            </li>
            <li>
                <span>Boş</span>
                <strong>{{ result.unanswered }}</strong>
            </li>
        </ul>
        <ol class="student-test-review">
            {% for question in result.questions %}
                <li class="student-review-item">
                    <h2>Soru {{ question.position }}</h2>
                    {% for line in question.stem %}
                        <p>{{ line }}</p>
                    {% endfor %}
                    <p>Cevabın: {% if question.student_answer %}{{ question.student_answer }}{% else %}Boş{% endif %}</p>
                    <p>Doğru cevap: {{ question.correct_answer }}</p>
                    <p>{{ question.label }}</p>
                    {% if question.explanation %}
                        <div class="student-test-explanation">
                            {% for line in question.explanation %}
                                <p>{{ line }}</p>
                            {% endfor %}
                        </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</section>
{% endblock %}
