{% extends 'student/layout.html.twig' %}

{% block title %}Öğrenci Paneli — Testlig{% endblock %}

{% block student_content %}
<section class="student-dashboard">
    <header class="student-dashboard__header portal-hello">
        <span class="portal-initials" aria-hidden="true">{{ user.firstName|slice(0, 1)|upper }}</span>
        <div>
            <p class="portal-role">Öğrenci</p>
            <h1 class="panel-greeting">Merhaba, {{ user.firstName }}</h1>
            <p class="student-grade">{{ profile.gradeLevel.value }}. sınıf</p>
            <p class="muted">Yayımlanan ders ve testlerden devam edebilirsin.</p>
        </div>
    </header>

    <section class="student-section" aria-labelledby="continue-heading">
        <h2 id="continue-heading">Öğrenmeye devam et</h2>
        {% if continue_test %}
            <a class="student-catalog-card" href="{{ path('app_student_test_solve', {code: continue_test.code}) }}">
                <span class="student-catalog-card__title">{{ continue_test.title }}</span>
                <span class="student-catalog-card__meta muted">{{ continue_test.subject }}{% if continue_test.institutionName %} · {{ continue_test.institutionName }}{% if continue_test.classroomName %} · {{ continue_test.classroomName }}{% endif %}{% endif %}</span>
                <span class="student-test-state">{{ continue_test.stateLabel }}</span>
                <span class="student-test-state">Devam et</span>
            </a>
        {% else %}
            <div class="empty-state" role="status">
                <p>Şu anda devam eden bir testin yok.</p>
                <p class="muted">
                    <a href="{{ path('app_student_courses') }}">Dersler</a>
                    ·
                    <a href="{{ path('app_student_tests') }}">Testler</a>
                </p>
            </div>
        {% endif %}
    </section>

    <section class="student-section" aria-labelledby="quick-heading">
        <h2 id="quick-heading">Hızlı erişim</h2>
        <ul class="student-quick-links">
            {% for link in quickLinks %}
                {% if not link.soon and link.href %}
                    <li>
                        <a class="student-quick-card" href="{{ link.href }}">
                            {% set icon = link.label == 'Dersler' ? 'courses' : (link.label == 'Testler' ? 'tests' : (link.label == 'Test geçmişim' ? 'history' : 'default')) %}
                            {% include 'components/portal_icon.html.twig' with { icon: icon } only %}
                            <span class="student-quick-card__label">{{ link.label }}</span>
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
        {% for link in quickLinks %}
            {% if link.soon or link.href is null %}
                <p class="student-soon">{{ link.label }} · <span class="student-badge">Yakında</span></p>
            {% endif %}
        {% endfor %}
    </section>

    <p class="student-dashboard__actions">
        <a href="{{ path('app_student_profile') }}">Profil bilgilerini düzenle</a>
    </p>
    {% if institution_memberships is not empty %}
        <section class="student-section" aria-labelledby="institution-heading">
            <h2 id="institution-heading">Kurum ve sınıf</h2>
            <ul>
                {% for membership in institution_memberships %}
                    <li>{{ membership.institutionName }} · {{ membership.roleLabel }} · {{ membership.statusLabel }}{% if membership.classroomNames is not empty %} · {{ membership.classroomNames|join(', ') }}{% endif %}</li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
</section>
{% endblock %}
