{% extends 'base.html.twig' %}

{% block title %}Dersler — Testlig{% endblock %}
{% block body_class %}is-student-surface{% endblock %}

{% block body %}
<section class="page student-catalog">
    <nav class="student-breadcrumb" aria-label="Konum">
        <a href="{{ path('app_student_dashboard') }}">Panel</a>
        <span aria-hidden="true">/</span>
        <span>Dersler</span>
    </nav>
    <h1>Dersler</h1>
    <p class="muted">{{ gradeLevel.value }}. sınıf için yayımlanmış dersler</p>

    {% if subjects is empty %}
        <div class="empty-state" role="status">
            <p>Sınıfın için henüz yayımlanmış ders bulunmuyor.</p>
        </div>
    {% else %}
        <ul class="student-catalog-grid">
            {% for subject in subjects %}
                <li>
                    <a class="student-catalog-card" href="{{ path('app_student_course_subject', {subjectSlug: subject.slug}) }}">
                        <span class="student-catalog-card__title">{{ subject.name }}</span>
                        {% if subject.description %}
                            <span class="student-catalog-card__meta muted">{{ subject.description|length > 120 ? subject.description|slice(0, 120) ~ '…' : subject.description }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endblock %}
