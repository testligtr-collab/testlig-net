{# Student-safe typed blocks. Autoescape stays on. #}
{% for block in blocks %}
    {% if block.type == 'heading' %}
        {% if block.level == 1 %}
            <h3 class="student-content-heading">{{ block.text }}</h3>
        {% elseif block.level == 2 %}
            <h4 class="student-content-heading">{{ block.text }}</h4>
        {% else %}
            <h5 class="student-content-heading">{{ block.text }}</h5>
        {% endif %}
    {% elseif block.type == 'paragraph' %}
        <p class="student-content-paragraph">{{ block.text }}</p>
    {% elseif block.type == 'quote' %}
        <blockquote class="student-content-quote"><p>{{ block.text }}</p></blockquote>
    {% elseif block.type == 'list' %}
        {% if block.listStyle == 'ordered' %}
            <ol class="student-content-list">
                {% for item in block.items %}
                    <li>{{ item }}</li>
                {% endfor %}
            </ol>
        {% else %}
            <ul class="student-content-list">
                {% for item in block.items %}
                    <li>{{ item }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% elseif block.type == 'math' %}
        <p class="student-content-math"><code>{{ block.latex }}</code></p>
    {% elseif block.type == 'callout' %}
        {% set tone = block.variant in ['info', 'warning', 'tip', 'note'] ? block.variant : 'info' %}
        {% set tone_label = tone == 'warning' ? 'Uyarı' : (tone == 'tip' ? 'İpucu' : (tone == 'note' ? 'Not' : 'Bilgi')) %}
        <aside class="student-content-callout student-content-callout--{{ tone }}" role="note">
            <p class="student-content-callout__label">{{ tone_label }}</p>
            {% include 'student/content/_blocks.html.twig' with {blocks: block.children} only %}
        </aside>
    {% elseif block.type == 'video' %}
        <figure class="student-content-video">
            <div class="student-content-video__frame">
                <iframe src="{{ block.embedSrc }}" title="{{ block.text }}" loading="lazy" allow="fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" sandbox="allow-scripts allow-same-origin allow-presentation">Video yüklenemedi.</iframe>
            </div>
            {% if block.description %}
                <figcaption>{{ block.description }}</figcaption>
            {% endif %}
        </figure>
    {% elseif block.type == 'document' %}
        <article class="student-content-document">
            <p>{{ block.text }}</p>
            <p>{{ block.fileName }} · {{ block.fileSizeLabel }}</p>
            <a href="{{ block.openPath }}" target="_blank" rel="noopener noreferrer">PDF’yi aç</a>
        </article>
    {% endif %}
{% endfor %}
