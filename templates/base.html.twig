<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Testlig{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <a class="skip-link" href="#main-content">İçeriğe geç</a>

        {% block site_chrome %}
            {% include 'components/public_header.html.twig' %}
        {% endblock %}

        <main id="main-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="page flash flash-{{ label }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block site_footer %}
            {% include 'components/public_footer.html.twig' %}
        {% endblock %}
    </body>
</html>
