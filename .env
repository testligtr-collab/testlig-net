# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Development-only placeholder — override in .env.local for your machine.
APP_SECRET=change_me_dev_only_not_for_production
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local XAMPP / host MariaDB example (override in .env.local when using Docker):
DATABASE_URL="mysql://testlig:testlig@127.0.0.1:3306/testlig?serverVersion=10.11.10-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Default sync transport for host-only runs without Redis.
# Docker Compose overrides this to redis://redis:6379/messages via environment.
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> testlig/redis ###
REDIS_URL=redis://127.0.0.1:6379
###< testlig/redis ###

###> testlig/docker ###
HTTP_PORT=8080
MYSQL_DATABASE=testlig
MYSQL_USER=testlig
# Development placeholders only — override in .env.local for real local secrets:
MYSQL_PASSWORD=dev_password_change_me
MYSQL_ROOT_PASSWORD=dev_root_password_change_me
###< testlig/docker ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
